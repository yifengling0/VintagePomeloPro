+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!enabled_) return;
+        auto& st = slots_[slot];
+        auto& srcStick = st.sticks[src][stIdx];
+        srcStick.x = x;
+        srcStick.y = y;
+        const float mag = std::sqrt(x * x + y * y);
