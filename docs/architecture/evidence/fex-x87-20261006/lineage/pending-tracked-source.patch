+void ControllerHub::SetStick(ControllerSourceId source, uint32_t slot, LogicalStick stick, float x, float y)
+{
+    const uint32_t src = static_cast<uint32_t>(source);
+    const uint32_t stIdx = static_cast<uint32_t>(stick);
