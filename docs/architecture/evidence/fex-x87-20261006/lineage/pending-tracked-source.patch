+    CHECK(whgp_stick_y_to_hid(wire.ly) == wire.ly, "wine HID stick Y == WHGP ly");
+    CHECK(whgp_hat_y_to_hid(1) == -1, "wine HID hat up");
+    CHECK(whgp_hat_y_to_hid(-1) == 1, "wine HID hat down");
+    CHECK(whgp_version_matches(2), "accept WHGP v2");
