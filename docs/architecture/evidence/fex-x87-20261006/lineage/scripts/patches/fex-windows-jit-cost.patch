+namespace {
+struct JITDiagnosticClock {
+  static uint64_t Now() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+  }
+};
+struct JITDiagnosticReporter {
+  static void Report(const FEXCore::JITDiagnosticWindow& W) {
+    LogMan::Msg::IFmt(
+      "[FEX-JIT-PERF] schema=1 pid={} tid={} begin_ns={} end_ns={} window_us={} "
+      "entry={}/{}/{} frontend={}/{}/{} backend={}/{}/{} "
+      "compiled={} lookup_hit={} raced={} failed={} single_step={} cache_clear={} cache_rollover={}",
+      getpid(), FHU::Syscalls::gettid(), W.BeginNS, W.EndNS, (W.EndNS - W.BeginNS) / 1000,
+      W.Calls[0], W.TotalNS[0] / 1000, W.MaxNS[0] / 1000,
+      W.Calls[1], W.TotalNS[1] / 1000, W.MaxNS[1] / 1000,
+      W.Calls[2], W.TotalNS[2] / 1000, W.MaxNS[2] / 1000,
+      W.Outcomes[0], W.Outcomes[1], W.Outcomes[2], W.Outcomes[3], W.Outcomes[4], W.CacheClears, W.CacheRollovers);
+  }
+};
+using CompileDiagnosticScope = FEXCore::JITDiagnosticScope<JITDiagnosticClock, JITDiagnosticReporter>;
+} // namespace
