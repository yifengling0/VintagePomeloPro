+// SPDX-License-Identifier: MIT
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace FEXCore {
+enum class JITDiagnosticPhase : size_t { Entry, Frontend, Backend, Count };
+enum class JITDiagnosticOutcome : size_t { Compiled, CacheHit, Raced, Failed, SingleStep, Count };
+
+struct JITDiagnosticWindow {
+  uint64_t BeginNS {}, EndNS {};
+  std::array<uint64_t, static_cast<size_t>(JITDiagnosticPhase::Count)> Calls {}, TotalNS {}, MaxNS {};
+  std::array<uint64_t, static_cast<size_t>(JITDiagnosticOutcome::Count)> Outcomes {};
+  uint64_t CacheClears {}, CacheRollovers {};
+};
+
+// Owned by one emulated thread. No global lock or cross-thread totals.
+struct JITCompileDiagnostics {
+  JITDiagnosticWindow Window {};
+  unsigned ActiveEntries {};
+  bool Begun {};
+
+  void Begin(uint64_t Now) {
+    if (!Begun) { Window.BeginNS = Now; Begun = true; }
+  }
+  void Record(JITDiagnosticPhase Phase, uint64_t Duration) {
+    auto Index = static_cast<size_t>(Phase);
+    ++Window.Calls[Index];
+    Window.TotalNS[Index] += Duration;
+    if (Duration > Window.MaxNS[Index]) Window.MaxNS[Index] = Duration;
+  }
+  bool TakeWindow(uint64_t Now, JITDiagnosticWindow& Out) {
+    // Report at an outer entry return, after its invalidation lock is released.
+    // No periodic timer, signal logging or per-block output.
+    if (!Begun || ActiveEntries || Now < Window.BeginNS || Now - Window.BeginNS < 1'000'000'000) return false;
+    Window.EndNS = Now;
+    Out = Window;
+    Window = {};
+    Window.BeginNS = Now;
+    return true;
+  }
+};
+
+template<class Clock, class Reporter>
+class JITDiagnosticScope {
+public:
+  JITDiagnosticScope(JITCompileDiagnostics* Stats, JITDiagnosticPhase Phase)
+    : Stats {Stats}, Phase {Phase}, BeginNS {Stats ? Clock::Now() : 0} {
+    if (Stats) {
+      Stats->Begin(BeginNS);
+      if (Phase == JITDiagnosticPhase::Entry) ++Stats->ActiveEntries;
+    }
+  }
+  JITDiagnosticScope(const JITDiagnosticScope&) = delete;
+  JITDiagnosticScope& operator=(const JITDiagnosticScope&) = delete;
+  void SetOutcome(JITDiagnosticOutcome Value) { Outcome = Value; }
+  ~JITDiagnosticScope() {
+    if (!Stats) return;
+    const auto Now = Clock::Now();
+    Stats->Record(Phase, Now >= BeginNS ? Now - BeginNS : 0);
+    if (Phase == JITDiagnosticPhase::Entry) {
+      ++Stats->Window.Outcomes[static_cast<size_t>(Outcome)];
+      --Stats->ActiveEntries;
+      JITDiagnosticWindow Window;
+      if (Stats->TakeWindow(Now, Window)) Reporter::Report(Window);
+    }
+  }
+private:
+  JITCompileDiagnostics* Stats;
+  JITDiagnosticPhase Phase;
+  uint64_t BeginNS;
+  JITDiagnosticOutcome Outcome {JITDiagnosticOutcome::Failed};
+};
+} // namespace FEXCore
