+// Configuration loading precedes logging/JIT initialization. Use checked
+// native file operations rather than the partial freestanding CRT stream API.
+class WindowsReadFile {
+public:
+  explicit WindowsReadFile(const char* Path)
+    : Handle {CreateFileA(Path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                         nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr)} {
+    if (Handle != INVALID_HANDLE_VALUE) {
+      FILE_STANDARD_INFO Info {};
+      IsFile = GetFileInformationByHandleEx(Handle, FileStandardInfo, &Info, sizeof(Info)) && !Info.Directory;
+    }
+  }
+  ~WindowsReadFile() { if (Handle != INVALID_HANDLE_VALUE) CloseHandle(Handle); }
+  WindowsReadFile(const WindowsReadFile&) = delete;
+  WindowsReadFile& operator=(const WindowsReadFile&) = delete;
+  bool Valid() const { return IsFile; }
+  bool Size(size_t& Out) {
+    LARGE_INTEGER End {};
+    if (!SetFilePointerEx(Handle, LARGE_INTEGER {}, &End, FILE_END) || End.QuadPart < 0 ||
+        static_cast<uint64_t>(End.QuadPart) > std::numeric_limits<size_t>::max()) return false;
+    if (!SetFilePointerEx(Handle, LARGE_INTEGER {}, nullptr, FILE_BEGIN)) return false;
+    Out = static_cast<size_t>(End.QuadPart);
+    return true;
+  }
+  ssize_t Read(char* Data, size_t Size) {
+    DWORD Read {};
+    const auto Chunk = static_cast<DWORD>(std::min(Size, static_cast<size_t>(std::numeric_limits<DWORD>::max())));
+    if (!ReadFile(Handle, Data, Chunk, &Read, nullptr)) {
+      // The local WinAPI shim returns failure for NT STATUS_END_OF_FILE.
+      return GetLastError() == ERROR_HANDLE_EOF ? 0 : -1;
+    }
+    return Read <= Chunk ? static_cast<ssize_t>(Read) : -1;
+  }
+private:
+  HANDLE Handle;
+  bool IsFile {};
+};
