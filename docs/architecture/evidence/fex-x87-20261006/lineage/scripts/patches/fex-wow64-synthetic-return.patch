+// The WOW64 bridge returns by setting guest RIP/RSP rather than executing a
+// guest RET. Consume its prediction entry only when it is still the same entry
+// and names the actual guest return address. Context replacement, callbacks
+// that move the prediction stack, and unmatched/tail-call entries retain the
+// normal lookup/guard-page fallback. Never branch to a cached host PC here.
+bool CompleteSyntheticReturn(FEXCore::Core::InternalThreadState* Thread, uint64_t EntrySP, uint64_t ReturnRIP) {
+  auto& SP = Thread->CurrentFrame->State.callret_sp;
+  const auto Base = reinterpret_cast<uint64_t>(Thread->CallRetStackBase);
+  constexpr auto Size = FEXCore::Core::InternalThreadState::CALLRET_STACK_SIZE;
+  if (!ReturnRIP || SP != EntrySP || SP < Base || SP - Base > Size - 2 * sizeof(uint64_t) || ((SP - Base) & 15)) {
+    return false;
+  }
+  const auto* Entry = reinterpret_cast<const uint64_t*>(SP);
+  if (Entry[0] != ReturnRIP) {
+    return false;
+  }
+  SP += 2 * sizeof(uint64_t);
+  return true;
+}
