+namespace FEXCore {
+uint64_t FloatDiagnosticNow() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+void FloatDiagnosticReport(const FloatDiagnosticWindow& W) {
+  LogMan::Msg::IFmt("[FEX-FLOAT-PERF] schema=1 pid={} tid={} begin_ns={} end_ns={} pc={}/{}/{}/{} rc={}/{}/{}/{} sample_stride=1021",
+    getpid(), FHU::Syscalls::gettid(), W.BeginNS, W.EndNS,
+    W.Precision[0], W.Precision[1], W.Precision[2], W.Precision[3],
+    W.Rounding[0], W.Rounding[1], W.Rounding[2], W.Rounding[3]);
+  static constexpr const char* Names[] = {"load32", "load64", "store32", "store64", "add", "sub", "mul", "div", "other"};
+  for (size_t i = 0; i < FloatDiagnosticOpCount; ++i) {
+    if (!W.Calls[i]) continue;
+    LogMan::Msg::IFmt("[FEX-FLOAT-OP] schema=1 pid={} tid={} end_ns={} op={} calls={} samples={} sampled_ns={} max_sample_ns={}",
+      getpid(), FHU::Syscalls::gettid(), W.EndNS, Names[i], W.Calls[i], W.Samples[i], W.SampleNS[i], W.MaxNS[i]);
+  }
+}
+} // namespace FEXCore
