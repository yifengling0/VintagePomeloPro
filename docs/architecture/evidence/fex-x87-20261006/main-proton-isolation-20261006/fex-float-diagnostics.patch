+// SPDX-License-Identifier: MIT
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace FEXCore {
+enum class FloatDiagnosticOp : size_t { Load32, Load64, Store32, Store64, Add, Sub, Mul, Div, Other, Count };
+inline constexpr size_t FloatDiagnosticOpCount = static_cast<size_t>(FloatDiagnosticOp::Count);
+struct FloatDiagnosticWindow {
+  uint64_t BeginNS {}, EndNS {};
+  std::array<uint64_t, FloatDiagnosticOpCount> Calls {}, Samples {}, SampleNS {}, MaxNS {};
+  std::array<uint64_t, 4> Precision {}, Rounding {};
+};
+struct FloatDiagnostics {
+  FloatDiagnosticWindow Window {};
+  std::array<unsigned, FloatDiagnosticOpCount> UntilSample {};
+  bool Begun {};
+};
+uint64_t FloatDiagnosticNow();
+void FloatDiagnosticReport(const FloatDiagnosticWindow&);
+
+// One owner per emulated thread. Sample each operation independently, so a
+// frequent conversion cannot starve arithmetic samples. Timing excludes ABI
+// spill/fill and the report itself; it is NOT an estimate of total CPU time.
+class FloatDiagnosticScope {
+public:
+  FloatDiagnosticScope(FloatDiagnostics* Stats, FloatDiagnosticOp Op, uint16_t FCW)
+    : Stats {Stats}, Index {static_cast<size_t>(Op)} {
+    if (!Stats) return;
+    ++Stats->Window.Calls[Index];
+    ++Stats->Window.Precision[(FCW >> 8) & 3];
+    ++Stats->Window.Rounding[(FCW >> 10) & 3];
+    if (Stats->UntilSample[Index]) { --Stats->UntilSample[Index]; return; }
+    Stats->UntilSample[Index] = 1020;
+    Sampled = true;
+    BeginNS = FloatDiagnosticNow();
+    if (!Stats->Begun) {
+      Stats->Window.BeginNS = BeginNS;
+      Stats->Begun = true;
+    }
+  }
+  FloatDiagnosticScope(const FloatDiagnosticScope&) = delete;
+  FloatDiagnosticScope& operator=(const FloatDiagnosticScope&) = delete;
+  ~FloatDiagnosticScope() {
+    if (!Sampled) return;
+    const auto Now = FloatDiagnosticNow();
+    auto& W = Stats->Window;
+    const auto Duration = Now >= BeginNS ? Now - BeginNS : 0;
+    ++W.Samples[Index];
+    W.SampleNS[Index] += Duration;
+    if (Duration > W.MaxNS[Index]) W.MaxNS[Index] = Duration;
+    if (Now >= W.BeginNS && Now - W.BeginNS >= 1'000'000'000) {
+      W.EndNS = Now;
+      const auto Completed = W;
+      W = {};
+      W.BeginNS = Now;
+      FloatDiagnosticReport(Completed);
+    }
+  }
+private:
+  FloatDiagnostics* Stats;
+  size_t Index;
+  uint64_t BeginNS {};
+  bool Sampled {};
+};
+} // namespace FEXCore
