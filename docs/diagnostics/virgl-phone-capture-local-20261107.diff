+/* Local diagnostic: only TRACE_CAPTURE sessions use this bounded recorder.
+ * No pointers or referenced resources are retained, only formatted values. */
+#define VKR_FLIGHT_COUNT 8192u
+#define VKR_FLIGHT_BYTES 512u
+static once_flag vkr_flight_once = ONCE_FLAG_INIT;
+static mtx_t vkr_flight_mutex;
+static bool vkr_flight_active;
+static bool vkr_flight_dumped;
+static uint64_t vkr_flight_sequence;
+static char vkr_flight_records[VKR_FLIGHT_COUNT][VKR_FLIGHT_BYTES];
+
+static void vkr_flight_init(void)
+{
+   mtx_init(&vkr_flight_mutex, mtx_plain);
+   const char *value = os_get_option("WINEHUA_VKR_TRACE_CAPTURE");
+   vkr_flight_active = value && value[0] == '1';
+}
+
+bool vkr_flight_enabled(void)
+{
+   call_once(&vkr_flight_once, vkr_flight_init);
+   return vkr_flight_active;
+}
+
+static void vkr_flight_emit(const char *fmt, ...)
+{
+   va_list va;
+   va_start(va, fmt);
+   virgl_prefixed_logv("vkr", VIRGL_LOG_LEVEL_INFO, fmt, va);
+   va_end(va);
+}
+
+void vkr_flight_dump(void)
+{
+   if (!vkr_flight_enabled()) return;
+   mtx_lock(&vkr_flight_mutex);
+   if (!vkr_flight_dumped) {
+      vkr_flight_dumped = true;
+      const uint64_t first = vkr_flight_sequence > VKR_FLIGHT_COUNT
+         ? vkr_flight_sequence - VKR_FLIGHT_COUNT : 0;
+      vkr_flight_emit("WineHuaFlight: begin first=%" PRIu64 " end=%" PRIu64,
+                     first, vkr_flight_sequence);
+      for (uint64_t i = first; i < vkr_flight_sequence; i++)
+         vkr_flight_emit("Flight[ %" PRIu64 " ] %s", i,
+                        vkr_flight_records[i % VKR_FLIGHT_COUNT]);
+      vkr_flight_emit("WineHuaFlight: end");
+   }
+   mtx_unlock(&vkr_flight_mutex);
+}
+
 void
 vkr_log(const char *fmt, ...)
 {
    va_list va;
 
    va_start(va, fmt);
+   if (vkr_flight_enabled()) {
+      char line[VKR_FLIGHT_BYTES];
+      vsnprintf(line, sizeof(line), fmt, va);
+      va_end(va);
+      mtx_lock(&vkr_flight_mutex);
+      if (!vkr_flight_dumped) {
+         memcpy(vkr_flight_records[vkr_flight_sequence % VKR_FLIGHT_COUNT],
+                line, strlen(line) + 1);
+         vkr_flight_sequence++;
+      }
+      mtx_unlock(&vkr_flight_mutex);
+      if (strstr(line, "CS error") || strstr(line, "result=-4") ||
+          strstr(line, "GPU upload wait failed"))
+         vkr_flight_dump();
+      return;
+   }
    virgl_prefixed_logv("vkr", VIRGL_LOG_LEVEL_INFO, fmt, va);
    va_end(va);
 }
