+static void
+vkr_flight_checkpoint_cleanup(struct vkr_device *dev)
+{
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   VkDevice d = dev->base.handle.device;
+   if (dev->flight_map) vk->UnmapMemory(d, dev->flight_memory);
+   if (dev->flight_buffer) vk->DestroyBuffer(d, dev->flight_buffer, NULL);
+   if (dev->flight_memory) vk->FreeMemory(d, dev->flight_memory, NULL);
+   dev->flight_map = NULL;
+   dev->flight_buffer = VK_NULL_HANDLE;
+   dev->flight_memory = VK_NULL_HANDLE;
+}
+
+static void
+vkr_flight_checkpoint_init(struct vkr_device *dev)
+{
+   if (!vkr_flight_enabled()) return;
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   VkDevice d = dev->base.handle.device;
+   VkBufferCreateInfo bi = {.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = 4096, .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE};
+   if (vk->CreateBuffer(d, &bi, NULL, &dev->flight_buffer) != VK_SUCCESS) return;
+   VkMemoryRequirements req;
+   vk->GetBufferMemoryRequirements(d, dev->flight_buffer, &req);
+   VkPhysicalDeviceMemoryProperties props;
+   dev->physical_device->proc_table.GetPhysicalDeviceMemoryProperties(
+      dev->physical_device->base.handle.physical_device, &props);
+   uint32_t mt;
+   for (mt = 0; mt < props.memoryTypeCount; mt++)
+      if ((req.memoryTypeBits & (1u << mt)) &&
+          (props.memoryTypes[mt].propertyFlags &
+             (VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)) ==
+             (VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)) break;
+   if (mt == props.memoryTypeCount) goto fail;
+   VkMemoryAllocateInfo ai = {.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = req.size, .memoryTypeIndex = mt};
+   if (vk->AllocateMemory(d, &ai, NULL, &dev->flight_memory) != VK_SUCCESS) goto fail;
+   if (vk->BindBufferMemory(d, dev->flight_buffer, dev->flight_memory, 0) != VK_SUCCESS) goto fail;
+   if (vk->MapMemory(d, dev->flight_memory, 0, VK_WHOLE_SIZE, 0,
+                    (void **)&dev->flight_map) != VK_SUCCESS) goto fail;
+   memset(dev->flight_map, 0, 4096);
+   atomic_init(&dev->flight_sequence, 0);
+   vkr_log("WineHuaCheckpoint: initialized coherent marker type=%u", mt);
+   return;
+fail:
+   vkr_flight_checkpoint_cleanup(dev);
+   vkr_log("WineHuaCheckpoint: unavailable");
+}
+
+void
+vkr_flight_checkpoint(struct vkr_device *dev, VkCommandBuffer cmd,
+                      uint64_t cmd_id, const char *phase)
+{
+   if (!dev->flight_map) return;
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   const uint32_t seq = atomic_fetch_add(&dev->flight_sequence, 1) + 1;
+   VkMemoryBarrier barrier = {.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+      .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+      .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT};
+   vk->CmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &barrier, 0, NULL, 0, NULL);
+   vk->CmdFillBuffer(cmd, dev->flight_buffer, 0, 4, seq);
+   vk->CmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_ALL_COMMANDS_BIT | VK_PIPELINE_STAGE_HOST_BIT,
+      0, 1, &barrier, 0, NULL, 0, NULL);
+   vkr_log("WineHuaCheckpoint: recorded marker=%u cmdId=%" PRIu64 " phase=%s",
+           seq, cmd_id, phase);
+}
+
