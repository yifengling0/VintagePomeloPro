#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=8,local_size_y=8) in;
layout(buffer_reference,std430,buffer_reference_align=4) readonly buffer Words {uint w[];};
layout(buffer_reference,std430,buffer_reference_align=4) writeonly buffer OutWords {uint w[];};
layout(push_constant) uniform Parameters {
    uvec2 src;uvec2 dst;
    uint src_row_pitch;uint src_slice_pitch;uint dst_row_pitch;uint dst_slice_pitch;
    uint blocks_x;uint blocks_y;uint format;uint flags;
} pc;
#include "decode.glsl"
const int etc_mod[32]=int[32](2,8,-2,-8,5,17,-5,-17,9,29,-9,-29,13,42,-13,-42,
    18,60,-18,-60,24,80,-24,-80,33,106,-33,-106,47,183,-47,-183);
const int alpha_mod[128]=int[128](
    -3,-6,-9,-15,2,5,8,14, -3,-7,-10,-13,2,6,9,12,
    -2,-5,-8,-13,1,4,7,12, -2,-4,-6,-13,1,3,5,12,
    -3,-6,-8,-12,2,5,7,11, -3,-7,-9,-11,2,6,8,10,
    -4,-7,-8,-11,3,6,7,10, -3,-5,-8,-11,2,4,7,10,
    -2,-6,-8,-10,1,5,7,9, -2,-5,-8,-10,1,4,7,9,
    -2,-4,-8,-10,1,3,7,9, -2,-5,-7,-10,1,4,6,9,
    -3,-4,-7,-10,2,3,6,9, -1,-2,-3,-10,0,1,2,9,
    -4,-6,-8,-9,3,5,7,8, -3,-5,-7,-9,2,4,6,8);
uint swap32(uint v){return ((v&255u)<<24)|((v&65280u)<<8)|((v>>8)&65280u)|(v>>24);}
uvec2 encode_rgb() {
    uint high=0,low=0;
    for(uint part=0;part<2;part++) {
        ivec3 sum=ivec3(0);
        for(uint y=0;y<4;y++)for(uint x=part*2;x<part*2+2;x++) {
            uint p=texels[y*4+x];sum+=ivec3(p&255u,(p>>8)&255u,(p>>16)&255u);
        }
        ivec3 base=clamp((sum+ivec3(68))/136,ivec3(0),ivec3(15));
        uint best=0xffffffffu,best_table=0,best_bits=0;
        for(uint table=0;table<8;table++) {
            uint error=0,bits=0;
            for(uint y=0;y<4;y++)for(uint x=part*2;x<part*2+2;x++) {
                uint p=texels[y*4+x];ivec3 rgb=ivec3(p&255u,(p>>8)&255u,(p>>16)&255u);
                uint pe=0xffffffffu,index=0;
                for(uint s=0;s<4;s++) {
                    ivec3 d=rgb-clamp(base*17+ivec3(etc_mod[table*4+s]),ivec3(0),ivec3(255));
                    uint e=uint(d.x*d.x+d.y*d.y+d.z*d.z);if(e<pe){pe=e;index=s;}
                }
                error+=pe;uint bit=x*4+y;bits|=(index&1u)<<bit;bits|=(index>>1)<<(bit+16);
            }
            if(error<best){best=error;best_table=table;best_bits=bits;}
        }
        high|=uint(base.x)<<(part==0?28:24);high|=uint(base.y)<<(part==0?20:16);
        high|=uint(base.z)<<(part==0?12:8);high|=best_table<<(part==0?5:2);low|=best_bits;
    }
    return uvec2(swap32(high),swap32(low));
}
// BC1 alpha is exactly 0 or 1. ETC2 punchthrough preserves it in one 8-byte
// block instead of wasting a separate 8-byte EAC alpha block. Punchthrough
// always uses the differential colour layout; bit 1 denotes opaque alpha.
uvec2 encode_rgb_a1() {
    bool opaque=true;
    for(uint i=0;i<16;i++)if((texels[i]>>24)==0u)opaque=false;
    ivec3 bases[2];
    for(uint part=0;part<2;part++) {
        ivec3 sum=ivec3(0);int count=0;
        for(uint y=0;y<4;y++)for(uint x=part*2;x<part*2+2;x++) {
            uint p=texels[y*4+x];if((p>>24)==0u)continue;
            sum+=ivec3(p&255u,(p>>8)&255u,(p>>16)&255u);count++;
        }
        bases[part]=count>0?clamp((sum*31+ivec3(count*127))/(count*255),ivec3(0),ivec3(31)):ivec3(0);
    }
    ivec3 delta=clamp(bases[1]-bases[0],ivec3(-4),ivec3(3));bases[1]=bases[0]+delta;
    uint high=(uint(bases[0].r)<<27)|((uint(delta.r)&7u)<<24)|
        (uint(bases[0].g)<<19)|((uint(delta.g)&7u)<<16)|
        (uint(bases[0].b)<<11)|((uint(delta.b)&7u)<<8)|(opaque?2u:0u),low=0;
    for(uint part=0;part<2;part++) {
        ivec3 base=(bases[part]<<3)|(bases[part]>>2);
        uint best=0xffffffffu,best_table=0,best_bits=0;
        for(uint table=0;table<8;table++) {
            uint error=0,bits=0;
            for(uint y=0;y<4;y++)for(uint x=part*2;x<part*2+2;x++) {
                uint p=texels[y*4+x];ivec3 rgb=ivec3(p&255u,(p>>8)&255u,(p>>16)&255u);
                uint pe=0xffffffffu,index=0;
                if((p>>24)==0u){index=2u;pe=0;}
                else for(uint s=0;s<4;s++) {
                    if(!opaque&&s==2u)continue;
                    int modifier=(!opaque&&s==0u)?0:etc_mod[table*4+s];
                    ivec3 d=rgb-clamp(base+ivec3(modifier),ivec3(0),ivec3(255));
                    uint e=uint(d.x*d.x+d.y*d.y+d.z*d.z);if(e<pe){pe=e;index=s;}
                }
                error+=pe;uint bit=x*4+y;bits|=(index&1u)<<bit;bits|=(index>>1)<<(bit+16);
            }
            if(error<best){best=error;best_table=table;best_bits=bits;}
        }
        high|=best_table<<(part==0?5:2);low|=best_bits;
    }
    return uvec2(swap32(high),swap32(low));
}
uvec2 encode_alpha() {
    int lo=255,hi=0;
    for(uint i=0;i<16;i++){int a=int(texels[i]>>24);lo=min(lo,a);hi=max(hi,a);}
    if(lo==hi)return uvec2(uint(lo),0); // network byte order: base, multiplier/table, selectors
    uint best=0xffffffffu,best_high=0,best_low=0;
    for(uint table=0;table<16;table++) {
        int low_mod=alpha_mod[table*8+3],high_mod=alpha_mod[table*8+7];
        int middle=max(1,(hi-lo)/(high_mod-low_mod));
        for(int step=-1;step<=1;step++) {
            int mul=clamp(middle+step,1,15);
            int base=clamp((lo+hi-mul*(low_mod+high_mod)+1)/2,0,255);
            uint error=0,bits_high=0,bits_low=0;
            for(uint x=0;x<4;x++)for(uint y=0;y<4;y++) {
                int a=int(texels[y*4+x]>>24);uint pe=0xffffffffu,sel=0;
                for(uint s=0;s<8;s++) {
                    int d=a-clamp(base+mul*alpha_mod[table*8+s],0,255);
                    uint e=uint(d*d);if(e<pe){pe=e;sel=s;}
                }
                error+=pe;int shift=45-int(3*(x*4+y));
                if(shift>=32)bits_high|=sel<<uint(shift-32);
                else {bits_low|=sel<<uint(shift);if(shift>29)bits_high|=sel>>uint(32-shift);}
            }
            if(error<best) {
                best=error;best_high=uint(base)<<24|uint(mul)<<20|table<<16|bits_high;best_low=bits_low;
            }
        }
    }
    return uvec2(swap32(best_high),swap32(best_low));
}
void main() {
    uvec3 id=gl_GlobalInvocationID;
    if(id.x>=pc.blocks_x||id.y>=pc.blocks_y)return;
    uint fmt=pc.format,bb=(fmt<=1u||fmt==4u||fmt==5u)?8u:16u;
    uint offset=(id.z*pc.src_slice_pitch+id.y*pc.src_row_pitch+id.x*bb)>>2;
    Words s=Words(pc.src);blk=uvec4(s.w[offset],s.w[offset+1],bb==16?s.w[offset+2]:0,bb==16?s.w[offset+3]:0);
    if(fmt<=1) {
        decode_color(blk.x,blk.y,false,false);
        if(fmt==1)for(uint i=0;i<16;i++)texels[i]|=0xff000000u;
    } else if(fmt==2)decode_color(blk.z,blk.w,true,true);
    else if(fmt==3){decode_color(blk.z,blk.w,true,false);decode_alpha_bc3(blk.x,blk.y);}
    else if(fmt==4||fmt==5) {
        int v[16];decode_channel(blk.x,blk.y,fmt==5,v);
        for(uint i=0;i<16;i++)texels[i]=uint(v[i])&255u;
    } else if(fmt==6||fmt==7) {
        int r[16],g[16];decode_channel(blk.x,blk.y,fmt==7,r);decode_channel(blk.z,blk.w,fmt==7,g);
        for(uint i=0;i<16;i++)texels[i]=(uint(r[i])&255u)|((uint(g[i])&255u)<<8);
    } else if(fmt==8||fmt==9)decode_bc6h(fmt==9);
    else decode_bc7();
    OutWords d=OutWords(pc.dst);
    if((pc.flags&1u)==0u&&(fmt<=3u||fmt==10u)) {
        uint bytes=fmt<=1?8u:16u;
        uint out_base=(id.z*pc.dst_slice_pitch+id.y*pc.dst_row_pitch+id.x*bytes)>>2;
        uvec2 color=fmt==0?encode_rgb_a1():encode_rgb();
        if(fmt<=1){d.w[out_base]=color.x;d.w[out_base+1]=color.y;}
        else {uvec2 alpha=encode_alpha();d.w[out_base]=alpha.x;d.w[out_base+1]=alpha.y;d.w[out_base+2]=color.x;d.w[out_base+3]=color.y;}
    } else {
        uint size=fmt==4||fmt==5?1u:(fmt==6||fmt==7?2u:(fmt==8||fmt==9?8u:4u));
        uint base=id.z*pc.dst_slice_pitch+id.y*4*pc.dst_row_pitch+id.x*4*size;
        for(uint y=0;y<4;y++) {
            uint o=(base+y*pc.dst_row_pitch)>>2;
            if(size==1)d.w[o]=texels[y*4]|(texels[y*4+1]<<8)|(texels[y*4+2]<<16)|(texels[y*4+3]<<24);
            else if(size==2){d.w[o]=texels[y*4]|texels[y*4+1]<<16;d.w[o+1]=texels[y*4+2]|texels[y*4+3]<<16;}
            else for(uint x=0;x<4;x++) {
                d.w[o+(size/4)*x]=texels[y*4+x];if(size==8)d.w[o+2*x+1]=texels_hi[y*4+x];
            }
        }
    }
}
