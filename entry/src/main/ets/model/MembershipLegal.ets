export const MEMBERSHIP_CANCEL_PATH: string = '系统设置 → 账号与同步 → 管理订阅／取消自动续费 → 华为订阅详情 → 取消订阅 → 确认';
export function membershipLegalTitle(document: string): string {
  return document === 'renewal' ? '自动续费服务协议' : document === 'cancel' ? '取消自动续费说明' :
    document === 'support' ? '客服与帮助' : '会员服务协议';
}
export function membershipLegalText(document: string, operator: string): string {
  const common = '版本：2026-10-16\n运营主体：' + (operator || '以应用商店上架登记主体为准（购买服务尚未开放）') +
    '\n客服邮箱：liufengpm@live.cn\nQQ 群：966307250\n\n';
  if (document === 'support') return common + '无需登录即可复制联系方式。请提供应用版本、问题描述及必要的订单号，以便查询。请勿发送密码、验证码、完整支付凭证或身份证等敏感信息。\n\n' +
    '购买后状态未更新时，请先使用“恢复购买”或“刷新状态”，避免重复付款。退订不需要联系客服，可在应用内直接操作：\n' + MEMBERSHIP_CANCEL_PATH;
  if (document === 'cancel') return common + '您可以随时在应用内管理订阅，无需跳转到第三方应用、拨打电话或提供身份证。\n\n完整操作路径：\n' + MEMBERSHIP_CANCEL_PATH +
    '\n\n仅打开或关闭华为管理弹窗不会取消订阅。请在华为订阅详情完成取消并确认。返回后应用会重新查询官方状态；显示“状态待确认”时，请重试查询或重新打开管理页核实。\n\n' +
    '关闭自动续费后，本期已付费权益保留到已确认的到期日，到期后不再自动扣款。取消自动续费与申请退款是不同操作，取消不会自动退还本期费用。退款请依据华为订单页面提供的入口及适用规则办理，或联系本页客服协助；依法享有的权利不受影响。\n\n单月会员到期不自动扣款，无需取消。恢复购买仅核验已有订单；恢复续订需在华为订阅管理中另行确认。';
  const scope = '一、服务范围\n旧柚 VIP 提供已交付的应用配置和输入方案备份、恢复服务。游戏图片留在游戏目录，游戏存档不上传。请保留必要的本地备份。权益以购买页当次说明和实际已开放功能为准，不将开发中的功能作为已交付权益。\n\n';
  const pricing = '二、商品与收费\n连续包月标准价人民币5元/月，按月自动续费。符合华为优惠条件时，购买页展示首期实际付款金额、优惠期数及优惠结束后的标准价。单月会员人民币5元，开通一个日历月，到期不自动扣款。日历月按开通日期（UTC 时间）顺延至下月同日，同日不存在时取该月最后一天；已有订单保留其原有期限规则。实际金额、币种和优惠资格以华为商品查询及支付确认结果为准。价格获取失败时不可购买。有效会员期间不提供新购，以避免重复收费。\n\n';
  const renewal = '三、自动续费授权与提醒\n只有主动选择连续包月、分别勾选会员协议和自动续费授权，并在华为收银台确认后才会开通。未勾选不视为同意。每期到期前华为按官方续费计划扣款，可能提前24小时发起，并可能按平台规则重试失败扣款。\n\n我们根据官方下次续费时间、金额和币种，在预计续费时间提前7天安排华为推送，正常情况下至少提前5日告知；通知说明服务名称、金额、预计扣款时间和延长期限，点击进入会员管理。新开通连续包月前需开启通知并完成设备登记。推送可能受系统设置、网络和设备状态影响；关闭通知后请在会员页恢复提醒，或直接取消自动续费。提醒通道不可用时可以选择单月会员。\n\n';
  const ending = '四、取消、恢复与退款\n完整取消路径：\n' + MEMBERSHIP_CANCEL_PATH +
    '\n关闭后本期权益保留至已确认的到期日。取消不等于退款；退款依华为订单及适用法律规则办理，依法享有的权利不受影响。恢复购买无需重新同意购买协议，也不会产生新付款。\n\n' +
    '五、服务使用与联系\n请使用同一华为账号查询和恢复订单。账号变更会清除本次购买确认并撤销旧账号的设备提醒绑定。配置同步异常可通过客服反馈；我们将核实并协助处理服务及订单问题。重要服务或收费变更会在应用内显著告知，涉及新授权时重新征得同意。争议可先通过本页客服协商，并可依法向有管辖权的人民法院解决。本协议不排除消费者依法享有的权利。';
  return common + (document === 'renewal' ? pricing + renewal + ending : scope + pricing + renewal + ending);
}
