+++ b/FEXCore/Source/Common/StrictMul24.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: MIT
+// Strict, guarded x87 PC=24 / round-nearest-even multiplication. This keeps
+// the extended exponent range; it does not convert either operand to float.
+#pragma once
+#include <stdint.h>
+#include <SoftFloat-3e/platform.h>
+#include <SoftFloat-3e/softfloat.h>
+
+static inline int FEXTryStrictMul24(struct softfloat_state* state,
+  uint64_t aSig,uint16_t aExp,uint64_t bSig,uint16_t bExp,
+  uint64_t* resultSig,uint16_t* resultExp) {
+  if (state->roundingPrecision!=32 || state->roundingMode!=softfloat_round_near_even) return 0;
+  const unsigned ae=aExp&0x7fffU,be=bExp&0x7fffU;
+  if (!ae || ae==0x7fff || !be || be==0x7fff) return 0;
+  if (!(aSig>>63) || !(bSig>>63) || ((aSig|bSig)&UINT64_C(0xffffffffff))) return 0;
+  // Both operands have exactly 24 significant bits. Their full product has
+  // at most 48 bits and fits in uint64_t without dropping a guard/sticky bit.
+  const uint64_t product=(aSig>>40)*(bSig>>40);
+  const unsigned high=(unsigned)(product>>47),shift=23+high;
+  int exponent=(int)ae+(int)be-0x3fff+(int)high;
+  // Exclude tininess before rounding as well as after it; this also preserves
+  // semantics if a caller selects before-rounding tininess detection.
+  if (exponent<=0 || exponent>=0x7fff) return 0;
+  const uint64_t remainder=product&((UINT64_C(1)<<shift)-1);
+  const uint64_t half=UINT64_C(1)<<(shift-1);
+  uint64_t rounded=product>>shift;
+  rounded+=(remainder>half || (remainder==half && (rounded&1)));
+  if (rounded==(UINT64_C(1)<<24)) { rounded>>=1; ++exponent; }
+  // No state or output is changed until every guard, including the rounded
+  // result's exponent, has passed. Special and boundary cases use SoftFloat.
+  if (exponent<=0 || exponent>=0x7fff) return 0;
+  *resultSig=rounded<<40;
+  *resultExp=(uint16_t)(exponent|((aExp^bExp)&0x8000));
+  if (remainder) state->exceptionFlags|=softfloat_flag_inexact;
+  return 1;
+}
