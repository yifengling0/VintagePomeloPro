+
+size_t wlr_xwayland_snapshot_children(struct wlr_xwayland *xwayland,
+        struct wlr_xwayland_child_info *items, size_t capacity) {
+    if (!xwayland || !xwayland->xwm || !items) return 0;
+    size_t count = 0;
+    struct xwm_child_window *child;
+    wl_list_for_each(child, &xwayland->xwm->child_windows, link) {
+        if (!child->product_toplevel || !child->pid) continue;
+        if (count == capacity) break;
+        items[count++] = (struct wlr_xwayland_child_info){
+            .window_id = child->window_id, .pid = child->pid,
+            .generation = child->generation,
+            .x = child->parent->x + child->x, .y = child->parent->y + child->y,
+            .width = child->width, .height = child->height, .mapped = child->mapped,
+        };
+    }
+    return count;
+}
