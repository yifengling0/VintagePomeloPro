+static void xwm_child_read_identity(struct wlr_xwm *xwm, struct xwm_child_window *child) {
+    xcb_get_property_cookie_t pc = xcb_get_property(xwm->xcb_conn, 0,
+        child->window_id, xwm->atoms[NET_WM_PID], XCB_ATOM_CARDINAL, 0, 1);
+    xcb_get_property_cookie_t rc = xcb_get_property(xwm->xcb_conn, 0,
+        child->window_id, xwm->atoms[WM_WINDOW_ROLE], XCB_ATOM_STRING, 0, 32);
+    xcb_get_property_reply_t *p = xcb_get_property_reply(xwm->xcb_conn, pc, NULL);
+    xcb_get_property_reply_t *r = xcb_get_property_reply(xwm->xcb_conn, rc, NULL);
+    child->pid = p && p->format == 32 && xcb_get_property_value_length(p) == 4
+        ? *(uint32_t *)xcb_get_property_value(p) : 0;
+    const char role[] = "winehua-toplevel";
+    child->product_toplevel = r && r->format == 8 &&
+        xcb_get_property_value_length(r) == sizeof(role)-1 &&
+        memcmp(xcb_get_property_value(r), role, sizeof(role)-1) == 0;
+    free(p); free(r);
+}
