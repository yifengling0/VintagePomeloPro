+// SPDX-License-Identifier: MIT
+// Compile-time-only D0 tracing. No logger, allocation or clock API in Record.
+#pragma once
+#include <cstdlib>
+#include <cstring>
+#include <new>
+#include <windows.h>
+#include <wine/debug.h>
+
+struct X87ProfileRecord {
+  uint64_t T[4], Handler, Caller, A[2], B[2];
+  uint16_t FCW;
+};
+
+struct X87ProfileStorage {
+  static constexpr uint32_t Capacity = 2048;
+  uint64_t Frequency {}, Start {}, End {}, LastReport {}, ClockCalibration {};
+  uint32_t Count {}, Reported {}, Dropped {}, Random {}, Span {}, ThreadID {};
+  FEXCore::Core::X87ProfileScratch Scratch;
+  X87ProfileRecord Records[Capacity];
+};
+
+static uint64_t X87ReadCounter() {
+  uint64_t Value;
+  asm volatile("isb; mrs %0, cntvct_el0" : "=r"(Value) :: "memory");
+  return Value;
+}
+
+static void X87ProfileRecordSample(FEXCore::Core::CpuStateFrame* Frame) noexcept {
+  auto& S = *Frame->X87Profile;
+  auto* D = reinterpret_cast<X87ProfileStorage*>(S.Storage);
+  if (!D) return;
+  uint32_t Random = D->Random;
+  Random ^= Random << 13;
+  Random ^= Random >> 17;
+  Random ^= Random << 5;
+  D->Random = Random;
+  S.Countdown = 1 + (Random & (D->Span - 1));
+  if (S.T0 < D->Start) return;
+  if (S.T3 >= D->End || D->Count == X87ProfileStorage::Capacity) {
+    S.Countdown = 0;
+    return;
+  }
+  if (!(S.T0 <= S.T1 && S.T1 <= S.T2 && S.T2 <= S.T3)) {
+    ++D->Dropped;
+    return;
+  }
+  auto& R = D->Records[D->Count++];
+  R.T[0]=S.T0; R.T[1]=S.T1; R.T[2]=S.T2; R.T[3]=S.T3;
+  R.Handler=S.Handler; R.Caller=S.Caller;
+  R.A[0]=S.Source1[0]; R.A[1]=S.Source1[1];
+  R.B[0]=S.Source2[0]; R.B[1]=S.Source2[1];
+  R.FCW=Frame->State.FCW;
+}
+
+static uint32_t X87ProfileOption(const char* Name, uint32_t Fallback, uint32_t Min, uint32_t Max) {
+  const char* Value=std::getenv(Name);
+  if (!Value || !*Value) return Fallback;
+  char* End;
+  unsigned long Result = std::strtoul(Value, &End, 10);
+  return *End || Result<Min || Result>Max ? Fallback : Result;
+}
+
+static void X87ProfileInit(FEXCore::Core::CpuStateFrame* Frame) {
+  const char* Enabled=std::getenv("FEX_X87PROFILE");
+  if (!Enabled || std::strcmp(Enabled,"1")) return;
+  auto* D = new (std::nothrow) X87ProfileStorage {};
+  if (!D) return;
+  asm volatile("mrs %0, cntfrq_el0" : "=r"(D->Frequency));
+  if (!D->Frequency) { delete D; return; }
+  const auto Now = X87ReadCounter();
+  D->Start = Now + D->Frequency * X87ProfileOption("FEX_X87PROFILE_DELAY",15,0,300);
+  D->End = D->Start + D->Frequency * X87ProfileOption("FEX_X87PROFILE_SECONDS",45,1,120);
+  D->ThreadID=GetCurrentThreadId();
+  D->Random=0x9e3779b9U ^ D->ThreadID;
+  D->Span=X87ProfileOption("FEX_X87PROFILE_SPAN",8192,1024,1048576);
+  if (D->Span & (D->Span-1)) D->Span=8192;
+  // Minimum adjacent-read cost; raw timestamps are always retained separately.
+  D->ClockCalibration=~uint64_t {};
+  for (unsigned I=0;I<128;++I) {
+    const auto A=X87ReadCounter(); const auto B=X87ReadCounter();
+    if (B>=A && B-A<D->ClockCalibration) D->ClockCalibration=B-A;
+  }
+  Frame->X87Profile=&D->Scratch;
+  Frame->X87Profile->Storage=reinterpret_cast<uint64_t>(D);
+  Frame->X87Profile->Recorder=reinterpret_cast<uint64_t>(&X87ProfileRecordSample);
+  Frame->X87Profile->Countdown=1+(D->Random & (D->Span-1));
+  const auto Text=fextl::fmt::format(
+    "[FEX-X87-INIT] tid={} frequency={} expected_interval={} capacity={} calibration_ticks={} begin={} end={}\n",
+    D->ThreadID,D->Frequency,(D->Span+1)/2.0,D->Capacity,D->ClockCalibration,D->Start,D->End);
+  __wine_dbg_output(Text.c_str());
+  static std::atomic<bool> Dumped {};
+  if (!Dumped.exchange(true)) {
+    const char* Names[]={"add","sub","mul","div"};
+    const unsigned Indices[]={FEXCore::Core::OPINDEX_F80ADD,FEXCore::Core::OPINDEX_F80SUB,
+      FEXCore::Core::OPINDEX_F80MUL,FEXCore::Core::OPINDEX_F80DIV};
+    for (unsigned I=0;I<4;++I) {
+      const auto& P=Frame->Pointers.FallbackHandlerPointers[Indices[I]];
+      const auto Message=fextl::fmt::format("[FEX-X87-HANDLER] op={} address=0x{:x} abi=0x{:x}\n",Names[I],P.Func,P.ABIHandler);
+      __wine_dbg_output(Message.c_str());
+    }
+    const auto Address=Frame->Pointers.FallbackHandlerPointers[Indices[0]].ABIHandler;
+    // Bounded read of our own generated dispatcher at initialization. This is
+    // never performed in the sampled helper path and stops at its final RET.
+    if (Address) {
+      const auto* Words=reinterpret_cast<const uint32_t*>(Address);
+      for (unsigned I=0;I<512;++I) {
+        const auto Message=fextl::fmt::format("[FEX-X87-CODE] offset={} word={:08x}\n",I*4,Words[I]);
+        __wine_dbg_output(Message.c_str());
+        if (Words[I]==0xd65f03c0U) break;
+      }
+    }
+  }
+}
+
+static void X87ProfileReport(FEXCore::Core::CpuStateFrame* Frame, bool Final) {
+  if (!Frame->X87Profile) return;
+  auto* D=reinterpret_cast<X87ProfileStorage*>(Frame->X87Profile->Storage);
+  if (!D) return;
+  if (!Final && D->Count==D->Reported) return;
+  const auto Now=X87ReadCounter();
+  if (!Final && (D->Count==D->Reported || Now-D->LastReport < D->Frequency*2)) return;
+  D->LastReport=Now;
+  unsigned Limit=Final ? D->Count : D->Reported+128;
+  if (Limit>D->Count) Limit=D->Count;
+  for (;D->Reported<Limit;++D->Reported) {
+    const auto& R=D->Records[D->Reported];
+    const auto Text=fextl::fmt::format(
+      "[FEX-X87-SAMPLE] tid={} index={} t0={} t1={} t2={} t3={} handler=0x{:x} caller=0x{:x} fcw=0x{:x} a={:x}:{:x} b={:x}:{:x}\n",
+      D->ThreadID,D->Reported,R.T[0],R.T[1],R.T[2],R.T[3],R.Handler,R.Caller,R.FCW,R.A[1],R.A[0],R.B[1],R.B[0]);
+    __wine_dbg_output(Text.c_str());
+  }
+  if (Final || D->Count==D->Capacity || !Frame->X87Profile->Countdown) {
+    const auto Text=fextl::fmt::format("[FEX-X87-END] tid={} collected={} reported={} dropped={} final={}\n",D->ThreadID,D->Count,D->Reported,D->Dropped,Final);
+    __wine_dbg_output(Text.c_str());
+  }
+}
+
+static void X87ProfileDestroy(FEXCore::Core::CpuStateFrame* Frame) {
+  X87ProfileReport(Frame,true);
+  if (!Frame->X87Profile) return;
+  delete reinterpret_cast<X87ProfileStorage*>(Frame->X87Profile->Storage);
+  Frame->X87Profile=nullptr;
+}
