+// SPDX-License-Identifier: MIT
+// GL opaque pointers are tokens in an ILP32 guest, never truncated LP64 pointers.
+#pragma once
+#include <cstdint>
+#include <mutex>
+#include <unordered_map>
+#include <stdexcept>
+
+template<typename Pointer>
+class GuestOpaqueHandles {
+  struct Entry { Pointer pointer; const void* owner; };
+  std::mutex mutex;
+  std::unordered_map<uint32_t, Entry> entries;
+  std::unordered_map<Pointer, uint32_t> reverse;
+  uint32_t next = 1;
+public:
+  uint32_t Encode(Pointer pointer, const void* owner) {
+    if (!pointer) return 0;
+    std::lock_guard lock(mutex);
+    if (auto it=reverse.find(pointer);it!=reverse.end()) return it->second;
+    if (!next) throw std::overflow_error("FEX GL guest handles exhausted");
+    const auto token=next++;
+    entries.emplace(token,Entry{pointer,owner});
+    try { reverse.emplace(pointer,token); }
+    catch (...) { entries.erase(token); throw; }
+    return token;
+  }
+  Pointer Decode(uint32_t token) {
+    if (!token) return nullptr;
+    std::lock_guard lock(mutex);
+    auto it=entries.find(token);
+    if (it==entries.end()) throw std::invalid_argument("FEX GL unknown guest handle");
+    return it->second.pointer;
+  }
+  void Forget(Pointer pointer) {
+    std::lock_guard lock(mutex);
+    auto it=reverse.find(pointer);
+    if (it!=reverse.end()) { entries.erase(it->second); reverse.erase(it); }
+  }
+  void CloseOwner(const void* owner) {
+    std::lock_guard lock(mutex);
+    for (auto it=entries.begin();it!=entries.end();) {
+      if (it->second.owner==owner) { reverse.erase(it->second.pointer); it=entries.erase(it); }
+      else ++it;
+    }
+  }
+};
