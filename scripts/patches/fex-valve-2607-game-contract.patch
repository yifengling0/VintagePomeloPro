+// Conversion is staged in host memory. Self process_vm copying goes through
+// the paired GNU user-copy frontend and returns EFAULT without changing
+// signal handlers, asserting, or dereferencing an untrusted guest pointer.
+static bool CopySigInfoToGuest(FEXCore::x86::siginfo_t* Info, const siginfo_t& Host) {
