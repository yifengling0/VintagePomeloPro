+// SPDX-License-Identifier: MIT
+#pragma once
+#include <cerrno>
+#include <cstddef>
+#include <sys/types.h>
+#include <sys/uio.h>
+#include <unistd.h>
+// GNU self-copy provided by HSL's same-ABI preload. Never enter process_vm
+// on normal_hap, change signal actions, or dereference guest user pointers.
+extern "C" long SteamOhosLocalCopy(void*,const void*,unsigned long) __attribute__((weak));
+namespace FEX::HLE {
+inline bool HslCopyUser(void* output,const void* input,size_t size) {
+  return !size || (SteamOhosLocalCopy && SteamOhosLocalCopy(output,input,size)==static_cast<long>(size));
+}
+// A normal_hap may only address this process. Use the same kernel-validated
+// GNU user-copy frontend for self copies, and reject a foreign pid before a
+// host process_vm call can raise SIGSYS. Returns bytes copied or -errno.
+inline long HslCopyIov(pid_t pid,struct iovec* destination,unsigned long destinationCount,
+                       struct iovec* source,unsigned long sourceCount,unsigned long flags) {
+  if(flags)return -EINVAL;
+  if(pid!=getpid())return -EPERM;
+  if(!SteamOhosLocalCopy)return -ENOSYS;
+  size_t copied=0;unsigned long destinationIndex=0,sourceIndex=0;
+  size_t destinationOffset=0,sourceOffset=0;
+  while(destinationIndex<destinationCount&&sourceIndex<sourceCount){
+    if(!destination[destinationIndex].iov_len){++destinationIndex;destinationOffset=0;continue;}
+    if(!source[sourceIndex].iov_len){++sourceIndex;sourceOffset=0;continue;}
+    const size_t destinationRemaining=destination[destinationIndex].iov_len-destinationOffset;
+    const size_t sourceRemaining=source[sourceIndex].iov_len-sourceOffset;
+    const size_t chunk=destinationRemaining<sourceRemaining?destinationRemaining:sourceRemaining;
+    void* target=static_cast<char*>(destination[destinationIndex].iov_base)+destinationOffset;
+    const void* input=static_cast<const char*>(source[sourceIndex].iov_base)+sourceOffset;
+    if(SteamOhosLocalCopy(target,input,chunk)!=static_cast<long>(chunk))
+      return copied?static_cast<long>(copied):-EFAULT;
+    copied+=chunk;destinationOffset+=chunk;sourceOffset+=chunk;
+    if(destinationOffset==destination[destinationIndex].iov_len){++destinationIndex;destinationOffset=0;}
+    if(sourceOffset==source[sourceIndex].iov_len){++sourceIndex;sourceOffset=0;}
+  }
+  return static_cast<long>(copied);
+}
+}
