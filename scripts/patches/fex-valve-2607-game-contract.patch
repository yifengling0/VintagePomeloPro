+  struct iovec Local {&Guest, sizeof(Guest)}, Remote {Info, sizeof(Guest)};
+  return ::process_vm_writev(getpid(), &Local, 1, &Remote, 1, 0) == static_cast<ssize_t>(sizeof(Guest));
