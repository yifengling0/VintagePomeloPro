diff --git a/FEXCore/Source/Interface/Core/LookupCache.cpp b/FEXCore/Source/Interface/Core/LookupCache.cpp
index ef08d814b5bd2539b5d9f4f2e7b1657670bbd314..b49409dc1a81589e087eec028415f0938cfb03eb 100644
--- a/FEXCore/Source/Interface/Core/LookupCache.cpp
+++ b/FEXCore/Source/Interface/Core/LookupCache.cpp
@@ -38,12 +38,14 @@ LookupCache::LookupCache(FEXCore::Context::ContextImpl* CTX)
   // Allocate a region of memory that we can use to back our block pointers
   // We need one pointer per page of virtual memory
   // At 64GB of virtual memory this will allocate 128MB of virtual memory space
-#if defined(_WIN32) && !defined(ARCHITECTURE_arm64ec)
-  // Wine-OHOS does not route every native access violation raised by a WOW64
-  // CPU DLL through BTCpuResetToConsistentState.  A reserved lookup cache can
-  // therefore escape as a host SIGSEGV before the overcommit tracker commits
-  // the faulting page.  Commit the virtual range up front; Wine still relies
-  // on the host kernel's demand paging, so untouched pages do not become RSS.
+#if defined(_WIN32)
+  // Wine-OHOS does not route every native access violation raised inside the
+  // CPU DLL (WOW64 BTCpuResetToConsistentState, nor the ARM64EC JIT path) back
+  // to FEX's overcommit tracker.  A reserved lookup cache therefore escapes as
+  // a host SIGSEGV (observed as SEGV_ACCERR on a ---p FEXMem_Lookup_L1 page)
+  // before the faulting page is ever committed.  Commit the virtual range up
+  // front; Wine still relies on the host kernel's demand paging, so untouched
+  // pages do not become RSS.
   PagePointer = reinterpret_cast<uintptr_t>(FEXCore::Allocator::VirtualAlloc(TotalCacheSize, false, true));
 #else
   PagePointer = reinterpret_cast<uintptr_t>(FEXCore::Allocator::VirtualAlloc(TotalCacheSize, false, false));
@@ -90,8 +92,8 @@ LookupCache::~LookupCache() {
 void LookupCache::ClearL2Cache(const FEXCore::LookupCacheBaseLockToken& lk) {
   // Clear out the page memory
   // PagePointer and PageMemory are sequential with each other. Clear both at once.
-#if defined(_WIN32) && !defined(ARCHITECTURE_arm64ec)
-  // Keep the WOW64 mapping committed for the same reason as in the constructor.
+#if defined(_WIN32)
+  // Keep the mapping committed for the same reason as in the constructor.
   FEXCore::Allocator::VirtualDontNeed(reinterpret_cast<void*>(PagePointer),
                                       ctx->Config.VirtualMemSize / FEXCore::Utils::FEX_PAGE_SIZE * 8 + CODE_SIZE, true);
 #else
@@ -104,7 +106,7 @@ void LookupCache::ClearL2Cache(const FEXCore::LookupCacheBaseLockToken& lk) {
 void LookupCache::ClearThreadLocalCaches(const LookupCacheWriteLockToken&) {
   // TODO: Preserve code cache entries?
   // Clear L1 and L2 by clearing the full cache.
-#if defined(_WIN32) && !defined(ARCHITECTURE_arm64ec)
+#if defined(_WIN32)
   FEXCore::Allocator::VirtualDontNeed(reinterpret_cast<void*>(PagePointer), TotalCacheSize, true);
 #else
   FEXCore::Allocator::VirtualDontNeed(reinterpret_cast<void*>(PagePointer), TotalCacheSize, false);
diff --git a/FEXCore/Source/Interface/Core/LookupCache.h b/FEXCore/Source/Interface/Core/LookupCache.h
index 5edd193f5ebc175b9e6287cdd5eb7e1bf435b0a5..632fc6752c11cfa5113eff8d4a9a05c4874e63d8 100644
--- a/FEXCore/Source/Interface/Core/LookupCache.h
+++ b/FEXCore/Source/Interface/Core/LookupCache.h
@@ -266,10 +266,11 @@ public:
           // Madvise the entries that we are dropping. Gives the memory back to the OS.
           LookupCacheEntry* FirstZeroL1Entry = &reinterpret_cast<LookupCacheEntry*>(L1Pointer)[CurrentL1Entries];
           size_t ZeroMemorySize = (MAX_L1_ENTRIES - CurrentL1Entries) * sizeof(LookupCacheEntry);
-#if defined(_WIN32) && !defined(ARCHITECTURE_arm64ec)
-          // Wine-OHOS does not route native WOW64 CPU-DLL lookup-cache faults
-          // back to FEX's overcommit handler. Keep dropped L1 pages committed
-          // so a later dynamic cache expansion can access them directly.
+#if defined(_WIN32)
+          // Wine-OHOS does not route native CPU-DLL lookup-cache faults (WOW64
+          // or ARM64EC) back to FEX's overcommit handler. Keep dropped L1 pages
+          // committed so a later dynamic cache expansion can access them without
+          // faulting on a PROT_NONE page.
           FEXCore::Allocator::VirtualDontNeed(FirstZeroL1Entry, ZeroMemorySize, true);
 #else
           FEXCore::Allocator::VirtualDontNeed(FirstZeroL1Entry, ZeroMemorySize, false);
