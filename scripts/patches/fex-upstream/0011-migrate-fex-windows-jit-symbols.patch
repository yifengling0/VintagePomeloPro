@@ -3,6 +3,7 @@
 
 #include "Common/JitSymbols.h"
 
+#include <cstdlib>
 #include <fcntl.h>
 #include <unistd.h>
 
@@ -17,7 +18,20 @@ JITSymbols::~JITSymbols() {
 
 void JITSymbols::InitFile(uint32_t ProcessPID) {
   // We can't use FILE here since we must be robust against forking processes closing our FD from under us.
+#if defined(_WIN32)
+  // Windows CRT opens DOS paths. Keep profiling output independent of the
+  // game's drive and working directory; naming remains opt-in in ContextImpl.
+  const char* Directory = std::getenv("FEX_JITMAPDIR");
+  if (!Directory || !Directory[0]) {
+    Directory = std::getenv("TEMP");
+  }
+  if (!Directory || !Directory[0]) {
+    Directory = ".";
+  }
+  const auto PerfMap = fextl::fmt::format("{}\\perf-{}.map", Directory, ProcessPID);
+#else
   const auto PerfMap = fextl::fmt::format("/tmp/perf-{}.map", ProcessPID);
+#endif
   fd = open(PerfMap.c_str(), O_CREAT | O_TRUNC | O_WRONLY | O_APPEND, 0644);
 }
 
@@ -126,7 +140,7 @@ void JITSymbols::RegisterNamedRegion(FEXCore::JITSymbolBuffer* Buffer, const voi
 void JITSymbols::WriteBuffer(FEXCore::JITSymbolBuffer* Buffer, bool ForceWrite) {
   auto Now = std::chrono::steady_clock::now();
   if (!ForceWrite) {
-    if (((Buffer->LastWrite - Now) < Buffer->MAXIMUM_THRESHOLD) && Buffer->Offset < Buffer->NEEDS_WRITE_DISTANCE) {
+    if (((Now - Buffer->LastWrite) < Buffer->MAXIMUM_THRESHOLD) && Buffer->Offset < Buffer->NEEDS_WRITE_DISTANCE) {
       // Still buffering, no need to write.
       return;
     }
