new file mode 100644
--- /dev/null
+++ b/include/wine/vpp_frame_scene.h
@@ -0,0 +1,33 @@
+/* Private VPP presentation data shared by the Wine Vulkan thunk and win32u. */
+#ifndef __WINE_VPP_FRAME_SCENE_H
+#define __WINE_VPP_FRAME_SCENE_H
+
+#define VPP_FRAME_SCENE_STYPE ((VkStructureType)0x6b565046)
+#define VPP_FRAME_SCENE_VERSION 1
+
+struct vpp_frame_scene_data
+{
+    uint32_t version, size;
+    uint64_t serial, color, depth;
+    uint32_t color_format, color_layout, depth_format, depth_layout, width, height;
+    float view_projection[16], inverse_view_projection[16];
+};
+
+struct vpp_frame_scene
+{
+    VkBaseInStructure header;
+    struct vpp_frame_scene_data data;
+};
+
+C_ASSERT(sizeof(struct vpp_frame_scene_data) == 184);
+
+static inline BOOL vpp_read_frame_scene(struct vpp_frame_scene_data *data, const void *bytes)
+{
+    uint32_t fields[2];
+    memcpy(fields, bytes, sizeof(fields));
+    if (fields[0] != VPP_FRAME_SCENE_VERSION || fields[1] != sizeof(*data)) return FALSE;
+    memcpy(data, bytes, sizeof(*data));
+    return data->serial && data->color && data->depth && data->width && data->height &&
+           data->width <= 8192 && data->height <= 8192;
+}
+#endif
