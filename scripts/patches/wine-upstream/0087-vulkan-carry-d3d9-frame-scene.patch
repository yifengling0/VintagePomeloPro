+typedef bool (*vpp_dispatch_frame_scene_fn)(void **, VkInstance, VkPhysicalDevice,
+    VkDevice, VkQueue, uint32_t, PFN_vkGetInstanceProcAddr, const void *);
+typedef void (*vpp_frame_scene_lifetime_fn)(void *);
+
+static vpp_dispatch_frame_scene_fn vpp_frame_dispatch;
+static vpp_frame_scene_lifetime_fn vpp_frame_destroy, vpp_frame_presented;
+static pthread_once_t vpp_frame_library_once = PTHREAD_ONCE_INIT;
+
+static void vpp_load_frame_library(void)
+{
+    void *library = dlopen("libvpp_harmony_wine_fg.so", RTLD_NOW | RTLD_LOCAL);
+    if (!library) return;
+    vpp_frame_destroy = dlsym(library, "VppHarmonyWineFrameDestroy");
+    vpp_frame_presented = dlsym(library, "VppHarmonyWineFramePresented");
+    if (vpp_frame_destroy && vpp_frame_presented)
+        vpp_frame_dispatch = dlsym(library, "VppHarmonyWineFrameDispatch");
+}
+
+static void vpp_destroy_frame_scene(struct swapchain *swapchain)
+{
+    if (!swapchain->frame_generation) return;
+    vpp_frame_destroy(swapchain->frame_generation);
+    swapchain->frame_generation = NULL;
+}
+
+static void vpp_dispatch_frame_scene(struct swapchain *swapchain, struct vulkan_queue *queue,
+                                     const struct vpp_frame_scene_data *scene)
+{
+    struct vulkan_device *device = queue->device;
+    struct vulkan_physical_device *physical = device->physical_device;
+    const uint32_t family = queue->info.queueFamilyIndex;
+    const VkQueueFlags required = VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT;
+    BOOL submitted;
+
+    if (swapchain->frame_generation_failed || swapchain->extents.width != scene->width ||
+        swapchain->extents.height != scene->height ||
+        (device->queue_props[family].queueFlags & required) != required)
+        return;
+    pthread_once(&vpp_frame_library_once, vpp_load_frame_library);
+    if (!vpp_frame_dispatch)
+    {
+        swapchain->frame_generation_failed = TRUE;
+        WARN("VPP_FG_WINE system frame generation library unavailable\n");
+        return;
+    }
+    submitted = vpp_frame_dispatch(&swapchain->frame_generation, physical->instance->host.instance,
+                                   physical->host.physical_device, device->host.device,
+                                   queue->host.queue, family, p_vkGetInstanceProcAddr, scene);
+    if (!submitted) swapchain->frame_generation_failed = TRUE;
+    if (scene->serial <= 24 || !submitted)
+        TRACE("VPP_FG_WINE serial=%s sdk_submit=%u\n", wine_dbgstr_longlong(scene->serial), submitted);
+}
