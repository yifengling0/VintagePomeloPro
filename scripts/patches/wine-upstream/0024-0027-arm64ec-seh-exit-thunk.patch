From 04318503acbec7de6c8082a44cba8ca1f074b45b Mon Sep 17 00:00:00 2001
From: VPP Runtime Maintainers <runtime@vintagepomelo.invalid>
Date: Wed, 30 Sep 2026 23:34:17 +0800
Subject: [PATCH] OHOS adaptation: 0027-arm64ec-seh-exit-thunk

Reconstructed from cd547f7a0ee9d3d59b3ec47317a7852dedf0443b.
Valve baseline: dc26e61847081a1b5cb0733dc30feba6ee575482.
Patch SHA-256: f37e26b4a5210259adf1378e549158e56d0d5c9738fbb0773238a1fa6fa201a9

diff --git a/dlls/winecrt0/arm64ec.c b/dlls/winecrt0/arm64ec.c
index 07958d9d1b083175369fa522b944e21db397d655..9201e49b9d97a09ae9a45c9f84b466709cb214c5 100644
--- a/dlls/winecrt0/arm64ec.c
+++ b/dlls/winecrt0/arm64ec.c
@@ -144,4 +144,46 @@ asm( "\t.def $iexit_thunk$cdecl$i8$i8i8i8; .scl 2; .type 32; .endef\n"
      "\t.symidx $iexit_thunk$cdecl$i8$i8i8i8\n"
      "\t.word 4\n" );
 
+/* Compiler-generated SEH references do not produce an exit thunk.  If the
+ * handler resolves to an x64 CRT, the auxiliary import thunk otherwise uses
+ * RVA 0 as its fallback and branches into the importing image's PE header.
+ * Supply the four-argument handler ABI just as for implicit memory intrinsics
+ * above.  A normal C call to __C_specific_handler cannot force this mapping:
+ * it conflicts with the compiler's implicit personality declaration.
+ * Map the auxiliary IAT symbol: LLD matches exit mappings against the import's
+ * unmangled thunk or IAT, not its #name ARM64EC entry.  Keep this reference weak
+ * so a local handler (e.g. crtdll/msvcrt) does not pull a conflicting import,
+ * and modules without SEH do not gain a handler dependency.
+ */
+asm( "\t.def $iexit_thunk$cdecl$i8$i8i8i8i8; .scl 2; .type 32; .endef\n"
+     "\t.section .wowthk$aa,\"xr\",discard,$iexit_thunk$cdecl$i8$i8i8i8i8\n"
+     "\t.globl $iexit_thunk$cdecl$i8$i8i8i8i8\n"
+     "\t.p2align 2\n"
+     "$iexit_thunk$cdecl$i8$i8i8i8i8:\n"
+     "\t.seh_proc $iexit_thunk$cdecl$i8$i8i8i8i8\n"
+     "\tsub sp, sp, #48\n"
+     "\t.seh_stackalloc 48\n"
+     "\tstp x29, x30, [sp, #32]\n"
+     "\t.seh_save_fplr 32\n"
+     "\tadd x29, sp, #32\n"
+     "\t.seh_add_fp 32\n"
+     "\t.seh_endprologue\n"
+     "\tadrp x8, __os_arm64x_dispatch_call_no_redirect\n"
+     "\tldr x16, [x8, :lo12:__os_arm64x_dispatch_call_no_redirect]\n"
+     "\tblr x16\n"
+     "\tmov x0, x8\n"
+     "\t.seh_startepilogue\n"
+     "\tldp x29, x30, [sp, #32]\n"
+     "\t.seh_save_fplr 32\n"
+     "\tadd sp, sp, #48\n"
+     "\t.seh_stackalloc 48\n"
+     "\t.seh_endepilogue\n"
+     "\tret\n"
+     "\t.seh_endproc\n"
+     "\t.section .hybmp$x,\"yi\"\n"
+     "\t.weak __imp___C_specific_handler\n"
+     "\t.symidx __imp___C_specific_handler\n"
+     "\t.symidx $iexit_thunk$cdecl$i8$i8i8i8i8\n"
+     "\t.word 4\n" );
+
 #endif /* __arm64ec__ */
