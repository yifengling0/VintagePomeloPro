+        struct swapchain *swapchain = swapchain_from_handle(present_info->pSwapchains[i]);
+        const uint32_t image_index = present_info->pImageIndices[i];
+        int present_result;
+        uint64_t deadline = 0;
+        if (image_index >= swapchain->image_count)
