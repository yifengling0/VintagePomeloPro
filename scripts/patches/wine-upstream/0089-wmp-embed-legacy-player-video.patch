+void resize_player_video(WindowsMediaPlayer *player)
+{
+    IVideoWindow *window;
+    IBasicVideo *video;
+    LONG x = 0, y = 0, width, height, video_width, video_height;
+    RECT rect;
+
+    if (!player->hwnd || !player->filter_graph || !GetClientRect(player->hwnd, &rect)) return;
+    if (FAILED(IGraphBuilder_QueryInterface(player->filter_graph, &IID_IVideoWindow, (void **)&window))) return;
+    width = rect.right;
+    height = rect.bottom;
+    if (!player->stretch_to_fit && SUCCEEDED(IGraphBuilder_QueryInterface(player->filter_graph,
+            &IID_IBasicVideo, (void **)&video)))
+    {
+        if (SUCCEEDED(IBasicVideo_GetVideoSize(video, &video_width, &video_height)) &&
+                video_width > 0 && video_height > 0)
+        {
+            if ((LONGLONG)width * video_height > (LONGLONG)height * video_width)
+            {
+                width = MulDiv(height, video_width, video_height);
+                x = (rect.right - width) / 2;
+            }
+            else
+            {
+                height = MulDiv(width, video_height, video_width);
+                y = (rect.bottom - height) / 2;
+            }
+        }
+        IBasicVideo_Release(video);
+    }
+    if (SUCCEEDED(IVideoWindow_put_Owner(window, (OAHWND)player->hwnd)))
+    {
+        IVideoWindow_put_WindowStyle(window, WS_CHILD | WS_CLIPSIBLINGS | WS_CLIPCHILDREN);
+        IVideoWindow_SetWindowPosition(window, x, y, width, height);
+    }
+    IVideoWindow_Release(window);
+}
