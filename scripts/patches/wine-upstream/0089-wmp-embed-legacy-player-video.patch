+    IMediaControl *control = player->media_control;
+    IMediaEvent *events = player->media_event;
+    IMediaSeeking *seeking = player->media_seeking;
+    IBasicAudio *audio = player->basic_audio;
+    HRESULT result = S_OK;
+
+    if (!graph) return NS_S_WMPCORE_COMMAND_NOT_AVAILABLE;
+    player->filter_graph = NULL;
+    player->media_control = NULL;
+    player->media_event = NULL;
+    player->media_seeking = NULL;
+    player->basic_audio = NULL;
+
+    if (control)
+    {
+        result = IMediaControl_Stop(control);
+        IMediaControl_Release(control);
+    }
+    if (events) IMediaEvent_Release(events);
+    if (seeking) IMediaSeeking_Release(seeking);
+    if (audio) IBasicAudio_Release(audio);
+    IGraphBuilder_Release(graph);
+    return result;
