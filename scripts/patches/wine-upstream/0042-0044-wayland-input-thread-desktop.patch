     pointer->focused_hwnd = hwnd;
     pointer->enter_serial = serial;
@@ -221,7 +224,7 @@ static void pointer_handle_enter(void *data, struct wl_pointer *wl_pointer,
     /* Handle the enter as a motion, to account for cases where the
