+/*
+ * WineHua Win32 Vulkan offscreen and WSI smoke.
+ *
+ * The optional present path checks Wine's Vulkan swapchain, including an
+ * explicit running-window resize when WINEHUA_VULKAN_RESIZE=1.
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <windows.h>
+#include "wine/vulkan.h"
