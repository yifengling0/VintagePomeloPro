+                     state->heaven_d24s8_depth_comparison_sampler_values, 4);
+    format_hex_array(heaven_d24s8_array_values,
+                     sizeof(heaven_d24s8_array_values),
+                     state->heaven_d24s8_array_values,
+                     WINEHUA_D24_ARRAY_LAYERS);
