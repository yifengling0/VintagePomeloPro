From 3a903514c9b1c85c9eb2406e93b399eec21e91b0 Mon Sep 17 00:00:00 2001
From: VPP Runtime Maintainers <runtime@vintagepomelo.invalid>
Date: Wed, 30 Sep 2026 23:34:17 +0800
Subject: [PATCH] OHOS adaptation: 0023-ohos-default-grayscale-font-aa

Reconstructed from cd547f7a0ee9d3d59b3ec47317a7852dedf0443b.
Valve baseline: dc26e61847081a1b5cb0733dc30feba6ee575482.
Patch SHA-256: 714c12a82be80c6044f29615deda769b2601b78908e7f85cead864448d3622f0

diff --git a/dlls/win32u/freetype.c b/dlls/win32u/freetype.c
index 6c50aa82d70452b6b9ef092e391d7a887cc4d5a9..c17e7d97edcbc8495464b2280da293bccca05248 100644
--- a/dlls/win32u/freetype.c
+++ b/dlls/win32u/freetype.c
@@ -1568,11 +1568,20 @@ static void freetype_load_fonts(void)
 #ifdef SONAME_LIBFONTCONFIG
     load_fontconfig_fonts();
 #ifdef __OHOS__
-    /* OHOS: libfontconfig.so 不在设备上, fontconfig 加载会静默失败.
-     * 此时需要额外扫描 /system/fonts/ 来使用系统的 HarmonyOS 字体. */
+    /* OHOS devices do not provide fontconfig. Besides scanning the system font
+     * directory, choose grayscale antialiasing explicitly: fontconfig normally
+     * initializes this default, while zero leaves scalable fonts in monochrome
+     * mode. Avoid LCD subpixel rendering because the compositor orientation and
+     * physical pixel layout are not guaranteed here. */
     if (!fontconfig_enabled)
+    {
+        default_aa_flags = GGO_GRAY4_BITMAP;
         ReadFontDir("/system/fonts", TRUE);
+    }
 #endif
+#elif defined(__OHOS__)
+    default_aa_flags = GGO_GRAY4_BITMAP;
+    ReadFontDir("/system/fonts", TRUE);
 #elif defined(__APPLE__)
     load_mac_fonts();
 #elif defined(__ANDROID__)
