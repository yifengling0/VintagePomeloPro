diff --git a/dlls/light.msstyles/light.rc b/dlls/light.msstyles/light.rc
index 84b8a0476385b6648d91186d53d73a26bdd0818c..2ac45429426da63b356505a97fb1041899710626 100644
--- a/dlls/light.msstyles/light.rc
+++ b/dlls/light.msstyles/light.rc
@@ -98,8 +98,8 @@ BLUE_INI TEXTFILE
 "\r\n; System colors\r\n"
 "Scrollbar = 255 255 255\r\n"
 "Background = 37 111 149\r\n"
-"ActiveCaption = 50 150 250\r\n"
-"InactiveCaption = 128 128 128\r\n"
+"ActiveCaption = 243 243 243\r\n"
+"InactiveCaption = 249 249 249\r\n"
 "Menu = 255 255 255\r\n"
 "Window = 255 255 255\r\n"
 "WindowFrame = 158 158 158\r\n"
@@ -115,7 +115,7 @@ BLUE_INI TEXTFILE
 "BtnShadow = 166 166 166\r\n"
 "GrayText = 106 106 106\r\n"
 "BtnText = 0 0 0\r\n"
-"InactiveCaptionText = 200 200 200\r\n"
+"InactiveCaptionText = 140 140 140\r\n"
 "BtnHighlight = 255 255 255\r\n"
 "DkShadow3d = 106 106 106\r\n"
 "Light3d = 227 227 227\r\n"
@@ -123,21 +123,20 @@ BLUE_INI TEXTFILE
 "InfoBk = 255 255 255\r\n"
 "ButtonAlternateFace = 255 255 255\r\n"
 "HotTracking = 48 150 250\r\n"
-"GradientActiveCaption = 50 150 250\r\n"
-"GradientInactiveCaption = 128 128 128\r\n"
+"GradientActiveCaption = 243 243 243\r\n"
+"GradientInactiveCaption = 249 249 249\r\n"
 "MenuHilight = 48 150 250\r\n"
 "MenuBar = 255 255 255\r\n"
 
 "\r\n; Nonclient metrics\r\n"
-"CaptionFont = Tahoma, 10, bold\r\n"
+"; 不定义 CaptionFont/MenuFont 等字体: uxtheme 会把主题给出的字体经\r\n"
+"; SPI_SETNONCLIENTMETRICS 写进注册表, 覆盖系统默认 —— 系统默认是 Wine 取\r\n"
+"; DEFAULT_GUI_FONT 后按 locale 映射出来的字体, 中文环境下有中文字形。\r\n"
+"; 主题写死 Tahoma 会让菜单/标题栏失去中文字形回退、字号也偏小。\r\n"
+"; 只保留尺寸类度量, 字体交回系统默认。\r\n"
 "CaptionBarHeight = 25\r\n"
-"SmallCaptionFont = Tahoma, 8, bold\r\n"
 "SMCaptionBarHeight = 17\r\n"
 "SMCaptionBarWidth = 17\r\n"
-"MenuFont = Tahoma, 8\r\n"
-"StatusFont = Tahoma, 8\r\n"
-"MsgBoxFont = Tahoma, 8\r\n"
-"IconTitleFont = Tahoma, 8\r\n"
 
 "\r\n; Flat menus\r\n"
 "FlatMenus = true\r\n"
