From 9956c8fea361e0a19c195791d7850b1a2dc51499 Mon Sep 17 00:00:00 2001
From: VPP Runtime Maintainers <runtime@vintagepomelo.invalid>
Date: Wed, 30 Sep 2026 23:34:17 +0800
Subject: [PATCH] OHOS adaptation: 0070-ddraw-clip-surface-bounds

Reconstructed from cd547f7a0ee9d3d59b3ec47317a7852dedf0443b.
Valve baseline: dc26e61847081a1b5cb0733dc30feba6ee575482.
Patch SHA-256: 14632b06cee1944db1b7ea9134e43a6469a8c161c828d0c660ab48e94d1367c3

diff --git a/dlls/ddraw/surface.c b/dlls/ddraw/surface.c
index ca24be21b7d021bddde0023191058b22daa68cca..9dd0e573083117d421911a5f5840ec508ce59bcb 100644
--- a/dlls/ddraw/surface.c
+++ b/dlls/ddraw/surface.c
@@ -1638,7 +1638,7 @@ static HRESULT ddraw_surface_blt_clipped(struct ddraw_surface *dst_surface, cons
         struct ddraw_surface *src_surface, const RECT *src_rect_in, DWORD flags, DWORD fill_colour,
         const struct wined3d_blt_fx *fx, enum wined3d_texture_filter_type filter)
 {
-    RECT src_rect, dst_rect;
+    RECT src_rect, dst_rect, dst_bounds, dst_rect_clipped;
     float scale_x, scale_y;
     const RECT *clip_rect;
     DWORD clip_list_size;
@@ -1693,8 +1693,16 @@ static HRESULT ddraw_surface_blt_clipped(struct ddraw_surface *dst_surface, cons
     scale_x = (float)(src_rect.right - src_rect.left) / (float)(dst_rect.right - dst_rect.left);
     scale_y = (float)(src_rect.bottom - src_rect.top) / (float)(dst_rect.bottom - dst_rect.top);
 
+    /* A window clipper can extend beyond the primary surface when a virtual
+     * desktop is smaller than the window. Keep the original destination for
+     * source scaling, but never submit an out-of-bounds blit to WineD3D. */
+    SetRect(&dst_bounds, 0, 0, dst_surface->surface_desc.dwWidth,
+            dst_surface->surface_desc.dwHeight);
+    if (!IntersectRect(&dst_rect_clipped, &dst_rect, &dst_bounds))
+        return DD_OK;
+
     if (FAILED(hr = IDirectDrawClipper_GetClipList(&dst_surface->clipper->IDirectDrawClipper_iface,
-            &dst_rect, NULL, &clip_list_size)))
+            &dst_rect_clipped, NULL, &clip_list_size)))
     {
         WARN("Failed to get clip list size, hr %#lx.\n", hr);
         return hr;
@@ -1707,7 +1715,7 @@ static HRESULT ddraw_surface_blt_clipped(struct ddraw_surface *dst_surface, cons
     }
 
     if (FAILED(hr = IDirectDrawClipper_GetClipList(&dst_surface->clipper->IDirectDrawClipper_iface,
-            &dst_rect, clip_list, &clip_list_size)))
+            &dst_rect_clipped, clip_list, &clip_list_size)))
     {
         WARN("Failed to get clip list, hr %#lx.\n", hr);
         free(clip_list);
