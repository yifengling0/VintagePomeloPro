From: VPP Runtime Maintainers <runtime@vintagepomelo.invalid>
Date: Wed, 30 Sep 2026 23:34:17 +0800
Subject: [PATCH] OHOS adaptation: 0036-wined3d-pixel-format-id-lookup

Reconstructed from cd547f7a0ee9d3d59b3ec47317a7852dedf0443b.
Valve baseline: dc26e61847081a1b5cb0733dc30feba6ee575482.
Patch SHA-256: da66983ac6e652034abf40f8c8a88f5906ec6344876a540ce980904c2d8d9e04

diff --git a/dlls/wined3d/swapchain.c b/dlls/wined3d/swapchain.c
index cf73b56d50a109c08146cce22c73e2dbe14536f0..dfaf77f43982b79e1a187f66ecd6b87828fae836 100644
--- a/dlls/wined3d/swapchain.c
+++ b/dlls/wined3d/swapchain.c
@@ -610,6 +610,19 @@ static bool swapchain_present_is_partial_copy(struct wined3d_swapchain *swapchai
     return false;
 }
 
+/* WGL IDs are not slots: adapter initialization compacts successful queries. */
+static const struct wined3d_pixel_format *swapchain_gl_find_pixel_format(
+        const struct wined3d_adapter_gl *adapter_gl, int format_id)
+{
+    unsigned int i;
+
+    if (format_id <= 0) return NULL;
+    for (i = 0; i < adapter_gl->pixel_format_count; ++i)
+        if (adapter_gl->pixel_formats[i].iPixelFormat == format_id)
+            return &adapter_gl->pixel_formats[i];
+    return NULL;
+}
+
 static void swapchain_gl_present(struct wined3d_swapchain *swapchain,
         const RECT *src_rect, const RECT *dst_rect, unsigned int swap_interval, uint32_t flags)
 {
@@ -630,9 +643,10 @@ static void swapchain_gl_present(struct wined3d_swapchain *swapchain,
 
     TRACE("Presenting DC %p.\n", context_gl->dc);
 
-    pixel_format = &wined3d_adapter_gl(swapchain->device->adapter)->pixel_formats[context_gl->pixel_format];
+    pixel_format = swapchain_gl_find_pixel_format(wined3d_adapter_gl(swapchain->device->adapter),
+            context_gl->pixel_format);
     if (context_gl->dc == wined3d_device_gl(swapchain->device)->backup_dc
-            || (pixel_format->swap_method != WGL_SWAP_COPY_ARB
+            || ((!pixel_format || pixel_format->swap_method != WGL_SWAP_COPY_ARB)
             && swapchain_present_is_partial_copy(swapchain, dst_rect)))
     {
         swapchain_blit_gdi(swapchain, context, src_rect, dst_rect);
