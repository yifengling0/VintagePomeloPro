From 589dabca642e7daa094136cca5811b218eec70e7 Mon Sep 17 00:00:00 2001
From: VPP Runtime Maintainers <runtime@vintagepomelo.invalid>
Date: Wed, 30 Sep 2026 23:34:17 +0800
Subject: [PATCH] OHOS adaptation: 0064-mfplat-opt-in-nonshared-texture-retry

Reconstructed from cd547f7a0ee9d3d59b3ec47317a7852dedf0443b.
Valve baseline: dc26e61847081a1b5cb0733dc30feba6ee575482.
Patch SHA-256: 0465ebe4c88ba6747cb2fd30c4623dce7942e701d226451d1c9b70d2b1abfe58

diff --git a/dlls/mfplat/sample.c b/dlls/mfplat/sample.c
index 60d78dc8bf08bb788e592180d89a608b0607d6da..e4bd758c965426cb8cadf32a93b04b2d601bd4f0 100644
--- a/dlls/mfplat/sample.c
+++ b/dlls/mfplat/sample.c
@@ -1447,7 +1447,18 @@ static HRESULT sample_allocator_allocate_sample(struct sample_allocator *allocat
                 desc.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE | D3D11_CPU_ACCESS_READ;
             desc.MiscFlags = allocator->frame_desc.miscflags;
 
-            if (SUCCEEDED(hr = ID3D11Device_CreateTexture2D(service->d3d11_device, &desc, NULL, &texture)))
+            hr = ID3D11Device_CreateTexture2D(service->d3d11_device, &desc, NULL, &texture);
+            if (FAILED(hr) && (desc.MiscFlags & (D3D11_RESOURCE_MISC_SHARED | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX)))
+            {
+                const char *fallback = getenv("WINEHUA_MF_FALLBACK_NONSHARED");
+                if (fallback && !strcmp(fallback, "1"))
+                {
+                    TRACE("Opt-in retry of shared D3D11 texture without shared flags, hr %#lx.\n", hr);
+                    desc.MiscFlags &= ~(D3D11_RESOURCE_MISC_SHARED | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX);
+                    hr = ID3D11Device_CreateTexture2D(service->d3d11_device, &desc, NULL, &texture);
+                }
+            }
+            if (SUCCEEDED(hr))
             {
                 hr = MFCreateDXGISurfaceBuffer(&IID_ID3D11Texture2D, (IUnknown *)texture, 0, FALSE, &buffer);
                 ID3D11Texture2D_Release(texture);
