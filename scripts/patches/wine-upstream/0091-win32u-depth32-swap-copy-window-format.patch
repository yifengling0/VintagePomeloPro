+static BOOL egldrv_probe_swap_copy( struct egl_platform *egl )
+{
+    const struct opengl_funcs *funcs = &display_funcs;
+    EGLenum previous_api = funcs->p_eglQueryAPI();
+    EGLContext context;
+    BOOL supported = FALSE;
+
+    if (funcs->p_eglGetCurrentContext() != EGL_NO_CONTEXT || !funcs->p_eglBindAPI( EGL_OPENGL_API ))
+        return FALSE;
+
+    context = funcs->p_eglCreateContext( egl->display, EGL_NO_CONFIG_KHR, EGL_NO_CONTEXT, NULL );
+    if (context != EGL_NO_CONTEXT)
+    {
+        if (funcs->p_eglMakeCurrent( egl->display, EGL_NO_SURFACE, EGL_NO_SURFACE, context ))
+        {
+            supported = egldrv_test_swap_copy( funcs );
+            funcs->p_eglMakeCurrent( egl->display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT );
+        }
+        funcs->p_eglDestroyContext( egl->display, context );
+    }
+    funcs->p_eglBindAPI( previous_api );
+    return supported;
+}
