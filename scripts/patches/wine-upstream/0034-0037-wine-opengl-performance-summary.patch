--- a/dlls/opengl32/make_opengl
+++ b/dlls/opengl32/make_opengl
@@ -188,6 +188,15 @@ my %manual_win_thunks =
     );
 my %manual_unix_thunks =
     (
+     "glBufferSubData" => 1,
+     "glBufferSubDataARB" => 1,
+     "glTexImage2D" => 1,
+     "glTexSubImage2D" => 1,
+     "glCompressedTexSubImage2D" => 1,
+     "glCompileShader" => 1,
+     "glLinkProgram" => 1,
+     "glGetShaderiv" => 1,
+     "glGetProgramiv" => 1,
      "glBlitFramebuffer" => 1,
      "glBlitFramebufferEXT" => 1,
      "glBlitNamedFramebuffer" => 1,
@@ -470,6 +479,8 @@ sub generate_unix_thunk($$$$)
     my $need_wrap = $manual_wow64_wrapper || needs_wrapper( $name, $func );
     my $need_lock = $func_ret =~ /HGLRC|HPBUFFERARB/;
     my $need_funcs = !$need_wrap || ($prefix eq "ext" && $name !~ /^wgl/);
+    # Timing wrappers must keep the original native/WOW64 availability checks.
+    $need_funcs = 1 if $name eq "glTexImage2D" || $name eq "glTexSubImage2D";
     my $teb = $is_wow64 ? "teb" : "params->teb";
     my $ret_stat = "return STATUS_SUCCESS;";
     my $invalidation = "";
