+static BOOL CALLBACK init_harmony_fg_policy(INIT_ONCE *once, void *param, void **out)
+{
+    static const WCHAR path[] = L"\\\\?\\unix\\data\\storage\\el2\\base\\files\\.vpp-harmony-frame-policy-v1";
+    HANDLE file, mapping;
+
+    if ((file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE,
+            NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL)) == INVALID_HANDLE_VALUE)
+        return TRUE;
+    mapping = CreateFileMappingW(file, NULL, PAGE_READONLY, 0, 0, NULL);
+    CloseHandle(file);
+    if (mapping)
+    {
+        *out = MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, sizeof(UINT32));
+        CloseHandle(mapping);
+    }
+    return TRUE;
+}
+
+UINT32 wined3d_harmony_fg_request(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    void *policy = NULL;
+
+    InitOnceExecuteOnce(&once, init_harmony_fg_policy, NULL, &policy);
+    return policy ? __atomic_load_n((const UINT32 *)policy, __ATOMIC_ACQUIRE) : 0;
+}
+
+static void record_harmony_gl_scene(struct wined3d_context_gl *context_gl,
+        const struct wined3d_state *state, UINT32 request)
+{
+    struct wined3d_context *context = &context_gl->c;
+    const struct wined3d_rendertarget_view *rt = state->fb.render_targets[0];
+    const struct wined3d_rendertarget_view *depth = state->fb.depth_stencil;
+    const struct wined3d_viewport *viewport = state->viewports;
+    const struct wined3d_ffp_vs_constants *constants;
+    struct wined3d_swapchain *swapchain;
+    struct wined3d_texture *color;
+    struct
+    {
+        char marker[8];
+        UINT32 request, width, height, clip_zero_to_one;
+        struct wined3d_matrix camera, inverse;
+    } scene = { .marker = {'V','P','P','F','G','G','L','1'}, .request = request };
+
+    if (!rt || rt->resource->type != WINED3D_RTYPE_TEXTURE_2D || !depth ||
+        (state->depth_stencil_state && (!state->depth_stencil_state->desc.depth ||
+        !state->depth_stencil_state->desc.depth_write)))
+        return;
+    color = wined3d_texture_from_resource(rt->resource);
+    if (!(swapchain = color->swapchain) || !swapchain->back_buffers ||
+        color != swapchain->back_buffers[0])
+    {
+        unsigned int i;
+        for (i = 0; i < context->device->swapchain_count; ++i)
+        {
+            swapchain = context->device->swapchains[i];
+            if (swapchain->frame_generation.depth == depth->resource)
+                swapchain->frame_generation.rejected = TRUE;
+        }
+        return;
+    }
+    if (swapchain->frame_generation.rejected)
+        return;
+
+    if (!context_gl->gl_info->gl_ops.ext.p_glDebugMessageInsert ||
+        !(context->d3d_info->wined3d_creation_flags & WINED3D_PIXEL_CENTER_INTEGER) ||
+        use_vs(state) || context->stream_info.position_transformed ||
+        !state->viewport_count || viewport->x || viewport->y ||
+        viewport->width != rt->width || viewport->height != rt->height ||
+        viewport->min_z != 0.0f || viewport->max_z != 1.0f ||
+        rt->width != depth->width || rt->height != depth->height ||
+        rt->sub_resource_idx || depth->sub_resource_idx)
+    {
+        swapchain->frame_generation.rejected = TRUE;
+        return;
+    }
+    constants = wined3d_buffer_load_sysmem(context->device->push_constants[WINED3D_PUSH_CONSTANTS_VS_FFP], context);
+    if (!constants)
+    {
+        swapchain->frame_generation.rejected = TRUE;
+        return;
+    }
+    wined3d_gl_frame_camera(context, constants, state, &scene.camera);
+    if (swapchain->frame_generation.depth)
+    {
+        if (swapchain->frame_generation.depth != depth->resource ||
+            swapchain->frame_generation.context != context ||
+            swapchain->frame_generation.request != request ||
+            memcmp(&scene.camera, &swapchain->frame_generation.camera, sizeof(scene.camera)))
+            swapchain->frame_generation.rejected = TRUE;
+        return;
+    }
+    if (!invert_matrix(&scene.inverse, &scene.camera))
+    {
+        swapchain->frame_generation.rejected = TRUE;
+        return;
+    }
+    scene.width = rt->width;
+    scene.height = rt->height;
+    scene.clip_zero_to_one = !!context->d3d_info->clip_control;
+    context_gl->gl_info->gl_ops.ext.p_glDebugMessageInsert(GL_DEBUG_SOURCE_APPLICATION, GL_DEBUG_TYPE_MARKER,
+            0, GL_DEBUG_SEVERITY_NOTIFICATION, sizeof(scene), (const char *)&scene);
+    swapchain->frame_generation.depth = depth->resource;
+    swapchain->frame_generation.context = context;
+    swapchain->frame_generation.camera = scene.camera;
+    swapchain->frame_generation.request = request;
+}
