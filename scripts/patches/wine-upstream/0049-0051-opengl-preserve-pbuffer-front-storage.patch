From 03a87758a70db0fef1225f48eabda0935d92f92c Mon Sep 17 00:00:00 2001
From: VPP Runtime Maintainers <runtime@vintagepomelo.invalid>
Date: Wed, 30 Sep 2026 23:34:17 +0800
Subject: [PATCH] OHOS adaptation: 0051-opengl-preserve-pbuffer-front-storage

Reconstructed from cd547f7a0ee9d3d59b3ec47317a7852dedf0443b.
Valve baseline: dc26e61847081a1b5cb0733dc30feba6ee575482.
Patch SHA-256: 65173fe3315d691283a7525f06ab114acc99815476b358b50806f6aa15cc1470

diff --git a/dlls/opengl32/unix_wgl.c b/dlls/opengl32/unix_wgl.c
index 22edcdcd4c78e2cb1d0c4c720e03feadd56f623a..2b7e4050aa1a1ad7ff4ce698a5433d27a8b2263a 100644
--- a/dlls/opengl32/unix_wgl.c
+++ b/dlls/opengl32/unix_wgl.c
@@ -1995,6 +1995,7 @@ static void flush_context( TEB *teb, void (*flush)(void) )
     struct opengl_drawable *read, *draw;
     struct context *ctx = get_current_context( teb, &read, &draw );
     HWND draw_hwnd = ctx && draw && draw->client ? draw->client->hwnd : NULL;
+    BOOL swap_preserves_buffers = draw && draw->swap_preserves_buffers;
     const struct opengl_funcs *funcs = teb->glTable;
     UINT flags = 0;
 
@@ -2011,7 +2012,7 @@ static void flush_context( TEB *teb, void (*flush)(void) )
     pop_default_fbo( teb );
     pop_default_fbo_buffers( teb );
 
-    if (flags & GL_FLUSH_FORCE_SWAP)
+    if ((flags & GL_FLUSH_FORCE_SWAP) && !swap_preserves_buffers)
     {
         GLenum mask = GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT | GL_STENCIL_BUFFER_BIT;
         RECT rect;
diff --git a/dlls/winewayland.drv/opengl_readback.c b/dlls/winewayland.drv/opengl_readback.c
index 9975c42e504e59c7dfa364218c6d8f1aed07169e..0959d36c906e979909fbe36fc068b59df59eb107 100644
--- a/dlls/winewayland.drv/opengl_readback.c
+++ b/dlls/winewayland.drv/opengl_readback.c
@@ -624,6 +624,9 @@ BOOL winehua_readback_surface_create(HWND hwnd, BOOL raw, int format, struct ope
         return FALSE;
     }
 
+    /* EGL pbuffers preserve their storage. Our explicit GPU present exports
+     * it without swapping front/back; front rendering needs no copy back. */
+    gl->base.swap_preserves_buffers = TRUE;
     opengl_drawable_map_buffer(&gl->base, GL_FRONT_LEFT, GL_BACK_LEFT);
     opengl_drawable_map_buffer(&gl->base, GL_FRONT, GL_BACK);
     opengl_drawable_map_buffer(&gl->base, GL_FRONT_AND_BACK, GL_BACK);
diff --git a/include/wine/opengl_driver.h b/include/wine/opengl_driver.h
index c8f13a0208d1bdf3084a47be96a090a0e8936a44..3d28ea2e42d145c5810f43851f3adada0b2e10ee 100644
--- a/include/wine/opengl_driver.h
+++ b/include/wine/opengl_driver.h
@@ -226,6 +226,7 @@ struct opengl_drawable
     GLuint                              read_fbo;       /* default read FBO name when emulating framebuffer */
     GLuint                              draw_fbo;       /* default draw FBO name when emulating framebuffer */
     GLenum                              buffer_map[GL_AUX3 - GL_FRONT_LEFT + 1]; /* buffer constants mapping */
+    BOOL                                swap_preserves_buffers; /* present publishes storage without exchanging buffers */
 };
 
 static inline const char *debugstr_opengl_drawable( struct opengl_drawable *drawable )
