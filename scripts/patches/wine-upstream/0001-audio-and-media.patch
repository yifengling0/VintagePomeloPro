+	i->modenv.delay = i->modenv.attack = i->modenv.hold = i->modenv.decay = i->modenv.release = -12000.0f;
+
+	i->initialFilterFc = 13500;
+
+	i->delayModLFO = -12000.0f;
+	i->delayVibLFO = -12000.0f;
+}
