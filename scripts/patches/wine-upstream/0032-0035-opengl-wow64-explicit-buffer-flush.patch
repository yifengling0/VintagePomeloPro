From 87cc7f9ca3ad5cf5679d88576bac3f25fb2e731e Mon Sep 17 00:00:00 2001
From: VPP Runtime Maintainers <runtime@vintagepomelo.invalid>
Date: Wed, 30 Sep 2026 23:34:17 +0800
Subject: [PATCH] OHOS adaptation: 0035-opengl-wow64-explicit-buffer-flush

Reconstructed from cd547f7a0ee9d3d59b3ec47317a7852dedf0443b.
Valve baseline: dc26e61847081a1b5cb0733dc30feba6ee575482.
Patch SHA-256: 7777bf55e87a0d2a351dd440678815a6b7ea505b81d51f628ead1c86465e3520

diff --git a/dlls/opengl32/unix_wgl.c b/dlls/opengl32/unix_wgl.c
index 095e26cee9b223823b79c515a56e48971ac71ee1..a4dfbf2680a226474cd2469e80e1817c74532715 100644
--- a/dlls/opengl32/unix_wgl.c
+++ b/dlls/opengl32/unix_wgl.c
@@ -180,6 +180,7 @@ struct buffer
     void *host_ptr;
     void *map_ptr;
     size_t copy_length;
+    GLbitfield map_access;
     void *vm_ptr;
     SIZE_T vm_size;
     BOOL pinned;
@@ -2957,6 +2958,14 @@ static void flush_buffer( TEB *teb, struct buffer *buffer, size_t offset, size_t
     };
     VkResult vr;
 
+    /* A WOW64 shadow is not the driver's mapping. Publish the requested
+     * bytes before the caller flushes that mapping, not at unmap time. The
+     * flush offset is relative to the mapped range. Invalid ranges must
+     * reach the driver without touching memory. */
+    if (buffer->copy_length && (buffer->map_access & GL_MAP_FLUSH_EXPLICIT_BIT)
+            && offset <= buffer->copy_length && length <= buffer->copy_length - offset)
+        memcpy( (char *)buffer->host_ptr + offset, (char *)buffer->map_ptr + offset, length );
+
     if (!buffer->vk_memory) return;
 
     vr = buffer->vk_device->p_vkFlushMappedMemoryRanges( buffer->vk_device->vk_device, 1, &memory_range );
@@ -3157,6 +3166,7 @@ static void *wow64_map_buffer( TEB *teb, struct buffer *buffer, GLenum target, G
     }
 
     buffer->host_ptr = ptr;
+    buffer->map_access = access;
     if (!offset && !length) length = buffer->size;
     if (ULongToPtr(PtrToUlong(ptr)) == ptr) /* we're lucky */
     {
@@ -3416,14 +3426,15 @@ static BOOL wow64_unmap_buffer( TEB *teb, struct buffer *buffer )
         unmap_vk_buffer( buffer );
     }
 
-    if (buffer->copy_length)
+    if (buffer->copy_length && !(buffer->map_access & GL_MAP_FLUSH_EXPLICIT_BIT))
     {
         TRACE( "Copying %#zx from wow64 buffer %p to buffer %p\n", buffer->copy_length,
                buffer->map_ptr, buffer->host_ptr );
         memcpy( buffer->host_ptr, buffer->map_ptr, buffer->copy_length );
-        buffer->copy_length = 0;
     }
 
+    buffer->copy_length = 0;
+    buffer->map_access = 0;
     buffer->host_ptr = buffer->map_ptr = NULL;
     return TRUE;
 }
