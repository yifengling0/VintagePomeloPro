+         * captured by the WineHua child process log. */
+        struct sigaction sa;
+        memset( &sa, 0, sizeof(sa) );
+        sa.sa_sigaction = sigsys_diag;
+        sa.sa_flags = SA_SIGINFO;
+        sigaction( SIGSYS, &sa, NULL );
+    }
+#endif
     server_argv0 = argv[0];
     parse_options( argc, argv, "d::fhk::p::vw", long_options, option_callback );
 
