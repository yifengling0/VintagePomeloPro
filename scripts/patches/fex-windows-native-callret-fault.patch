-bool HandleAccessViolation(FEXCore::Core::InternalThreadState* Thread, uint64_t Address, uint64_t& CallRetSPReg) {
+bool HandleAccessViolation(FEXCore::Core::InternalThreadState* Thread, uint64_t Address, uint64_t& CallRetSPReg, bool IsJIT) {
   auto CallRetStackInfo = GetInfoThread(Thread);
   if (Address >= CallRetStackInfo.AllocationBase && Address < CallRetStackInfo.AllocationEnd) {
+    if (!IsJIT) {
+      // Native helpers use normal ABI registers, not the JIT's cached SP
+      // convention. Invalidation decommits/recommits this owned payload and
+      // can race a native prediction-entry read. Retry that read without
+      // corrupting an unrelated native register (WOW64's X25 can be guest RSP).
+      const auto Base = reinterpret_cast<uint64_t>(Thread->CallRetStackBase);
+      if (Address < Base || Address - Base >= FEXCore::Core::InternalThreadState::CALLRET_STACK_SIZE) {
+        return false; // Never commit either guard page for a native access.
+      }
+      const auto Page = Address & FEXCore::Utils::FEX_PAGE_MASK;
+      return ::VirtualAlloc(reinterpret_cast<void*>(Page), FEXCore::Utils::FEX_PAGE_SIZE,
+                            MEM_COMMIT, PAGE_READWRITE) != nullptr;
+    }
     LogMan::Msg::DFmt("Call-ret stack inbalance: {:X}", Address);
     CallRetSPReg = CallRetStackInfo.DefaultLocation;
     return true;
