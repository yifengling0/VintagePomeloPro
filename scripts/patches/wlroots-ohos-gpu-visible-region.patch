+static void xwm_child_read_visible_region(struct wlr_xwm *xwm,
+        struct xwm_child_window *child) {
+    xcb_get_property_cookie_t cookie = xcb_get_property(xwm->xcb_conn, 0,
+        child->window_id, xwm->atoms[WINEHUA_GPU_VISIBLE_REGION],
+        XCB_ATOM_CARDINAL, 0, 4 + 4 * 1024);
+    xcb_get_property_reply_t *reply = xcb_get_property_reply(xwm->xcb_conn, cookie, NULL);
+    child->clip_valid = false;
+    pixman_region32_clear(&child->visible_region);
+    if (reply && reply->type == XCB_ATOM_CARDINAL && reply->format == 32 &&
+            !reply->bytes_after && xcb_get_property_value_length(reply) >= 16) {
+        const uint32_t *v = xcb_get_property_value(reply);
+        uint32_t n = v[3];
+        if (v[0] == 1 && v[1] <= 32767 && v[2] <= 32767 && n <= 1024 &&
+                xcb_get_property_value_length(reply) == (int)(16 + n * 16)) {
+            bool valid = true;
+            for (uint32_t i = 0; i < n; i++) {
+                const int32_t *r = (const int32_t *)(v + 4 + i * 4);
+                if (r[0] < -32768 || r[1] < -32768 || r[2] > 32767 ||
+                        r[3] > 32767 || r[2] <= r[0] || r[3] <= r[1]) {
+                    valid = false;
+                    break;
+                }
+                if (!pixman_region32_union_rect(&child->visible_region,
+                        &child->visible_region, r[0], r[1], r[2]-r[0], r[3]-r[1])) {
+                    valid = false;
+                    break;
+                }
+            }
+            child->clip_valid = valid;
+            child->clip_width = v[1];
+            child->clip_height = v[2];
+        }
+    }
+    free(reply);
+}
