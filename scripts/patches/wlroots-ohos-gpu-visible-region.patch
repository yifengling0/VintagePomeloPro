+bool wlr_xwayland_query_child_visible_region(struct wlr_xwayland *xwayland,
+        xcb_window_t id, uint64_t generation, pixman_region32_t *region) {
+    if (!xwayland || !xwayland->xwm) return false;
+    struct wlr_xwm *xwm = xwayland->xwm;
+    struct xwm_child_window *c = xwm_child_window_find(xwm, id);
+    if (!c || c->generation != generation) return false;
+    if (!c->clip_requested) {
+        c->clip_requested = true;
+        uint32_t version = 1;
+        xcb_change_property(xwm->xcb_conn, XCB_PROP_MODE_REPLACE, id,
+            xwm->atoms[WINEHUA_GPU_CLIP_REQUEST], XCB_ATOM_CARDINAL, 32, 1, &version);
+        // Initial read is one ordered round trip at binding, not a frame poll.
+        xwm_child_read_visible_region(xwm, c);
+    }
+    if (!c->mapped || !c->clip_valid || c->clip_width != c->width ||
+            c->clip_height != c->height) return false;
+    pixman_region32_copy(region, &c->visible_region);
+    return true;
+}
