+/* Private host/server contract v1. Coordinates are window-local and the
+ * region is server-validated borderClip, NOT the XFixes ClipShape. Publishing
+ * only on opt-in and clip changes keeps all X round trips off the frame path.
+ * Oversized regions fail closed; no truncated region can expose another app. */
+void
+xwl_window_publish_gpu_visible_region(WindowPtr window)
+{
+    struct xwl_screen *xs = xwl_screen_get(window->drawable.pScreen);
+    PropertyPtr request, previous;
+    BoxPtr boxes;
+    CARD32 *data;
+    int n, i;
+    size_t words;
+
+    if (!xs->gpu_clip_request_prop ||
+        dixLookupProperty(&request, window, xs->gpu_clip_request_prop,
+                          serverClient, DixReadAccess) != Success ||
+        request->type != XA_CARDINAL || request->format != 32 ||
+        request->size != 1 || *(CARD32 *)request->data != 1)
+        return;
+
+    n = window->viewable ? RegionNumRects(&window->borderClip) : 0;
+    if (n > 1024) n = 0;
+    words = 4 + 4 * n;
+    data = calloc(words, sizeof(*data));
+    if (!data) return;
+    data[0] = 1;
+    data[1] = window->drawable.width;
+    data[2] = window->drawable.height;
+    data[3] = n;
+    boxes = RegionRects(&window->borderClip);
+    for (i = 0; i < n; i++) {
+        data[4+4*i] = (INT32)boxes[i].x1 - window->drawable.x;
+        data[5+4*i] = (INT32)boxes[i].y1 - window->drawable.y;
+        data[6+4*i] = (INT32)boxes[i].x2 - window->drawable.x;
+        data[7+4*i] = (INT32)boxes[i].y2 - window->drawable.y;
+    }
+    if (dixLookupProperty(&previous, window, xs->gpu_visible_region_prop,
+                          serverClient, DixReadAccess) != Success ||
+        previous->type != XA_CARDINAL || previous->format != 32 ||
+        previous->size != words || memcmp(previous->data, data, words * 4))
+        dixChangeWindowProperty(serverClient, window, xs->gpu_visible_region_prop,
+                                XA_CARDINAL, 32, PropModeReplace, words, data, TRUE);
+    free(data);
+}
