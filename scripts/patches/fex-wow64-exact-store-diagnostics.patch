+// The freestanding Windows CRT has neither atexit destructors nor fprintf.
+// Emit outside the JIT context lock, using the existing Wine stderr bridge.
+static void ReportExactStoreStats(bool Final) {
+  if (!FEXExactStoreStatsEverEnabled.load(std::memory_order_relaxed)) return;
+  static std::atomic<uint64_t> LastReportNS {};
+  static std::atomic<unsigned> Reports {};
+  static std::atomic<bool> FinalReported {};
+  if (Final) {
+    if (FinalReported.exchange(true, std::memory_order_relaxed)) return;
+  } else {
+    if (Reports.load(std::memory_order_relaxed) >= 600) return;
+    const uint64_t Now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count();
+    auto Last = LastReportNS.load(std::memory_order_relaxed);
+    if (Now < Last || Now - Last < 1'000'000'000 ||
+        !LastReportNS.compare_exchange_strong(Last, Now, std::memory_order_relaxed)) return;
+    Reports.fetch_add(1, std::memory_order_relaxed);
+  }
+  uint64_t Counts[6] {};
+  bool Consistent = false;
+  // Live threads can be between attempt and hit/fallback. Mark such a bounded
+  // snapshot rather than presenting it as a quiescent hit-ratio sample.
+  for (unsigned Retry = 0; Retry < 3 && !Consistent; ++Retry) {
+    for (unsigned I = 0; I < 6; ++I) {
+      Counts[I] = __atomic_load_n(&FEXExactStoreCounters[I], __ATOMIC_RELAXED);
+    }
+    Consistent = Counts[0] == Counts[1] + Counts[2] && Counts[3] == Counts[4] + Counts[5] &&
+      Counts[0] == __atomic_load_n(&FEXExactStoreCounters[0], __ATOMIC_RELAXED) &&
+      Counts[3] == __atomic_load_n(&FEXExactStoreCounters[3], __ATOMIC_RELAXED);
+  }
+  const auto Output = fextl::fmt::format(
+    "FEX_EXACTSTORE_STATS pid={} final={} consistent={} f32 attempt={} hit={} fallback={} f64 attempt={} hit={} fallback={}\n",
+    GetCurrentProcessId(), Final, Consistent, Counts[0], Counts[1], Counts[2], Counts[3], Counts[4], Counts[5]);
+  __wine_dbg_output(Output.c_str());
+}
+#endif
