+static void read_surface_frame_extents(struct wlr_xwayland_surface *surface,
+        xcb_get_property_reply_t *reply) {
+    memset(surface->winehua_frame_extents, 0, sizeof(surface->winehua_frame_extents));
+    if (reply->type != XCB_ATOM_CARDINAL || reply->format != 32 || reply->bytes_after ||
+            xcb_get_property_value_length(reply) != 16) return;
+    const uint32_t *v = xcb_get_property_value(reply);
+    for (unsigned i = 0; i < 4; ++i) if (v[i] > 32767) return;
+    memcpy(surface->winehua_frame_extents, v, sizeof(surface->winehua_frame_extents));
+    wl_signal_emit_mutable(&surface->events.set_geometry, NULL);
+}
