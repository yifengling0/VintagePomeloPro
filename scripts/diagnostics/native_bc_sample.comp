#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2DArray sourceImage;
layout(set=0,binding=1,std430) writeonly buffer Output { vec4 rgba[]; };
layout(push_constant) uniform Parameters { uint width;uint height;uint layer;uint mip; } pc;
void main(){uvec2 p=gl_GlobalInvocationID.xy;if(p.x>=pc.width||p.y>=pc.height)return;
    rgba[p.y*pc.width+p.x]=texelFetch(sourceImage,ivec3(p,pc.layer),int(pc.mip));}
