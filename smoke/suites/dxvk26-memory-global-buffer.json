{
  "name": "dxvk26-memory-global-buffer",
  "title": "Cached buffer object isolation, allocation and wait unchanged",
  "checks": [],
  "tests": [
    {
      "case": "dxvk26-regression",
      "id": "global-buffer-baseline",
      "arch": [
        "x64"
      ],
      "backend": {
        "d3d": "dxvk_modern_2_6"
      },
      "env": {
        "DXVK26_MEMORY_ONLY": "1",
        "DXVK_LOG_LEVEL": "info",
        "DXVK_WINEHUA_TRACE_MAPPED": "1",
        "DXVK_WINEHUA_LEGACY_READBACK_COPY": "0",
        "DXVK_DEBUG": "",
        "DXVK_WINEHUA_READBACK_DEVICE_IDLE": "0",
        "DXVK_WINEHUA_OWN_CACHED_BUFFERS": "0"
      },
      "seconds": 5,
      "timeoutMs": 60000
    },
    {
      "case": "dxvk26-regression",
      "id": "own-cached-buffers",
      "arch": [
        "x64"
      ],
      "backend": {
        "d3d": "dxvk_modern_2_6"
      },
      "env": {
        "DXVK26_MEMORY_ONLY": "1",
        "DXVK_LOG_LEVEL": "info",
        "DXVK_WINEHUA_TRACE_MAPPED": "1",
        "DXVK_WINEHUA_LEGACY_READBACK_COPY": "0",
        "DXVK_DEBUG": "",
        "DXVK_WINEHUA_READBACK_DEVICE_IDLE": "0",
        "DXVK_WINEHUA_OWN_CACHED_BUFFERS": "1"
      },
      "seconds": 5,
      "timeoutMs": 60000
    },
    {
      "case": "dxvk26-regression",
      "id": "global-buffer-after",
      "arch": [
        "x64"
      ],
      "backend": {
        "d3d": "dxvk_modern_2_6"
      },
      "env": {
        "DXVK26_MEMORY_ONLY": "1",
        "DXVK_LOG_LEVEL": "info",
        "DXVK_WINEHUA_TRACE_MAPPED": "1",
        "DXVK_WINEHUA_LEGACY_READBACK_COPY": "0",
        "DXVK_DEBUG": "",
        "DXVK_WINEHUA_READBACK_DEVICE_IDLE": "0",
        "DXVK_WINEHUA_OWN_CACHED_BUFFERS": "0"
      },
      "seconds": 5,
      "timeoutMs": 60000
    }
  ]
}
