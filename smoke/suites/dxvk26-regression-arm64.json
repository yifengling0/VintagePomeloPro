{
  "name": "dxvk26-regression-arm64",
  "title": "Native ARM64 full rendering regression",
  "checks": [],
  "tests": [
    {
      "case": "dxvk26-regression",
      "id": "dxvk26-regression",
      "arch": [
        "x64"
      ],
      "backend": {
