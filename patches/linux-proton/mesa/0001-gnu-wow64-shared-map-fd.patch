+/* Same-process, borrowed-BO alias contract for GNU Wine WoW64. The caller
+ * must externally synchronize memory exactly as for vkMap/UnmapMemory. No
+ * dma-buf/external-memory feature is advertised by this private entry point. */
+__attribute__((visibility("default"))) int
+vn_winehua_mapped_memory_fd(VkDeviceMemory memory, uint64_t *backing_size)
+{
+   if (!backing_size) {
+      errno = EINVAL;
+      return -1;
+   }
+   *backing_size = 0;
+   if (memory == VK_NULL_HANDLE) {
+      errno = EINVAL;
+      return -1;
+   }
+   struct vn_device_memory *mem = vn_device_memory_from_handle(memory);
+   struct vn_device *dev =
+      container_of(mem->base.base.base.device, struct vn_device, base.base);
+   if (!mem->mapped || !mem->base_bo || !mem->base_bo->mmap_ptr ||
+       !dev->renderer->bo_ops.dup_mapped_fd) {
+      errno = ENOTSUP;
+      return -1;
+   }
+   const int fd = dev->renderer->bo_ops.dup_mapped_fd(dev->renderer, mem->base_bo);
+   if (fd >= 0)
+      *backing_size = mem->base.base.size;
+   return fd;
+}
