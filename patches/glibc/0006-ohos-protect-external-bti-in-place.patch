--- /dev/null
+++ b/elf/dl-ohos-native-memory.h
@@ -0,0 +1,37 @@
+/* Shared OHOS external mapping mode for ELF segments and AArch64 BTI. */
+#ifndef _DL_OHOS_NATIVE_MEMORY_H
+#define _DL_OHOS_NATIVE_MEMORY_H 1
+#include <stdbool.h>
+#include <string.h>
+#include <ldsodefs.h>
+
+/* Explicit opt-in for a caller-verified, versioned external GNU runtime.
+   Never alter the normal signed file mapping path or privileged execution. */
+static __always_inline bool
+_dl_ohos_external_memory (const char *name)
+{
+  extern char **_environ attribute_hidden;
+  const char *root = NULL;
+  bool enabled = false;
+  if (name == NULL) name = "";
+  for (char **entry = _environ; entry != NULL && *entry != NULL; ++entry)
+    {
+      const char flag[] = "STEAMOHOS_NATIVE_MEMORY=1";
+      const char prefix[] = "STEAMOHOS_EXTERNAL_RUNTIME=";
+      if (strcmp (*entry, flag) == 0)
+        enabled = true;
+      if (strncmp (*entry, prefix, sizeof (prefix) - 1) == 0)
+        root = *entry + sizeof (prefix) - 1;
+    }
+  static unsigned diagnostic_messages;
+  if (root != NULL && diagnostic_messages++ < 2)
+    _dl_debug_printf ("STEAMOHOS_NATIVE_MAP enabled=%d secure=%d image=%s\n", enabled, __libc_enable_secure, name);
+  if (__libc_enable_secure || name[0] != '/') return false;
+  if (!enabled || root == NULL || root[0] != '/' || root[1] == '\0'
+      || strstr (root, "/../") != NULL || strstr (name, "/../") != NULL)
+    return false;
+  const size_t length = strlen (root);
+  return strncmp (name, root, length) == 0 && name[length] == '/';
+}
+
+#endif
