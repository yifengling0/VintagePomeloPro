+                        (flags & ~MAP_FILE) | MAP_ANONYMOUS, -1, 0);
+  if (memory == MAP_FAILED)
+    { _dl_debug_printf ("STEAMOHOS_NATIVE_MAP map_error=%d\n", errno); return memory; }
