@@ -25,3 +25,18 @@
 }
 libc_hidden_def (__pthread_self)
 weak_alias (__pthread_self, pthread_self)
+
+/* GNU-native app sandbox: query only this thread's real registered list.
+   Do not inspect another process/thread or fabricate an empty list. */
+int
+__steamohos_get_robust_list (pid_t tid, void **head, size_t *length)
+{
+  struct pthread *self = THREAD_SELF;
+  if (tid != 0 && tid != self->tid)
+    { __set_errno (EPERM); return -1; }
+  if (head == NULL || length == NULL)
+    { __set_errno (EFAULT); return -1; }
+  *head = &self->robust_head;
+  *length = sizeof (self->robust_head);
+  return 0;
+}
