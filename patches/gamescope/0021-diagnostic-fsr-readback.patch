--- a/src/rendervulkan.cpp
+++ b/src/rendervulkan.cpp
@@ -2277,7 +2277,7 @@
 
 	if ( flags.bSampled == true )
 	{
-		usage |= VK_IMAGE_USAGE_SAMPLED_BIT;
+		usage |= VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT; // diagnostic readback
 	}
 
 	if ( flags.bStorage == true )
@@ -4868,6 +4868,44 @@
 	}
 
 	uint64_t sequence = g_device.submit(std::move(cmdBuffer));
+
+#if HAVE_OHOS_BACKEND
+    static unsigned fsrDiagnostics = 0;
+    if (frameInfo->useFSRLayer0 && ++fsrDiagnostics == 120) {
+        g_device.wait(sequence, false);
+        const gamescope::Rc<CVulkanTexture> sources[] = {frameInfo->layers.get(0).tex, g_output.tmpOutput, compositeImage};
+        const char* names[] = {"input", "easu", "output"};
+        for (unsigned n = 0; n < 3; ++n) {
+            auto src = sources[n];
+            gamescope::OwningRc<CVulkanTexture> readback = new CVulkanTexture();
+            CVulkanTexture::createFlags flags;
+            flags.bMappable = flags.bTransferDst = true;
+            if (!readback->BInit(src->width(), src->height(), 1, src->drmFormat(), flags)) continue;
+            auto copy = g_device.commandBuffer();
+            copy->copyImage(src, readback.get());
+            const auto copied = g_device.submit(std::move(copy));
+            g_device.wait(copied, false);
+            char path[160];
+            snprintf(path, sizeof(path), "/data/storage/el2/base/cache/gs-fsr-%s.ppm", names[n]);
+            if (FILE* f = fopen(path, "wb")) {
+                fprintf(f, "P6\n%u %u\n255\n", src->width(), src->height());
+                const bool bgr = src->format() == VK_FORMAT_B8G8R8A8_UNORM;
+                for (uint32_t y = 0; y < src->height(); ++y) {
+                    auto row = readback->mappedData() + size_t(y) * readback->rowPitch();
+                    for (uint32_t x = 0; x < src->width(); ++x) {
+                        const unsigned char rgb[] = {row[x*4+(bgr?2:0)], row[x*4+1], row[x*4+(bgr?0:2)]};
+                        fwrite(rgb, 1, 3, f);
+                    }
+                }
+                fclose(f);
+            }
+        }
+        EasuPushData_t constants(&frameInfo->layers.get(0), sources[0]->width(), sources[0]->height(), sources[1]->width(), sources[1]->height());
+        if (FILE* f = fopen("/data/storage/el2/base/cache/gs-fsr-constants.bin", "wb")) {
+            fwrite(&constants, 1, sizeof(constants), f); fclose(f);
+        }
+    }
+#endif
 	if ( oTimingSlot )
 		g_CompositeTiming.pending.back().ulSeqNo = sequence;
 
