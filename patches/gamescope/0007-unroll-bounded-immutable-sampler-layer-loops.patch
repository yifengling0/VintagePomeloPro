--- a/src/shaders/cs_gaussian_blur_horizontal.comp
+++ b/src/shaders/cs_gaussian_blur_horizontal.comp
@@ -1,5 +1,6 @@
 #version 460
 
+#extension GL_EXT_control_flow_attributes : require
 #extension GL_GOOGLE_include_directive : require
 #extension GL_EXT_scalar_block_layout : require
 
@@ -47,16 +48,28 @@
             outputValue = gaussian_blur(s_samplers[0], 0, pos, u_blur_radius, false, true).rgb * u_opacity[0];
     }
 
-    for (int i = 1; i < c_layerCount; i++) {
-        vec4 layerColor;
-        // YCBCR technically has incorrect blending here but... meh.
-        if ((c_ycbcrMask & (1 << i)) != 0)
-            layerColor = gaussian_blur(s_ycbcr_samplers[i], i, pos, u_blur_radius, false, false);
-        else
-            layerColor = gaussian_blur(s_samplers[i], i, pos, u_blur_radius, false, true);
-
-        outputValue = BlendLayer( i, outputValue, layerColor, u_opacity[i] );
+    // Nested radius loops prevent generic loop unrolling. Expand the fixed
+    // layer indices here so converted samplers remain literal in SPIR-V.
+    const int hsl_layer_limit[(VKR_MAX_LAYERS == 8u) ? 1 : -1] = int[1](0);
+#define COMPOSITE_LAYER(i) \
+    if (i < c_layerCount) { \
+        vec4 layerColor; \
+        /* YCBCR technically has incorrect blending here but... meh. */ \
+        if ((c_ycbcrMask & (1 << i)) != 0) \
+            layerColor = gaussian_blur(s_ycbcr_samplers[i], i, pos, u_blur_radius, false, false); \
+        else \
+            layerColor = gaussian_blur(s_samplers[i], i, pos, u_blur_radius, false, true); \
+ \
+        outputValue = BlendLayer( i, outputValue, layerColor, u_opacity[i] ); \
     }
+    COMPOSITE_LAYER(1)
+    COMPOSITE_LAYER(2)
+    COMPOSITE_LAYER(3)
+    COMPOSITE_LAYER(4)
+    COMPOSITE_LAYER(5)
+    COMPOSITE_LAYER(6)
+    COMPOSITE_LAYER(7)
+#undef COMPOSITE_LAYER
 
     uint colorspace = get_layer_colorspace(0);
     outputValue = colorspace_plane_regamma_tf(outputValue, colorspace);
