+bool CVulkanDevice::createDescriptorFallbacks()
+{
+	m_descriptorFallback = std::make_unique<hsl::VulkanDescriptorFallback>();
+	VkResult result = m_descriptorFallback->init(physDev(), device(), vk.GetDeviceProcAddr,
+		vk.GetPhysicalDeviceImageFormatProperties2, m_memoryProperties, m_ycbcrConversion);
+	if ( result != VK_SUCCESS )
+	{
+		vk_errorf(result, "typed descriptor fallback initialization failed");
+		return false;
+	}
+	auto [data, offset] = uploadBufferData(hsl::VulkanDescriptorFallback::UploadBytes);
+	memcpy(data, hsl::VulkanDescriptorFallback::Upload.data(), hsl::VulkanDescriptorFallback::UploadBytes);
+	auto command = commandBuffer();
+	if (!command)
+		return false;
+	m_descriptorFallback->record(command->rawBuffer(), uploadBuffer(), offset);
+	// One initialization submission. No per-frame queue/device idle or upload.
+	wait(submit(std::move(command)));
+	vk_log.infof("using real typed descriptor fallback resources");
 	return true;
 }
 
