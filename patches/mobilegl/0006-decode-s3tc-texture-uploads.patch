+TEST_F(TextureTest, S3tcSubImagesPreserveAlphaAndClipTheLastBlock) {
+    constexpr Uint8 bc1[] = {0, 0, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff};
+    constexpr Uint8 bc2[] = {0x88, 0x88, 0x88, 0x88, 0x88, 0x88, 0x88, 0x88, 0, 0xf8, 0, 0, 0, 0, 0, 0};
+    constexpr Uint8 bc3[] = {96, 0, 0, 0, 0, 0, 0, 0, 0, 0xf8, 0, 0, 0, 0, 0, 0};
+    struct Sample {
+        GLenum format;
+        const Uint8* block;
+        GLsizei size;
+        Uint8 red, alpha;
+    };
+    const Sample samples[] = {
+        {GL_COMPRESSED_RGB_S3TC_DXT1_EXT, bc1, sizeof(bc1), 0, 255},
+        {GL_COMPRESSED_RGBA_S3TC_DXT1_EXT, bc1, sizeof(bc1), 0, 0},
+        {GL_COMPRESSED_RGBA_S3TC_DXT3_EXT, bc2, sizeof(bc2), 255, 136},
+        {GL_COMPRESSED_RGBA_S3TC_DXT5_EXT, bc3, sizeof(bc3), 255, 96},
+        {GL_COMPRESSED_SRGB_S3TC_DXT1_EXT, bc1, sizeof(bc1), 0, 255},
+        {GL_COMPRESSED_SRGB_ALPHA_S3TC_DXT1_EXT, bc1, sizeof(bc1), 0, 0},
+        {GL_COMPRESSED_SRGB_ALPHA_S3TC_DXT3_EXT, bc2, sizeof(bc2), 255, 136},
+        {GL_COMPRESSED_SRGB_ALPHA_S3TC_DXT5_EXT, bc3, sizeof(bc3), 255, 96},
+    };
+    for (const auto& sample : samples) {
+        SCOPED_TRACE(sample.format);
+        GLuint texture = 0;
+        MG_Impl::GLImpl::GenTextures(1, &texture);
+        MG_Impl::GLImpl::BindTexture(GL_TEXTURE_2D, texture);
+        MG_Impl::GLImpl::TexStorage2D(GL_TEXTURE_2D, 1, sample.format, 5, 3);
+        MG_Impl::GLImpl::CompressedTexSubImage2D(GL_TEXTURE_2D, 0, 4, 0, 1, 3, sample.format, sample.size, sample.block);
+        ASSERT_EQ(MG_Impl::GLImpl::GetError(), GL_NO_ERROR);
+        const auto& object = MG_State::pGLContext->GetTextureObject(texture);
+        auto* mip = MG_State::GLState::AsMipmapTexture(object.get());
+        const auto* data = static_cast<const Uint8*>(mip->MapMipmapData(TextureUploadTarget::Texture2D, 0));
+        ASSERT_NE(data, nullptr);
+        bool rgb = sample.format == GL_COMPRESSED_RGB_S3TC_DXT1_EXT || sample.format == GL_COMPRESSED_SRGB_S3TC_DXT1_EXT;
+        const Uint8* edge = data + (2 * 5 + 4) * (rgb ? 3 : 4);
+        EXPECT_EQ(edge[0], sample.red);
+        EXPECT_EQ(edge[1], 0);
+        EXPECT_EQ(edge[2], 0);
+        if (!rgb) EXPECT_EQ(edge[3], sample.alpha);
+        Uint8 encoded[32]{};
+        MG_Impl::GLImpl::GetCompressedTexImage(GL_TEXTURE_2D, 0, encoded);
+        EXPECT_EQ(std::memcmp(encoded + sample.size, sample.block, sample.size), 0);
+        MG_Impl::GLImpl::DeleteTextures(1, &texture);
+    }
+}
