+    MG_Impl::GLImpl::CompressedTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 4, 3, format, sizeof(replacement), replacement);
+    ASSERT_EQ(MG_Impl::GLImpl::GetError(), GL_NO_ERROR);
+
+    const auto& textureObject = MG_State::pGLContext->GetTextureObject(texture);
+    auto* mipmap = MG_State::GLState::AsMipmapTexture(textureObject.get());
+    ASSERT_NE(mipmap, nullptr);
+    const auto* rgba = static_cast<const Uint8*>(mipmap->MapMipmapData(TextureUploadTarget::Texture2D, 0));
+    ASSERT_NE(rgba, nullptr);
+    constexpr Uint8 originalColor[] = {64, 128, 192, 160};
+    constexpr Uint8 updatedColor[] = {192, 32, 16, 224};
+    for (Int y = 0; y < 3; ++y) {
+        const Uint8* row = rgba + y * 5 * 4;
+        EXPECT_EQ(std::memcmp(row + 3 * 4, updatedColor, sizeof(updatedColor)), 0);
+        EXPECT_EQ(std::memcmp(row + 4 * 4, originalColor, sizeof(originalColor)), 0);
+    }
+    MG_Impl::GLImpl::DeleteTextures(1, &texture);
+}
