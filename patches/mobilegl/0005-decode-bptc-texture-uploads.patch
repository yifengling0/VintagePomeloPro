+TEST_F(TextureTest, CompressedBptcSubImagePreservesTheUnchangedEdgeBlock) {
+    // BC7 mode 6 with equal endpoints and zero indices in each block.
+    constexpr Uint8 blocks[32] = {
+        0x40, 0x10, 0x08, 0x08, 0x04, 0x83, 0xa1, 0x50, 0, 0, 0, 0, 0, 0, 0, 0,
+        0x40, 0x10, 0x08, 0x08, 0x04, 0x83, 0xa1, 0x50, 0, 0, 0, 0, 0, 0, 0, 0,
+    };
+    constexpr Uint8 replacement[16] = {0x40, 0x30, 0x18, 0x02, 0x41, 0x20, 0xe0, 0x70};
