diff --git a/MobileGL/MG_Backend/DirectVulkan/Renderer/VenusShadowMemory.h b/MobileGL/MG_Backend/DirectVulkan/Renderer/VenusShadowMemory.h
new file mode 100644
--- /dev/null
+++ b/MobileGL/MG_Backend/DirectVulkan/Renderer/VenusShadowMemory.h
@@ -0,0 +1,48 @@
+// MobileGL - MobileGL/MG_Backend/DirectVulkan/Renderer/VenusShadowMemory.h
+// Copyright (c) 2025-2026 MobileGL-Dev
+// SPDX-License-Identifier: LGPL-3.0-only
+
+#pragma once
+
+#include <algorithm>
+#include <cstdlib>
+#include <vk_mem_alloc.h>
+
+namespace MobileGL::MG_Backend::DirectVulkan {
+    inline bool UsesVenusShadowMemory() {
+        static const bool enabled = [] {
+            const char* value = std::getenv("MOBILEGL_WINEHUA_VENUS_SHADOW");
+            return value && value[0] == '1' && value[1] == '\0';
+        }();
+        return enabled;
+    }
+
+    inline VkResult SyncVenusShadowMemory(VmaAllocator allocator, VmaAllocation allocation,
+                                         VkDeviceSize offset, VkDeviceSize size, bool read) {
+        if (!size) return VK_SUCCESS;
+        if (!UsesVenusShadowMemory()) {
+            if (read) return vmaInvalidateAllocation(allocator, allocation, offset, size);
+            return vmaFlushAllocation(allocator, allocation, offset, size);
+        }
+
+        // A shadow-backed coherent map still needs a host transfer. VMA maps the entire
+        // VkDeviceMemory block, so keep the range within that block and align it to its atom.
+        VmaAllocatorInfo allocatorInfo{};
+        VmaAllocationInfo2 memory{};
+        const VkPhysicalDeviceProperties* properties = nullptr;
+        vmaGetAllocatorInfo(allocator, &allocatorInfo);
+        vmaGetAllocationInfo2(allocator, allocation, &memory);
+        vmaGetPhysicalDeviceProperties(allocator, &properties);
+        const VkDeviceSize atom = properties->limits.nonCoherentAtomSize;
+        const VkDeviceSize start = memory.allocationInfo.offset + offset;
+        const VkDeviceSize begin = start - start % atom;
+        const VkDeviceSize end = start + size;
+        const VkDeviceSize alignedEnd = std::min(memory.blockSize, ((end + atom - 1) / atom) * atom);
+        VkMappedMemoryRange range{VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE};
+        range.memory = memory.allocationInfo.deviceMemory;
+        range.offset = begin;
+        range.size = alignedEnd - begin;
+        if (read) return vkInvalidateMappedMemoryRanges(allocatorInfo.device, 1, &range);
+        return vkFlushMappedMemoryRanges(allocatorInfo.device, 1, &range);
+    }
+}
