+  bool DxvkContext::tryCopyPackedBcImage(
+      const Rc<DxvkImage>& dst, VkImageSubresourceLayers dstLayers, VkOffset3D dstOffset, VkExtent3D extent,
+      const Rc<DxvkImage>& src, VkImageSubresourceLayers srcLayers, VkOffset3D srcOffset, VkExtent3D blocks,
+      VkFormat format) {
+    static const bool gpuEnabled = env::getEnvVar("DXVK_WINEHUA_PACKED_BC_GPU") != "0";
+    const bool bc1 = format == VK_FORMAT_BC1_RGBA_UNORM_BLOCK || format == VK_FORMAT_BC1_RGBA_SRGB_BLOCK;
+    const bool bc5 = format == VK_FORMAT_BC5_UNORM_BLOCK || format == VK_FORMAT_BC5_SNORM_BLOCK;
+    const VkFormat backing = dst->info().format;
+    const bool rgba = backing == VK_FORMAT_R8G8B8A8_UNORM || backing == VK_FORMAT_R8G8B8A8_SRGB;
+    const VkFormat rg = format == VK_FORMAT_BC5_SNORM_BLOCK ? VK_FORMAT_R8G8_SNORM : VK_FORMAT_R8G8_UNORM;
+    if (!gpuEnabled || !((bc1 && rgba) || (bc5 && backing == rg))
+     || dst->info().type != VK_IMAGE_TYPE_2D || src->info().type != VK_IMAGE_TYPE_2D
+     || extent.depth != 1 || extent.width > 4096 || extent.height > 4096
+     || blocks.width != (extent.width + 3) / 4 || blocks.height != (extent.height + 3) / 4)
+      return false;
+
+    const uint32_t pixelBytes = bc1 ? 4 : 2;
+    const uint32_t width = 4 * blocks.width;
+    const uint32_t height = 4 * blocks.height;
+    const VkDeviceSize inputSize = VkDeviceSize(blocks.width) * blocks.height * (bc1 ? 8 : 16);
+    const VkDeviceSize outputSize = VkDeviceSize(width) * height * pixelBytes;
+    DxvkMetaCopyPipeline pipeline = {};
+    VkDescriptorSet set = VK_NULL_HANDLE;
+    try {
+      pipeline = m_common->metaCopy().getPackedBcPipeline(bc5);
+      if (!pipeline.pipeHandle)
+        return false;
+      auto reserve = [this](Rc<DxvkBuffer>& buffer, VkDeviceSize bytes) {
+        if (buffer != nullptr && buffer->info().size >= bytes)
+          return;
+        DxvkBufferCreateInfo info = {};
+        info.size = align(bytes, VkDeviceSize(4096));
+        info.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT;
+        info.stages = VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT;
+        info.access = VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+        buffer = m_device->createBuffer(info, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+      };
+      reserve(m_packedBcInput, inputSize);
+      reserve(m_packedBcOutput, outputSize);
+      set = m_descriptorPool->alloc(pipeline.dsetLayout);
+    } catch (const DxvkError&) {
+      return false;
+    }
+    if (!set)
+      return false;
+
+    // Order reuse of the scratch buffers across consecutive copies, including
+    // copies that span command-list submissions on the graphics queue.
+    spillRenderPass(true);
+    unbindComputePipeline();
+    flushBarriers();
+    emitMemoryBarrier(VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_SHADER_READ_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+    copyImageToBuffer(m_packedBcInput, 0, 0, 0, VK_FORMAT_UNDEFINED, src, srcLayers, srcOffset, blocks);
+    flushBarriers();
+    emitMemoryBarrier(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT);
+
+    const VkDescriptorBufferInfo buffers[] = {
+      m_packedBcInput->getDescriptor(0, inputSize).buffer,
+      m_packedBcOutput->getDescriptor(0, outputSize).buffer,
+    };
+    VkWriteDescriptorSet writes[2] = {};
+    for (uint32_t i = 0; i < 2; ++i) {
+      writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+      writes[i].dstSet = set;
+      writes[i].dstBinding = i;
+      writes[i].descriptorCount = 1;
+      writes[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+      writes[i].pBufferInfo = &buffers[i];
+    }
+    m_cmd->updateDescriptorSets(2, writes);
+    const uint32_t args[] = { width, height, bc5 ? (format == VK_FORMAT_BC5_SNORM_BLOCK ? 6u : 2u) : 0u };
+    m_cmd->cmdBindPipeline(DxvkCmdBuffer::ExecBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline.pipeHandle);
+    m_cmd->cmdBindDescriptorSet(DxvkCmdBuffer::ExecBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline.pipeLayout, set, 0, nullptr);
+    m_cmd->cmdPushConstants(DxvkCmdBuffer::ExecBuffer, pipeline.pipeLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(args), args);
+    m_cmd->cmdDispatch(DxvkCmdBuffer::ExecBuffer, (width + 31) / 32, (height + 31) / 32, 1);
+
+    emitMemoryBarrier(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+    m_cmd->track(m_packedBcOutput, DxvkAccess::Write);
+    copyBufferToImage(dst, dstLayers, dstOffset, extent, m_packedBcOutput, 0, 4 * pixelBytes, 1 , VK_FORMAT_UNDEFINED);
+
+    static const bool logged = [] {
+      Logger::info("WineHua: GPU decode active for packed BC image copies");
+      return true;
+    }();
+    (void)logged;
+    return true;
+  }
