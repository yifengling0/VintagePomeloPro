diff --git a/src/dxvk/shaders/dxvk_packed_bc1.comp b/src/dxvk/shaders/dxvk_packed_bc1.comp
new file mode 100644
--- /dev/null
+++ b/src/dxvk/shaders/dxvk_packed_bc1.comp
@@ -0,0 +1,83 @@
+#version 450
+#define BC3 0
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 0, std430) readonly buffer Blocks { uint words[]; };
+#if BC3
+layout(set = 0, binding = 1, std430) writeonly buffer Pixels { uint pixels[]; };
+#else
+layout(set = 0, binding = 1, std430) writeonly buffer Pixels { uvec4 rows[]; };
+#endif
+layout(push_constant) uniform Params { uint width; uint height; uint mode; };
+
+uvec3 unpack565(uint v) {
+    return uvec3((v >> 11) & 31u, (v >> 5) & 63u, v & 31u);
+}
+
+uint packColor(uvec3 c) {
+    return c.r | (c.g << 8) | (c.b << 16);
+}
+
+void main() {
+    const uint bc3 = BC3;
+    uvec2 block = gl_GlobalInvocationID.xy;
+    uint cols = width / 4u;
+    if (block.x >= cols || block.y >= height / 4u)
+        return;
+    uint src = (block.y * cols + block.x) * (2u + 2u * bc3);
+    uint colorWord = words[src + 2u * bc3];
+    uint colorIndices = words[src + 2u * bc3 + 1u];
+    uint e0 = colorWord & 65535u;
+    uint e1 = colorWord >> 16;
+    uvec3 c0 = unpack565(e0);
+    uvec3 c1 = unpack565(e1);
+    // Match the integer rounding of the vendored bcdec reference.
+    uvec3 first = (c0 * uvec3(527, 259, 527) + uvec3(23, 33, 23)) >> 6;
+    uvec3 second = (c1 * uvec3(527, 259, 527) + uvec3(23, 33, 23)) >> 6;
+    uint p0 = packColor(first) | 0xff000000u;
+    uint p1 = packColor(second) | 0xff000000u;
+    uint p2, p3;
+    if (e0 > e1 || bc3 != 0u) {
+        p2 = packColor((2u * first + second + 1u) / 3u) | 0xff000000u;
+        p3 = packColor((first + 2u * second + 1u) / 3u) | 0xff000000u;
+    } else {
+        p2 = packColor((first + second + 1u) >> 1) | 0xff000000u;
+        p3 = 0u;
+    }
+    uvec4 palette = uvec4(p0, p1, p2, p3);
+    uint alpha0 = 0u, alpha1 = 0u;
+    uint alphaLo = 0u, alphaHi = 0u;
+#if !BC3
+    uvec4 row;
+#endif
+    if (bc3 != 0u) {
+        uint lo = words[src], hi = words[src + 1u];
+        alpha0 = lo & 255u;
+        alpha1 = (lo >> 8) & 255u;
+        alphaLo = (lo >> 16) | (hi << 16);
+        alphaHi = hi >> 16;
+    }
+    for (uint i = 0; i < 16; ++i) {
+        uint value = palette[colorIndices & 3u];
+        colorIndices >>= 2;
+        if (bc3 != 0u) {
+            uint k = alphaLo & 7u;
+            alphaLo = (alphaLo >> 3) | (alphaHi << 29);
+            alphaHi >>= 3;
+            uint a;
+            if (mode == 2u) a = ((words[src + i / 8u] >> (4u * (i & 7u))) & 15u) * 17u;
+            else if (k < 2u) a = k == 0u ? alpha0 : alpha1;
+            else if (alpha0 > alpha1) a = ((8u-k)*alpha0 + (k-1u)*alpha1 + 1u) / 7u;
+            else if (k < 6u) a = ((6u-k)*alpha0 + (k-1u)*alpha1 + 1u) / 5u;
+            else a = k == 6u ? 0u : 255u;
+            value = (value & 0x00ffffffu) | (a << 24);
+        }
+        uvec2 pos = block * 4u + uvec2(i & 3u, i >> 2);
+#if BC3
+        pixels[pos.y * width + pos.x] = value;
+#else
+        row[i & 3u] = value;
+        if ((i & 3u) == 3u)
+            rows[pos.y * cols + block.x] = row;
+#endif
+    }
+}
diff --git a/src/dxvk/shaders/dxvk_packed_bc5.comp b/src/dxvk/shaders/dxvk_packed_bc5.comp
new file mode 100644
--- /dev/null
+++ b/src/dxvk/shaders/dxvk_packed_bc5.comp
@@ -0,0 +1,61 @@
+#version 450
+
+// Each invocation owns one 4x4 block. Four R8 or two RG8 texels
+// share each output word, so adjacent blocks never race on a store.
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 0, std430) readonly buffer Blocks { uint words[]; };
+layout(set = 0, binding = 1, std430) writeonly buffer Output { uint pixels[]; };
+layout(push_constant) uniform Params { uint width; uint height; uint mode; };
+
+uvec4 channelRows(uint offset, bool snorm) {
+    uint lo = words[offset], hi = words[offset + 1u];
+    int a = int(lo & 255u), b = int((lo >> 8) & 255u);
+    if (snorm) {
+        a = max(bitfieldExtract(int(lo), 0, 8), -127);
+        b = max(bitfieldExtract(int(lo), 8, 8), -127);
+    }
+    int bias = snorm ? 0 : 1; // Vendored Wine bcdec uses +1 for UNORM.
+    uint indices = (lo >> 16) | (hi << 16);
+    uint remaining = hi >> 16;
+    uvec4 rows = uvec4(0u);
+    for (uint y = 0u; y < 4u; ++y) {
+        uint packed = 0u;
+        for (uint x = 0u; x < 4u; ++x) {
+            int k = int(indices & 7u);
+            indices = (indices >> 3) | (remaining << 29);
+            remaining >>= 3;
+            int value;
+            if (k < 2) value = k == 0 ? a : b;
+            else if (a > b) value = ((8-k)*a + (k-1)*b + bias) / 7;
+            else if (k < 6) value = ((6-k)*a + (k-1)*b + bias) / 5;
+            else value = k == 6 ? (snorm ? -127 : 0) : (snorm ? 127 : 255);
+            packed |= (uint(value) & 255u) << (8u * x);
+        }
+        rows[y] = packed;
+    }
+    return rows;
+}
+
+void main() {
+    uvec2 block = gl_GlobalInvocationID.xy;
+    uint cols = width / 4u;
+    if (block.x >= cols || block.y >= height / 4u) return;
+    uint channels = mode & 3u;
+    bool snorm = (mode & 4u) != 0u;
+    uint src = (block.y * cols + block.x) * (2u * channels);
+    uvec4 red = channelRows(src, snorm);
+    uvec4 green;
+    if (channels == 2u) green = channelRows(src + 2u, snorm);
+    for (uint y = 0u; y < 4u; ++y) {
+        uint dst = ((4u * block.y + y) * cols + block.x) * channels;
+        if (channels == 1u) {
+            pixels[dst] = red[y];
+        } else {
+            uint r = red[y], g = green[y];
+            pixels[dst] = (r & 255u) | ((g & 255u) << 8) |
+                          ((r & 0xff00u) << 8) | ((g & 0xff00u) << 16);
+            pixels[dst + 1u] = ((r >> 16) & 255u) | ((g >> 8) & 0xff00u) |
+                               ((r >> 8) & 0xff0000u) | (g & 0xff000000u);
+        }
+    }
+}
