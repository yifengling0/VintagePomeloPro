+bool
+st_pbo_upload_s3tc(struct st_context *st, const uint8_t *data, unsigned stride,
+                   unsigned kind, struct pipe_resource *dst, unsigned level,
+                   const struct pipe_box *box)
+{
+   const enum pipe_format input = kind < 2 ? PIPE_FORMAT_R32G32_UINT : PIPE_FORMAT_R32G32B32A32_UINT;
+   const unsigned cols = DIV_ROUND_UP(box->width, 4);
+   const unsigned rows = DIV_ROUND_UP(box->height, 4);
+   const unsigned block_bytes = kind < 2 ? 8 : 16;
+   const unsigned row_bytes = cols * block_bytes;
+   struct pipe_screen *screen = st->screen;
+   struct pipe_context *pipe = st->pipe;
+   if (!st->pbo.upload_enabled || stride < row_bytes ||
+       cols * rows > st->ctx->Const.MaxTextureBufferSize ||
+       !screen->is_format_supported(screen, input, PIPE_BUFFER, 0, 0, PIPE_BIND_SAMPLER_VIEW) ||
+       !screen->is_format_supported(screen, PIPE_FORMAT_R8G8B8A8_UNORM, PIPE_TEXTURE_2D,
+                                    0, 0, PIPE_BIND_RENDER_TARGET))
+      return false;
+
+   void *fs = st_pbo_get_s3tc_fs(st, kind);
+   if (!fs)
+      return false;
+
+   struct pipe_resource *blocks = pipe_buffer_create(screen, PIPE_BIND_SAMPLER_VIEW,
+                                                     PIPE_USAGE_STREAM, row_bytes * rows);
+   if (!blocks)
+      return false;
+
+   struct pipe_transfer *transfer = NULL;
+   uint8_t *map = pipe_buffer_map(pipe, blocks, PIPE_MAP_WRITE, &transfer);
+   if (!map) {
+      pipe_resource_reference(&blocks, NULL);
+      return false;
+   }
+   for (unsigned row = 0; row < rows; row++)
+      memcpy(map + row * row_bytes, data + (size_t)row * stride, row_bytes);
+   pipe_buffer_unmap(pipe, transfer);
+
+   /* A linear temporary also preserves the encoded bytes of sRGB uploads
+    * and works when the destination has no render-target binding. */
+   struct pipe_resource *rgba = st_texture_create(st, PIPE_TEXTURE_2D,
+      PIPE_FORMAT_R8G8B8A8_UNORM, 0, box->width, box->height, 1, 1, 0,
+      PIPE_BIND_RENDER_TARGET, false, PIPE_COMPRESSION_FIXED_RATE_NONE);
+   const struct pipe_surface templ = { .format = PIPE_FORMAT_R8G8B8A8_UNORM };
+   struct pipe_surface *surface = rgba ? pipe->create_surface(pipe, rgba, &templ) : NULL;
+   struct st_pbo_addresses addr = {
+      .width = box->width, .height = box->height, .depth = 1,
+      .buffer = blocks, .last_element = cols * rows - 1, .bytes_per_pixel = block_bytes,
+      .constants.stride = cols,
+   };
+   bool success = surface && try_pbo_upload_common(st->ctx, surface, &addr, input, fs);
+   if (success) {
+      struct pipe_box src;
+      u_box_origin_2d(box->width, box->height, &src);
+      pipe->resource_copy_region(pipe, dst, level, box->x, box->y, box->z, rgba, 0, &src);
+   }
+   pipe_surface_reference(&surface, NULL);
+   pipe_resource_reference(&rgba, NULL);
+   pipe_resource_reference(&blocks, NULL);
+   return success;
+}
