diff --git a/src/dxvk/dxvk_meta_bc.h b/src/dxvk/dxvk_meta_bc.h
new file mode 100644
--- /dev/null
+++ b/src/dxvk/dxvk_meta_bc.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include <array>
+#include <mutex>
+#include "dxvk_include.h"
+#include "../spirv/spirv_code_buffer.h"
+
+namespace dxvk {
+
+  class DxvkDevice;
+
+  class DxvkMetaBc {
+  public:
+    explicit DxvkMetaBc(const DxvkDevice* device);
+    ~DxvkMetaBc();
+
+    VkDescriptorSetLayout descriptorLayout = VK_NULL_HANDLE;
+    VkPipelineLayout pipelineLayout = VK_NULL_HANDLE;
+    VkPipeline getBptcPipeline(bool hdr);
+    VkPipeline bc1 = VK_NULL_HANDLE;
+    VkPipeline rgtc = VK_NULL_HANDLE;
+    VkPipeline bc3 = VK_NULL_HANDLE;
+
+  private:
+    std::mutex m_bptcMutex;
+    std::array<VkPipeline, 2> m_bptcPipelines = { };
+    std::array<bool, 2> m_bptcAttempted = { };
+    Rc<vk::DeviceFn> m_vkd;
+    VkPipeline createPipeline(const SpirvCodeBuffer& code) const;
+  };
+
+}
diff --git a/src/dxvk/dxvk_meta_bc.cpp b/src/dxvk/dxvk_meta_bc.cpp
new file mode 100644
--- /dev/null
+++ b/src/dxvk/dxvk_meta_bc.cpp
@@ -0,0 +1,83 @@
+#include "dxvk_meta_bc.h"
+#include "dxvk_device.h"
+
+#include <dxvk_decode_bc1.h>
+#include <dxvk_decode_bc3.h>
+#include <dxvk_decode_bc6.h>
+#include <dxvk_decode_bc7.h>
+#include <dxvk_decode_rgtc.h>
+
+namespace dxvk {
+
+  DxvkMetaBc::DxvkMetaBc(const DxvkDevice* device)
+  : m_vkd(device->vkd()) {
+    const VkDescriptorSetLayoutBinding bindings[] = {
+      { 0, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr },
+      { 1, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr },
+    };
+    VkDescriptorSetLayoutCreateInfo setInfo = { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO };
+    setInfo.bindingCount = 2;
+    setInfo.pBindings = bindings;
+    if (m_vkd->vkCreateDescriptorSetLayout(m_vkd->device(), &setInfo, nullptr, &descriptorLayout) != VK_SUCCESS)
+      return;
+
+    VkPushConstantRange constants = { VK_SHADER_STAGE_COMPUTE_BIT, 0, 3 * sizeof(uint32_t) };
+    VkPipelineLayoutCreateInfo layout = { VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO };
+    layout.setLayoutCount = 1;
+    layout.pSetLayouts = &descriptorLayout;
+    layout.pushConstantRangeCount = 1;
+    layout.pPushConstantRanges = &constants;
+    if (m_vkd->vkCreatePipelineLayout(m_vkd->device(), &layout, nullptr, &pipelineLayout) != VK_SUCCESS)
+      return;
+
+    bc1 = createPipeline(dxvk_decode_bc1);
+    bc3 = createPipeline(dxvk_decode_bc3);
+    rgtc = createPipeline(dxvk_decode_rgtc);
+  }
+
+  VkPipeline DxvkMetaBc::getBptcPipeline(bool hdr) {
+    std::lock_guard<std::mutex> lock(m_bptcMutex);
+    const size_t index = hdr ? 1 : 0;
+    if (pipelineLayout && !m_bptcAttempted[index]) {
+      m_bptcAttempted[index] = true;
+      m_bptcPipelines[index] = hdr ? createPipeline(dxvk_decode_bc6) : createPipeline(dxvk_decode_bc7);
+    }
+    return m_bptcPipelines[index];
+  }
+
+  DxvkMetaBc::~DxvkMetaBc() {
+    for (VkPipeline pipeline : m_bptcPipelines)
+      m_vkd->vkDestroyPipeline(m_vkd->device(), pipeline, nullptr);
+    m_vkd->vkDestroyPipeline(m_vkd->device(), rgtc, nullptr);
+    m_vkd->vkDestroyPipeline(m_vkd->device(), bc3, nullptr);
+    m_vkd->vkDestroyPipeline(m_vkd->device(), bc1, nullptr);
+    m_vkd->vkDestroyPipelineLayout(m_vkd->device(), pipelineLayout, nullptr);
+    m_vkd->vkDestroyDescriptorSetLayout(m_vkd->device(), descriptorLayout, nullptr);
+  }
+
+  VkPipeline DxvkMetaBc::createPipeline(const SpirvCodeBuffer& code) const {
+    VkShaderModuleCreateInfo shader = { VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO };
+    shader.codeSize = code.size();
+    shader.pCode = code.data();
+    VkShaderModule module = VK_NULL_HANDLE;
+    if (m_vkd->vkCreateShaderModule(m_vkd->device(), &shader, nullptr, &module) != VK_SUCCESS)
+      return VK_NULL_HANDLE;
+
+    VkComputePipelineCreateInfo info = { VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO };
+    info.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+    info.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+    info.stage.module = module;
+    info.stage.pName = "main";
+    info.layout = pipelineLayout;
+    info.basePipelineIndex = -1;
+    VkPipeline pipeline = VK_NULL_HANDLE;
+    auto result = m_vkd->vkCreateComputePipelines(m_vkd->device(), VK_NULL_HANDLE, 1, &info, nullptr, &pipeline);
+    m_vkd->vkDestroyShaderModule(m_vkd->device(), module, nullptr);
+    if (result != VK_SUCCESS) {
+      m_vkd->vkDestroyPipeline(m_vkd->device(), pipeline, nullptr);
+      return VK_NULL_HANDLE;
+    }
+    return pipeline;
+  }
+
+}
