+  }
+
+
+  void DxvkContext::updateBcCpuImage(
+    const Rc<DxvkImage>&            image,
+          VkImageSubresourceLayers  subresources,
+          VkOffset3D                offset,
+          VkExtent3D                extent,
+    const void*                     data,
+          VkDeviceSize              pitchPerRow) {
+    const VkDeviceSize rowBytes = VkDeviceSize(extent.width) * image->formatInfo()->elementSize;
+    auto staging = m_staging.alloc(256, rowBytes * extent.height);
+    auto* dst = static_cast<uint8_t*>(staging.mapPtr(0));
+    const auto* src = static_cast<const uint8_t*>(data);
+    for (uint32_t row = 0; row < extent.height; row++)
+      std::memcpy(dst + row * rowBytes, src + row * pitchPerRow, rowBytes);
