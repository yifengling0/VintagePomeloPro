+
+  bool DxvkContext::canUploadBcImage(VkFormat srcFormat, VkFormat dstFormat, VkExtent3D extent) {
+    static const bool enabled = env::getEnvVar("WINEHUA_GPU_BC_UPLOAD") == "1";
+    static const uint64_t minPixels = [] {
+      const auto value = env::getEnvVar("WINEHUA_GPU_BC_UPLOAD_MIN_PIXELS");
+      char* end = nullptr;
+      const auto parsed = std::strtoul(value.c_str(), &end, 10);
+      return end != value.c_str() && *end == '\0' && parsed >= 256 * 256 && parsed <= 4096 * 4096
+        ? uint64_t(parsed) : uint64_t(1024 * 1024);
+    }();
+    bool formatMatches = false;
+    switch (srcFormat) {
+      case VK_FORMAT_BC1_RGBA_UNORM_BLOCK:
+      case VK_FORMAT_BC1_RGBA_SRGB_BLOCK:
+      case VK_FORMAT_BC7_UNORM_BLOCK:
+      case VK_FORMAT_BC7_SRGB_BLOCK:
+      case VK_FORMAT_BC2_UNORM_BLOCK:
+      case VK_FORMAT_BC2_SRGB_BLOCK:
+      case VK_FORMAT_BC3_UNORM_BLOCK:
+      case VK_FORMAT_BC3_SRGB_BLOCK:
+        formatMatches = dstFormat == VK_FORMAT_R8G8B8A8_UNORM || dstFormat == VK_FORMAT_R8G8B8A8_SRGB;
+        break;
+      case VK_FORMAT_BC4_UNORM_BLOCK:
+      case VK_FORMAT_BC4_SNORM_BLOCK:
+        formatMatches = dstFormat == VK_FORMAT_R8_UNORM || dstFormat == VK_FORMAT_R8_SNORM;
+        break;
+      case VK_FORMAT_BC5_UNORM_BLOCK:
+      case VK_FORMAT_BC5_SNORM_BLOCK:
+        formatMatches = dstFormat == VK_FORMAT_R8G8_UNORM || dstFormat == VK_FORMAT_R8G8_SNORM;
+        break;
+      case VK_FORMAT_BC6H_UFLOAT_BLOCK:
+      case VK_FORMAT_BC6H_SFLOAT_BLOCK:
+        formatMatches = dstFormat == VK_FORMAT_R16G16B16A16_SFLOAT;
+        break;
+      default: return false;
+    }
+    const uint64_t pixels = uint64_t(extent.width) * extent.height;
+    return enabled && formatMatches && extent.depth == 1
+        && extent.width <= 4096 && extent.height <= 4096 &&
+        pixels >= minPixels && pixels <= 4096 * 4096;
+  }
+
+
+  bool DxvkContext::tryUploadBcImage(
+    const Rc<DxvkImage>&            image,
+          VkImageSubresourceLayers  subresources,
+          VkOffset3D                offset,
+          VkExtent3D                extent,
+          VkFormat                  packedFormat,
+    const void*                     data,
+          VkDeviceSize              pitchPerRow) {
+    static const bool tracing = env::getEnvVar("WINEHUA_GPU_BC_UPLOAD_TRACE") == "1";
+    if (tracing) {
+      static std::atomic<uint32_t> samples { 0 };
+      if (samples.fetch_add(1, std::memory_order_relaxed) < 32)
+        Logger::info(str::format("WineHua: BC upload probe format=", uint32_t(packedFormat),
+          " backing=", uint32_t(image->info().format), " extent=", extent.width, "x", extent.height,
+          " eligible=", canUploadBcImage(packedFormat, image->info().format, extent)));
+    }
+    if (!data || subresources.aspectMask != VK_IMAGE_ASPECT_COLOR_BIT ||
+        subresources.layerCount != 1 ||
+        !(image->info().usage & VK_IMAGE_USAGE_TRANSFER_DST_BIT) ||
+        !canUploadBcImage(packedFormat, image->info().format, extent))
+      return false;
+
+    const auto& limits = m_device->properties().core.properties.limits;
+    const uint32_t bcBytes = imageFormatInfo(packedFormat)->elementSize;
+    const uint32_t paddedWidth = align(extent.width, 4u);
+    const uint32_t paddedHeight = align(extent.height, 4u);
+    const VkDeviceSize rowBytes = VkDeviceSize(paddedWidth / 4) * bcBytes;
+    const VkDeviceSize inputBytes = rowBytes * (paddedHeight / 4);
+    const uint32_t pixelBytes = image->formatInfo()->elementSize;
+    const VkDeviceSize outputBytes = VkDeviceSize(paddedWidth) * paddedHeight * pixelBytes;
+    const uint32_t groupsX = (extent.width + 31) / 32;
+    const uint32_t groupsY = (extent.height + 31) / 32;
+    if (pitchPerRow < rowBytes || outputBytes > limits.maxStorageBufferRange ||
+        groupsX > limits.maxComputeWorkGroupCount[0] ||
+        groupsY > limits.maxComputeWorkGroupCount[1])
+      return false;
+
+    auto& meta = m_common->metaBc();
+    const bool isSigned = packedFormat == VK_FORMAT_BC4_SNORM_BLOCK || packedFormat == VK_FORMAT_BC5_SNORM_BLOCK;
+    const bool bc2 = packedFormat == VK_FORMAT_BC2_UNORM_BLOCK || packedFormat == VK_FORMAT_BC2_SRGB_BLOCK;
+    const bool hdr = packedFormat == VK_FORMAT_BC6H_UFLOAT_BLOCK || packedFormat == VK_FORMAT_BC6H_SFLOAT_BLOCK;
+    const bool bc7 = packedFormat == VK_FORMAT_BC7_UNORM_BLOCK || packedFormat == VK_FORMAT_BC7_SRGB_BLOCK;
+    VkPipeline pipeline = hdr || bc7 ? meta.getBptcPipeline(hdr)
+      : pixelBytes < 4 ? meta.rgtc : bcBytes == 8 ? meta.bc1 : meta.bc3;
+    if (!pipeline)
+      return false;
+
+    DxvkBufferSlice input;
+    VkDescriptorSet set;
+    try {
+      if (m_bcUploadScratch == nullptr || m_bcUploadScratch->info().size < outputBytes) {
+        DxvkBufferCreateInfo info = { };
+        info.size   = align(outputBytes, VkDeviceSize(4 * 1024 * 1024));
+        info.usage  = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+        info.stages = VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT;
+        info.access = VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT;
+        m_bcUploadScratch = m_device->createBuffer(info, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+      }
+      input = m_staging.alloc(std::max<VkDeviceSize>(256, limits.minStorageBufferOffsetAlignment), inputBytes);
+      set = allocateDescriptorSet(meta.descriptorLayout);
+    } catch (const DxvkError&) {
+      return false;
+    }
+
+    auto* dst = static_cast<uint8_t*>(input.mapPtr(0));
+    if (!set || !dst)
+      return false;
+    const auto* src = static_cast<const uint8_t*>(data);
+    if (pitchPerRow == rowBytes) {
+      std::memcpy(dst, src, inputBytes);
+    } else {
+      for (uint32_t row = 0; row < paddedHeight / 4; row++)
+        std::memcpy(dst + row * rowBytes, src + row * pitchPerRow, rowBytes);
+    }
+
+    if (this->flushMappedBuffer(input.buffer(), input.getSliceHandle()) != VK_SUCCESS)
+      return false;
+
+    this->spillRenderPass(true);
+    this->unbindComputePipeline();
+    m_execBarriers.recordCommands(m_cmd);
+
+    const VkDescriptorBufferInfo buffers[] = {
+      input.getDescriptor().buffer,
+      m_bcUploadScratch->getDescriptor(0, outputBytes).buffer,
+    };
+    VkWriteDescriptorSet writes[2] = { };
+    for (uint32_t i = 0; i < 2; i++) {
+      writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+      writes[i].dstSet = set;
+      writes[i].dstBinding = i;
+      writes[i].descriptorCount = 1;
+      writes[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+      writes[i].pBufferInfo = &buffers[i];
+    }
+    m_cmd->updateDescriptorSets(2, writes);
+
+    const uint32_t dimensions[] = { paddedWidth, paddedHeight,
+      pixelBytes < 4 ? (pixelBytes | (isSigned ? 4u : 0u)) : (bc2 ? 2u : uint32_t(packedFormat == VK_FORMAT_BC6H_SFLOAT_BLOCK)) };
+    m_cmd->cmdBindPipeline(VK_PIPELINE_BIND_POINT_COMPUTE, pipeline);
+    m_cmd->cmdBindDescriptorSet(VK_PIPELINE_BIND_POINT_COMPUTE, meta.pipelineLayout, set, 0, nullptr);
+    m_cmd->cmdPushConstants(meta.pipelineLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(dimensions), dimensions);
+    m_cmd->cmdDispatch(groupsX, groupsY, 1);
+
