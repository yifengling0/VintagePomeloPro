diff --git a/src/dxvk/shaders/dxvk_bc_decode.glsl b/src/dxvk/shaders/dxvk_bc_decode.glsl
new file mode 100644
--- /dev/null
+++ b/src/dxvk/shaders/dxvk_bc_decode.glsl
@@ -0,0 +1,81 @@
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 0, std430) readonly buffer Blocks { uint words[]; };
+#if BC3
+layout(set = 0, binding = 1, std430) writeonly buffer Pixels { uint pixels[]; };
+#else
+layout(set = 0, binding = 1, std430) writeonly buffer Pixels { uvec4 rows[]; };
+#endif
+layout(push_constant) uniform Params { uint width; uint height; uint mode; };
+
+uvec3 unpack565(uint v) {
+    return uvec3((v >> 11) & 31u, (v >> 5) & 63u, v & 31u);
+}
+
+uint packColor(uvec3 c) {
+    return c.r | (c.g << 8) | (c.b << 16);
+}
+
+void main() {
+    const uint bc3 = BC3;
+    uvec2 block = gl_GlobalInvocationID.xy;
+    uint cols = width / 4u;
+    if (block.x >= cols || block.y >= height / 4u)
+        return;
+    uint src = (block.y * cols + block.x) * (2u + 2u * bc3);
+    uint colorWord = words[src + 2u * bc3];
+    uint colorIndices = words[src + 2u * bc3 + 1u];
+    uint e0 = colorWord & 65535u;
+    uint e1 = colorWord >> 16;
+    uvec3 c0 = unpack565(e0);
+    uvec3 c1 = unpack565(e1);
+    // Match the integer rounding of the vendored bcdec reference.
+    uvec3 first = (c0 * uvec3(527, 259, 527) + uvec3(23, 33, 23)) >> 6;
+    uvec3 second = (c1 * uvec3(527, 259, 527) + uvec3(23, 33, 23)) >> 6;
+    uint p0 = packColor(first) | 0xff000000u;
+    uint p1 = packColor(second) | 0xff000000u;
+    uint p2, p3;
+    if (e0 > e1 || bc3 != 0u) {
+        p2 = packColor((2u * first + second + 1u) / 3u) | 0xff000000u;
+        p3 = packColor((first + 2u * second + 1u) / 3u) | 0xff000000u;
+    } else {
+        p2 = packColor((first + second + 1u) >> 1) | 0xff000000u;
+        p3 = 0u;
+    }
+    uvec4 palette = uvec4(p0, p1, p2, p3);
+    uint alpha0 = 0u, alpha1 = 0u;
+    uint alphaLo = 0u, alphaHi = 0u;
+#if !BC3
+    uvec4 row;
+#endif
+    if (bc3 != 0u) {
+        uint lo = words[src], hi = words[src + 1u];
+        alpha0 = lo & 255u;
+        alpha1 = (lo >> 8) & 255u;
+        alphaLo = (lo >> 16) | (hi << 16);
+        alphaHi = hi >> 16;
+    }
+    for (uint i = 0; i < 16; ++i) {
+        uint value = palette[colorIndices & 3u];
+        colorIndices >>= 2;
+        if (bc3 != 0u) {
+            uint k = alphaLo & 7u;
+            alphaLo = (alphaLo >> 3) | (alphaHi << 29);
+            alphaHi >>= 3;
+            uint a;
+            if (mode == 2u) a = ((words[src + i / 8u] >> (4u * (i & 7u))) & 15u) * 17u;
+            else if (k < 2u) a = k == 0u ? alpha0 : alpha1;
+            else if (alpha0 > alpha1) a = ((8u-k)*alpha0 + (k-1u)*alpha1 + 1u) / 7u;
+            else if (k < 6u) a = ((6u-k)*alpha0 + (k-1u)*alpha1 + 1u) / 5u;
+            else a = k == 6u ? 0u : 255u;
+            value = (value & 0x00ffffffu) | (a << 24);
+        }
+        uvec2 pos = block * 4u + uvec2(i & 3u, i >> 2);
+#if BC3
+        pixels[pos.y * width + pos.x] = value;
+#else
+        row[i & 3u] = value;
+        if ((i & 3u) == 3u)
+            rows[pos.y * cols + block.x] = row;
+#endif
+    }
+}
