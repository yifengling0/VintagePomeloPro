diff --git a/src/d3d9/d3d9_frame_camera.h b/src/d3d9/d3d9_frame_camera.h
new file mode 100644
index 0000000..21fbd9c
--- /dev/null
+++ b/src/d3d9/d3d9_frame_camera.h
@@ -0,0 +1,101 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <string_view>
+
+namespace dxvk {
+
+  struct D3D9FrameCamera {
+    struct Matrix {
+      uint16_t firstRegister = 0;
+      bool columnRegisters = false;
+      bool present = false;
+    };
+
+    Matrix viewProjection;
+    Matrix view;
+    Matrix projection;
+  };
+
+  inline D3D9FrameCamera FindD3D9FrameCamera(const uint8_t* bytecode, size_t size) {
+    // D3D9 CTAB offsets are relative to the header after the FourCC.
+    const auto read16 = [](const uint8_t* bytes) {
+      return uint16_t(bytes[0] | (uint16_t(bytes[1]) << 8));
+    };
+    const auto read32 = [&](const uint8_t* bytes) {
+      return uint32_t(read16(bytes)) | (uint32_t(read16(bytes + 2)) << 16);
+    };
+    if (size < 4 || read16(bytecode + 2) != 0xfffe || bytecode[1] < 2)
+      return {};
+
+    for (size_t offset = 4; size - offset >= 4;) {
+      const uint32_t token = read32(bytecode + offset);
+      const uint32_t opcode = token & 0xffff;
+      offset += 4;
+      if (opcode == 0xffff) break;
+      const size_t words = opcode == 0xfffe ? (token >> 16) & 0x7fff : (token >> 24) & 15;
+      if (words > (size - offset) / 4) return {};
+      const size_t bytes = words * 4;
+      const auto* comment = bytecode + offset;
+      offset += bytes;
+      if (opcode != 0xfffe || bytes < 32 || std::memcmp(comment, "CTAB", 4))
+        continue;
+
+      const auto* table = comment + 4;
+      const size_t tableSize = bytes - 4;
+      const size_t count = read32(table + 12);
+      const size_t infoOffset = read32(table + 16);
+      if (read32(table) != 28 || infoOffset < 28 || infoOffset > tableSize ||
+          count > (tableSize - infoOffset) / 20)
+        return {};
+
+      D3D9FrameCamera result;
+      for (size_t i = 0; i < count; i++) {
+        const auto* info = table + infoOffset + i * 20;
+        const size_t nameOffset = read32(info);
+        const size_t typeOffset = read32(info + 12);
+        if (nameOffset >= tableSize || typeOffset > tableSize || tableSize - typeOffset < 16)
+          return {};
+        const auto* name = reinterpret_cast<const char*>(table + nameOffset);
+        const auto* end = static_cast<const char*>(std::memchr(name, 0, tableSize - nameOffset));
+        if (!end) return {};
+
+        // Accept only named world-to-camera transforms. WorldViewProj and
+        // object transforms change per draw and are not a camera.
+        char normalized[32];
+        size_t length = 0;
+        for (const char* p = name; p != end && length < sizeof(normalized); ++p) {
+          if (*p == '_') continue;
+          normalized[length++] = *p >= 'A' && *p <= 'Z' ? char(*p + ('a' - 'A')) : *p;
+        }
+        auto semantic = std::string_view(normalized, length);
+        if (semantic.size() >= 2 && name + 1 < end && name[1] == '_' &&
+            (semantic.front() == 'g' || semantic.front() == 'u'))
+          semantic.remove_prefix(1);
+        D3D9FrameCamera::Matrix* matrix = nullptr;
+        if (semantic == "viewprojection" || semantic == "viewproj" ||
+            semantic == "viewprojectionmatrix" || semantic == "matviewproj")
+          matrix = &result.viewProjection;
+        else if (semantic == "view" || semantic == "viewmatrix" || semantic == "matview")
+          matrix = &result.view;
+        else if (semantic == "projection" || semantic == "projectionmatrix" ||
+                 semantic == "matprojection" || semantic == "matproj")
+          matrix = &result.projection;
+
+        if (!matrix) continue;
+        const auto* type = table + typeOffset;
+        const auto matrixClass = read16(type);
+        if (matrix->present || read16(info + 4) != 2 || read16(info + 8) != 4 ||
+            (matrixClass != 2 && matrixClass != 3) || read16(type + 2) != 3 ||
+            read16(type + 4) != 4 || read16(type + 6) != 4 || read16(type + 8) != 1)
+          return {};
+        *matrix = {read16(info + 6), matrixClass == 3, true};
+      }
+      return result;
+    }
+    return {};
+  }
+
+}
