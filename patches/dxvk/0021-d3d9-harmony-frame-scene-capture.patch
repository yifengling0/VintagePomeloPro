+  void D3D9DeviceEx::CaptureFrameGenerationScene() {
+    auto& scene = m_frameGenerationScene;
+    auto* target = m_state.renderTargets[0].ptr();
+    auto* depth = m_state.depthStencil.ptr();
+    if (!target || !depth || !m_state.renderStates[D3DRS_ZENABLE] ||
+        !m_state.renderStates[D3DRS_ZWRITEENABLE])
+      return;
+
+    const auto& depthImage = depth->GetCommonTexture()->GetImage();
+    if (m_implicitSwapchain == nullptr || target != m_implicitSwapchain->GetBackBuffer(0)) {
+      if (scene.depth == depthImage)
+        scene.ambiguous = true;
+      return;
+    }
+
+    const auto& viewport = m_state.viewport;
+    const auto extent = target->GetSurfaceExtent();
+    const auto depthExtent = depth->GetSurfaceExtent();
+    if (m_state.vertexDecl == nullptr || m_state.vertexDecl->TestFlag(D3D9VertexDeclFlag::HasPositionT) ||
+        UseProgrammableVS() || viewport.X || viewport.Y || viewport.Width != extent.width ||
+        viewport.Height != extent.height || viewport.MinZ != 0.0f || viewport.MaxZ != 1.0f ||
+        extent.width != depthExtent.width || extent.height != depthExtent.height ||
+        depth->GetMipLevel() || depthImage->info().sampleCount != VK_SAMPLE_COUNT_1_BIT) {
+      scene.ambiguous = true;
+      return;
+    }
+
+    const auto& color = target->GetCommonTexture()->GetImage();
+    const auto& view = m_state.transforms[GetTransformIndex(D3DTS_VIEW)];
+    const auto& projection = m_state.transforms[GetTransformIndex(D3DTS_PROJECTION)];
+
+    if (scene.color == nullptr) {
+      scene.color = color;
+      scene.depth = depthImage;
+      scene.view = view;
+      scene.projection = projection;
+    } else if (scene.color != color || scene.depth != depthImage ||
+               scene.view != view || scene.projection != projection) {
+      scene.ambiguous = true;
+    }
+  }
+
+
+  void D3D9DeviceEx::TraceFrameGenerationScene(D3D9Surface* backBuffer, uint64_t serial) {
+    auto scene = std::exchange(m_frameGenerationScene, {});
+    // Keep the trace bounded even on workloads which continue drawing indefinitely.
+    if (serial > 24)
+      return;
+
+    if (scene.ambiguous || scene.color == nullptr || !backBuffer ||
+        scene.color != backBuffer->GetCommonTexture()->GetImage()) {
+      Logger::info(str::format("VPP_FG_D3D9 serial=", serial, " scene=",
+        scene.ambiguous ? "ambiguous" : "unavailable"));
+      return;
+    }
+
+    const auto viewProjection = scene.projection * scene.view;
+    const auto determinantValue = determinant(viewProjection);
+    if (!std::isfinite(determinantValue) || determinantValue == 0.0f) {
+      Logger::info(str::format("VPP_FG_D3D9 serial=", serial, " scene=singular-camera"));
+      return;
+    }
+
+    const auto inverseViewProjection = inverse(viewProjection);
+    for (size_t col = 0; col < 4; col++) {
+      for (size_t row = 0; row < 4; row++) {
+        if (!std::isfinite(viewProjection[col][row]) ||
+            !std::isfinite(inverseViewProjection[col][row])) {
+          Logger::info(str::format("VPP_FG_D3D9 serial=", serial, " scene=non-finite-camera"));
+          return;
+        }
+      }
+    }
+
+    const auto& info = scene.depth->info();
+    Logger::info(str::format("VPP_FG_D3D9 serial=", serial,
+      " scene=fixed-function color=", scene.color->handle(),
+      " depth=", scene.depth->handle(), " depthSize=", info.extent.width, "x", info.extent.height,
+      " depthFormat=", static_cast<uint32_t>(info.format),
+      " sampleable=", bool(info.usage & VK_IMAGE_USAGE_SAMPLED_BIT),
+      " viewProj=", viewProjection, " invViewProj=", inverseViewProjection));
+  }
