--- a/src/dxvk/dxvk_shader.cpp
+++ b/src/dxvk/dxvk_shader.cpp
@@ -219,6 +219,38 @@
     buffer = SpirvCodeBuffer(frozen.size(), frozen.data());
   }
 
+  static void freezeVirtualBcStage(SpirvCodeBuffer& buffer, const uint32_t* values) {
+    if (!values) return;
+    std::unordered_map<uint32_t, uint32_t> named;
+    const uint32_t* data = buffer.data();
+    for (auto ins : buffer) {
+      if (ins.opCode() == spv::OpName && ins.length() > 2
+       && !std::strcmp(reinterpret_cast<const char*>(data + ins.offset() + 2),
+                      "winehua_virtual_bc_stage_active"))
+        named.emplace(ins.arg(1), 0);
+    }
+    if (named.empty()) return;
+    for (auto ins : buffer) {
+      if (ins.opCode() == spv::OpDecorate && ins.length() == 4
+       && ins.arg(2) == spv::DecorationSpecId && named.count(ins.arg(1))) {
+        const uint32_t index = ins.arg(3) - uint32_t(DxvkSpecConstantId::FirstPipelineConstant);
+        if (index >= 2 && index < 8) named[ins.arg(1)] = values[index];
+      }
+    }
+    std::vector<uint32_t> frozen(data, data + 5);
+    for (auto ins : buffer) {
+      if (ins.opCode() == spv::OpDecorate && ins.length() == 4
+       && ins.arg(2) == spv::DecorationSpecId && named.count(ins.arg(1))) continue;
+      const size_t start = frozen.size();
+      frozen.insert(frozen.end(), data + ins.offset(), data + ins.offset() + ins.length());
+      if (ins.opCode() == spv::OpSpecConstant && ins.length() == 4 && named.count(ins.arg(2))) {
+        frozen[start] = (4u << 16) | uint32_t(spv::OpConstant);
+        frozen[start + 3] = named[ins.arg(2)];
+      }
+    }
+    buffer = SpirvCodeBuffer(frozen.size(), frozen.data());
+  }
+
