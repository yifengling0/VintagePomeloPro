+  uint32_t D3D9DeviceEx::ReadFrameSceneRequest() const {
+    // The app creates this private mapping before starting the Wine session.
+    // Use Wine's Unix namespace because Z: is configurable per game.
+    struct RequestMapping {
+      const uint32_t* view = nullptr;
+
+      RequestMapping() {
+        if (!GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "wine_get_version"))
+          return;
+        const HANDLE file = CreateFileW(
+          L"\\\\?\\unix\\data\\storage\\el2\\base\\files\\.vpp-harmony-frame-policy-v1",
+          GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr,
+          OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+        if (file == INVALID_HANDLE_VALUE)
+          return;
+        const HANDLE mapping = CreateFileMappingW(file, nullptr, PAGE_READONLY, 0, 0, nullptr);
+        CloseHandle(file);
+        if (mapping) {
+          view = static_cast<const uint32_t*>(MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, sizeof(uint32_t)));
+          CloseHandle(mapping);
+        }
+      }
+
+      ~RequestMapping() {
+        if (view)
+          UnmapViewOfFile(view);
+      }
+    };
+    static const RequestMapping mapping;
+    return mapping.view ? __atomic_load_n(mapping.view, __ATOMIC_ACQUIRE) : 0;
+  }
