+  // Bake the two per-pipeline BGRA view masks before driver compilation.
+  // Only DXBC shaders using this mapping participate; D3D9/HUD/present
+  // specialization constants retain their original behavior.
+  static void freezeBgraUavSpecConstants(SpirvCodeBuffer& buffer, const uint32_t* values) {
+    if (!values)
+      return;
+    std::unordered_map<uint32_t, uint32_t> replacements;
+    for (auto ins : buffer) {
+      if (ins.opCode() == spv::OpDecorate && ins.length() == 4
+       && ins.arg(2) == spv::DecorationSpecId) {
+        const uint32_t first = uint32_t(DxvkSpecConstantId::FirstPipelineConstant) + DxbcBgraUavSpecIndex;
+        if (ins.arg(3) >= first && ins.arg(3) < first + DxbcBgraUavSpecWords)
+          replacements.emplace(ins.arg(1), values[DxbcBgraUavSpecIndex + ins.arg(3) - first]);
+      }
+    }
+    if (replacements.empty())
+      return;
+    const uint32_t* data = buffer.data();
+    std::vector<uint32_t> frozen(data, data + 5);
+    for (auto ins : buffer) {
+      if (ins.opCode() == spv::OpDecorate && ins.length() == 4
+       && ins.arg(2) == spv::DecorationSpecId && replacements.count(ins.arg(1)))
+        continue;
+      const size_t start = frozen.size();
+      frozen.insert(frozen.end(), data + ins.offset(), data + ins.offset() + ins.length());
+      if (ins.opCode() == spv::OpSpecConstant && ins.length() == 4) {
+        auto value = replacements.find(ins.arg(2));
+        if (value != replacements.end()) {
+          frozen[start] = (4u << 16) | uint32_t(spv::OpConstant);
+          frozen[start + 3] = value->second;
+        }
+      }
+    }
+    buffer = SpirvCodeBuffer(frozen.size(), frozen.data());
+  }
