diff --git a/src/gallium/drivers/virgl/virgl_srgb.c b/src/gallium/drivers/virgl/virgl_srgb.c
new file mode 100644
--- /dev/null
+++ b/src/gallium/drivers/virgl/virgl_srgb.c
@@ -0,0 +1,207 @@
+/* SPDX-License-Identifier: MIT
+ * GLES hosts without destination sRGB control can render through a second,
+ * correctly typed GPU texture. The guest's original resource remains the
+ * public identity. Raw image copies synchronize dirty mip levels when that
+ * identity is consumed or submitted. No framebuffer readback or CPU copies.
+ */
+#include "virgl_srgb.h"
+#include "virgl_context.h"
+#include "virgl_resource.h"
+#include "virgl_encode.h"
+#include "util/format/u_format.h"
+#include "util/u_inlines.h"
+#include "util/u_memory.h"
+
+static void
+srgb_copy_level(struct virgl_context *ctx, struct virgl_resource *dst,
+                struct virgl_resource *src, unsigned level)
+{
+   struct pipe_box box = {0};
+   box.width = u_minify(src->b.width0, level);
+   box.height = u_minify(src->b.height0, level);
+   box.depth = src->b.target == PIPE_TEXTURE_3D ?
+      u_minify(src->b.depth0, level) : src->b.array_size;
+   virgl_encode_resource_copy_region(ctx, dst, level, 0, 0, 0, src, level, &box);
+}
+
+void
+virgl_srgb_sync_resource(struct virgl_context *ctx, struct virgl_resource *res)
+{
+   if (!res || !res->srgb_pending) return;
+   if (res->srgb_owner != ctx) {
+      /* Shared-context users still require their normal API synchronization.
+       * Submit pending copies on the writer before accessing its identity. */
+      struct virgl_context *writer = res->srgb_owner;
+      writer->base.flush(&writer->base, NULL, 0);
+      return;
+   }
+   unsigned levels = res->srgb_pending;
+   struct pipe_resource *hold = res->srgb_hold;
+   res->srgb_pending = 0;
+   res->srgb_owner = NULL;
+   res->srgb_hold = NULL;
+   list_del(&res->srgb_link);
+   /* Clear ownership before encoding: an almost full command buffer may
+    * recursively flush. The local reference protects both GPU storages. */
+   while (levels) {
+      unsigned level = u_bit_scan(&levels);
+      srgb_copy_level(ctx, res, virgl_resource(res->srgb_shadow), level);
+      res->clean_mask &= ~(1u << level);
+   }
+   pipe_resource_reference(&hold, NULL);
+}
+
+void
+virgl_srgb_flush_pending(struct virgl_context *ctx)
+{
+   while (!list_is_empty(&ctx->srgb_pending_resources)) {
+      struct virgl_resource *res = list_first_entry(&ctx->srgb_pending_resources,
+                                                   struct virgl_resource, srgb_link);
+      virgl_srgb_sync_resource(ctx, res);
+   }
+}
+
+struct pipe_resource *
+virgl_srgb_view_resource(struct virgl_context *ctx, struct pipe_resource *resource,
+                         enum pipe_format format)
+{
+   struct virgl_resource *res = virgl_resource(resource);
+   struct virgl_screen *screen = virgl_screen(ctx->base.screen);
+   if (!screen->emulate_srgb_surfaces ||
+       util_format_is_srgb(format) == util_format_is_srgb(resource->format))
+      return resource;
+   if (resource->target == PIPE_BUFFER ||
+       util_format_linear(format) != util_format_linear(resource->format))
+      return NULL;
+   if (!res->srgb_shadow) {
+      struct pipe_resource templ = *resource;
+      templ.format = util_format_is_srgb(resource->format) ?
+         util_format_linear(resource->format) : util_format_srgb(resource->format);
+      templ.bind &= ~(PIPE_BIND_SHARED | PIPE_BIND_SCANOUT | PIPE_BIND_DISPLAY_TARGET |
+                      PIPE_BIND_CURSOR);
+      templ.bind |= PIPE_BIND_RENDER_TARGET | PIPE_BIND_SAMPLER_VIEW;
+      templ.flags = 0;
+      res->srgb_shadow = ctx->base.screen->resource_create(ctx->base.screen, &templ);
+      if (!res->srgb_shadow) return NULL;
+   }
+   return res->srgb_shadow;
+}
+
+static void
+srgb_prepare_level(struct virgl_context *ctx, struct virgl_resource *res, unsigned level)
+{
+   unsigned bit = 1u << level;
+   if (res->srgb_pending && res->srgb_owner != ctx)
+      virgl_srgb_sync_resource(ctx, res);
+   if (!(res->srgb_valid & bit)) {
+      /* A canonical upload/copy/render invalidates only the touched level. */
+      srgb_copy_level(ctx, virgl_resource(res->srgb_shadow), res, level);
+      res->srgb_valid |= bit;
+   }
+}
+
+static void
+srgb_written_level(struct virgl_context *ctx, struct virgl_resource *res, unsigned level)
+{
+   if (!res->srgb_pending) {
+      pipe_resource_reference(&res->srgb_hold, &res->b);
+      res->srgb_owner = ctx;
+      list_addtail(&res->srgb_link, &ctx->srgb_pending_resources);
+   }
+   assert(res->srgb_owner == ctx);
+   res->srgb_pending |= 1u << level;
+   res->srgb_valid |= 1u << level;
+   res->clean_mask &= ~(1u << level);
+}
+
+void
+virgl_srgb_prepare_surface(struct virgl_context *ctx, struct pipe_surface *surf)
+{
+   if (!surf) return;
+   struct virgl_resource *res = virgl_resource(surf->texture);
+   if (virgl_surface(surf)->srgb_shadow)
+      srgb_prepare_level(ctx, res, surf->u.tex.level);
+   else
+      virgl_srgb_sync_resource(ctx, res);
+}
+
+void
+virgl_srgb_written_surface(struct virgl_context *ctx, struct pipe_surface *surf)
+{
+   if (!surf) return;
+   struct virgl_resource *res = virgl_resource(surf->texture);
+   if (virgl_surface(surf)->srgb_shadow)
+      srgb_written_level(ctx, res, surf->u.tex.level);
+   else
+      virgl_resource_dirty(res, surf->u.tex.level);
+}
+
+void
+virgl_srgb_prepare_framebuffer(struct virgl_context *ctx, unsigned buffers)
+{
+   for (unsigned i = 0; i < ctx->framebuffer.nr_cbufs; i++)
+      if (buffers & (PIPE_CLEAR_COLOR0 << i))
+         virgl_srgb_prepare_surface(ctx, ctx->framebuffer.cbufs[i]);
+}
+
+void
+virgl_srgb_written_framebuffer(struct virgl_context *ctx, unsigned buffers)
+{
+   for (unsigned i = 0; i < ctx->framebuffer.nr_cbufs; i++)
+      if (buffers & (PIPE_CLEAR_COLOR0 << i))
+         virgl_srgb_written_surface(ctx, ctx->framebuffer.cbufs[i]);
+}
+
+void
+virgl_srgb_prepare_bindings(struct virgl_context *ctx, bool compute)
+{
+   if (!virgl_screen(ctx->base.screen)->emulate_srgb_surfaces) return;
+   for (unsigned s = 0; s < PIPE_SHADER_TYPES; s++) {
+      if ((s == PIPE_SHADER_COMPUTE) != compute) continue;
+      struct virgl_shader_binding_state *binding = &ctx->shader_bindings[s];
+      for (unsigned i = 0; i < PIPE_MAX_SHADER_SAMPLER_VIEWS; i++)
+         if (binding->views[i])
+            virgl_srgb_sync_resource(ctx, virgl_resource(binding->views[i]->texture));
+      unsigned images = binding->image_enabled_mask;
+      while (images) {
+         unsigned i = u_bit_scan(&images);
+         virgl_srgb_sync_resource(ctx, virgl_resource(binding->images[i].resource));
+      }
+   }
+}
+
+void
+virgl_srgb_written_images(struct virgl_context *ctx, bool compute)
+{
+   if (!virgl_screen(ctx->base.screen)->emulate_srgb_surfaces) return;
+   for (unsigned s = 0; s < PIPE_SHADER_TYPES; s++) {
+      if ((s == PIPE_SHADER_COMPUTE) != compute) continue;
+      struct virgl_shader_binding_state *binding = &ctx->shader_bindings[s];
+      unsigned images = binding->image_enabled_mask;
+      while (images) {
+         unsigned i = u_bit_scan(&images);
+         if (binding->images[i].access & PIPE_IMAGE_ACCESS_WRITE)
+            virgl_resource_dirty(virgl_resource(binding->images[i].resource),
+                                  binding->images[i].u.tex.level);
+      }
+   }
+}
+
+/* Blits also use typed storage for source interpretation, not just the FBO. */
+struct pipe_resource *
+virgl_srgb_prepare_blit(struct virgl_context *ctx, struct pipe_resource *resource,
+                        enum pipe_format format, unsigned level)
+{
+   struct pipe_resource *view = virgl_srgb_view_resource(ctx, resource, format);
+   if (view == resource) virgl_srgb_sync_resource(ctx, virgl_resource(resource));
+   else if (view) srgb_prepare_level(ctx, virgl_resource(resource), level);
+   return view;
+}
+
+void
+virgl_srgb_written_blit(struct virgl_context *ctx, struct pipe_resource *original,
+                        struct pipe_resource *target, unsigned level)
+{
+   if (original != target) srgb_written_level(ctx, virgl_resource(original), level);
+   else virgl_resource_dirty(virgl_resource(original), level);
+}
