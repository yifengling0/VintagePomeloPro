+#if defined(__OHOS__) && defined(__aarch64__)
+static once_flag winehua_low_map_once = ONCE_FLAG_INIT;
+static void *(*winehua_low_map)(int fd, size_t size);
+static void (*winehua_low_map_release)(void *ptr);
+
+static void winehua_vtest_init_low_map(void)
+{
+   const char *enabled = getenv("WINEHUA_VIRGL_LOW_MAP");
+   void *library;
+
+   if (!enabled || strcmp(enabled, "1"))
+      return;
+   /* The app loads ntdll with RTLD_LOCAL. Look up only that existing module;
+    * never bootstrap Wine or interpose mmap in a non-Wine Mesa client. */
+   library = dlopen("ntdll.so", RTLD_NOW | RTLD_NOLOAD);
+   if (!library)
+      return;
+   winehua_low_map = dlsym(library, "winehua_map_shared_buffer_v1");
+   winehua_low_map_release = dlsym(library, "winehua_unmap_shared_buffer_v1");
+   if (!winehua_low_map || !winehua_low_map_release) {
+      winehua_low_map = NULL;
+      winehua_low_map_release = NULL;
+   }
+   /* Wine owns the resident ntdll for the whole process. Resources store
+    * the paired release callback so cache/destroy never rereads the setting. */
+   dlclose(library);
+}
+#endif
+
+static bool winehua_vtest_try_low_map(struct virgl_hw_res *res,
+                                    enum pipe_texture_target target, int fd)
+{
+#if defined(__OHOS__) && defined(__aarch64__)
+   if (target != PIPE_BUFFER || fd < 0 || !res->size)
+      return false;
+   call_once(&winehua_low_map_once, winehua_vtest_init_low_map);
+   if (!winehua_low_map)
+      return false;
+   res->ptr = winehua_low_map(fd, res->size);
+   if (!res->ptr)
+      return false;
+   res->winehua_map_release = winehua_low_map_release;
+   return true;
+#else
+   return false;
+#endif
+}
