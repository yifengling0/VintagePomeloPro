new file mode 100644
--- /dev/null
+++ b/src/virtio/vulkan/vpp_frame_scene_vk.h
@@ -0,0 +1,27 @@
+/* Optional WineHua scene data, carried with one Vulkan present. */
+#ifndef VPP_FRAME_SCENE_VK_H
+#define VPP_FRAME_SCENE_VK_H
+
+#include <stdint.h>
+
+#define VPP_FRAME_SCENE_PARAM 0x57480103
+#define VPP_FRAME_SCENE_VERSION 1
+#define VPP_FRAME_SCENE_DWORDS 46
+
+struct vpp_frame_scene_data {
+   uint32_t version, size;
+   uint64_t serial, color, depth;
+   uint32_t color_format, color_layout, depth_format, depth_layout, width, height;
+   float view_projection[16], inverse_view_projection[16];
+};
+
+_Static_assert(sizeof(struct vpp_frame_scene_data) == VPP_FRAME_SCENE_DWORDS * 4,
+               "Wine frame scene wire layout");
+
+int vn_winehua_present_scene(VkQueue queue_handle, VkImage image_handle,
+                             uint32_t width, uint32_t height, VkFormat format,
+                             VkImageLayout layout, uint32_t client_pid,
+                             uint32_t surface_id, uint32_t serial,
+                             uint64_t *next_present_deadline_ns,
+                             const struct vpp_frame_scene_data *scene);
+#endif
