+/* Explicit export is necessary after an application already glFlush'ed
+ * outside Wine's surface identity scope. A second GL flush need not consider
+ * the front buffer dirty, and EGL pbuffer SwapBuffers normally does nothing.
+ * Use only the current drawable and its existing front resource. */
+bool
+driWineHuaPresentFrontBuffer(struct dri_drawable *drawable)
+{
+   struct dri_context *ctx = dri_get_current();
+
+   if (!ctx || ctx->draw != drawable || !drawable ||
+       ctx->screen != drawable->screen)
+      return false;
+
+   struct pipe_screen *screen = drawable->screen->base.screen;
+   const char *name = screen->get_name(screen);
+   if (!name || !strstr(name, "virgl") ||
+       (drawable->screen->type != DRI_SCREEN_SWRAST &&
+        drawable->screen->type != DRI_SCREEN_KMS_SWRAST))
+      return true; /* Keep ordinary pbuffer semantics on other drivers. */
+
+   /* Drain CPU work and vertex/bitmap caches without the automatic front
+    * flush. Export exactly once, even after an earlier application glFlush. */
+   _mesa_glthread_finish(ctx->st->ctx);
+   st_context_flush(ctx->st, ST_FLUSH_END_OF_FRAME, NULL, NULL, NULL);
+   if (!drawable->textures[ST_ATTACHMENT_FRONT_LEFT] ||
+       !drawable->flush_frontbuffer)
+      return false;
+
+   return drawable->flush_frontbuffer(ctx, drawable,
+                                     ST_ATTACHMENT_FRONT_LEFT);
+}
