+/* Private bridge entry, discovered by Wine through eglGetProcAddress.
+ * Ordinary EGL pbuffer swap semantics stay unchanged. The caller must hold
+ * Wine's exact surface identity scope; no pixel readback or GPU wait occurs. */
+static EGLBoolean EGLAPIENTRY
+eglWineHuaPresentPbuffer(EGLDisplay dpy, EGLSurface surface)
+{
+   _EGLContext *ctx = _eglGetCurrentContext();
+   _EGLDisplay *disp = _eglLockDisplay(dpy);
+   _EGLSurface *surf = _eglLookupSurface(surface, disp);
+   EGLBoolean ret = EGL_FALSE;
+   const char *present = getenv("WINEHUA_VTEST_PRESENT");
+
+   _EGL_FUNC_START(disp, EGL_OBJECT_SURFACE_KHR, surf);
+   _EGL_CHECK_SURFACE(disp, surf, EGL_FALSE);
+   if (!ctx || surf != ctx->DrawSurface || surf->Type != EGL_PBUFFER_BIT ||
+       !present || !present[0] || !strcmp(present, "0") ||
+       !disp->Driver->WineHuaPresentPbuffer)
+      RETURN_EGL_ERROR(disp, EGL_BAD_MATCH, EGL_FALSE);
+
+   egl_relax (disp, &surf->Resource) {
+      ret = disp->Driver->WineHuaPresentPbuffer(disp, surf);
+   }
+   RETURN_EGL_EVAL(disp, ret);
+}
