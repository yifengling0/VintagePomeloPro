+/* One monotonic budget covers connect, the query and the complete reply. */
+static int64_t dns_now_ms( void )
+{
+    struct timespec ts;
+    if (clock_gettime( CLOCK_MONOTONIC, &ts )) return -1;
+    return (int64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static int dns_wait( int fd, short events, int64_t deadline )
+{
+    struct pollfd pfd = { fd, events, 0 };
+    int ret;
+    int64_t now, remaining;
+
+    for (;;)
+    {
+        if ((now = dns_now_ms()) < 0 || (remaining = deadline - now) <= 0) return -1;
+        pfd.revents = 0;
+        ret = poll( &pfd, 1, remaining > INT_MAX ? INT_MAX : (int)remaining );
+        if (ret < 0 && errno == EINTR) continue;
+        if (ret <= 0 || (pfd.revents & POLLNVAL)) return -1;
+        /* Let getsockopt/recv report pending errors or consume data at EOF. */
+        if (pfd.revents & (events | POLLERR | POLLHUP)) return 0;
+    }
+}
+
+static int dns_transfer( int fd, unsigned char *buf, int len, int writing, int64_t deadline )
+{
+    int done = 0;
+    ssize_t n;
+
+    while (done < len)
+    {
+        if (dns_wait( fd, writing ? POLLOUT : POLLIN, deadline )) return -1;
+        n = writing ? send( fd, buf + done, len - done, MSG_NOSIGNAL ) :
+                      recv( fd, buf + done, len - done, 0 );
+        if (n < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)) continue;
+        if (n <= 0) return -1;
+        done += n;
+    }
+    return 0;
+}
