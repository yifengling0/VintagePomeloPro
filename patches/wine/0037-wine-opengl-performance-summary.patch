+static uint64_t winehua_perf_now(void)
+{
+    struct timespec time;
+    if (clock_gettime(CLOCK_MONOTONIC, &time)) return 0;
+    return (uint64_t)time.tv_sec * 1000000 + time.tv_nsec / 1000;
+}
+
+struct winehua_perf_counter
+{
+    uint64_t count, total_us, max_us, requested, copied, results[5];
+};
+
+struct winehua_perf_state
+{
+    uint64_t window_start;
+    struct winehua_perf_counter counters[WINEHUA_PERF_COUNT];
+};
+
+static __thread struct winehua_perf_state winehua_perf_state;
+
+static uint64_t winehua_perf_add(uint64_t a, uint64_t b)
+{
+    return ~(uint64_t)0 - a < b ? ~(uint64_t)0 : a + b;
+}
+
+static void DECLSPEC_NOINLINE winehua_perf_report(struct winehua_perf_state *state, uint64_t now)
+{
+    unsigned int i;
+
+    /* Wine's debug formatter has a 1024-byte buffer. Emit one bounded
+     * aggregate row per active metric, all in this once-per-second batch.
+     * Even saturated 64-bit fields fit comfortably in each row.
+     * n/us/max_us/requested/copied/ok/waiting/not_started/wrong_thread/error. */
+    for (i = 0; i < WINEHUA_PERF_COUNT; ++i)
+    {
+        const struct winehua_perf_counter *c = &state->counters[i];
+        if (!c->count) continue;
+        TRACE_(winehua_perf)("scope=opengl_unix pid=%lu tid=%lu window_us=%llu %s=%llu/%llu/%llu/%llu/%llu/%llu/%llu/%llu/%llu/%llu\n",
+                (unsigned long)HandleToULong(NtCurrentTeb()->ClientId.UniqueProcess), (unsigned long)HandleToULong(NtCurrentTeb()->ClientId.UniqueThread),
+                (unsigned long long)(now - (state->window_start - 1)), winehua_perf_names[i],
+                (unsigned long long)c->count, (unsigned long long)c->total_us,
+                (unsigned long long)c->max_us, (unsigned long long)c->requested,
+                (unsigned long long)c->copied, (unsigned long long)c->results[0],
+                (unsigned long long)c->results[1], (unsigned long long)c->results[2],
+                (unsigned long long)c->results[3], (unsigned long long)c->results[4]);
+    }
+}
+
+static uint64_t winehua_perf_begin(void)
+{
+    uint64_t now;
+
+    /* Do not even read the clock or TLS when the channel is disabled. */
+    if (!TRACE_ON(winehua_perf)) return 0;
+    now = winehua_perf_now();
+    return now ? now + 1 : 0;
+}
+
+static void winehua_perf_end(enum winehua_perf_metric metric, uint64_t start,
+        uint64_t requested, uint64_t copied, unsigned int result)
+{
+    struct winehua_perf_state *state;
+    struct winehua_perf_counter *counter;
+    uint64_t now, elapsed;
+
+    if (!start) return;
+    state = &winehua_perf_state;
+    now = winehua_perf_now();
+    --start;
+    /* Guard a failed/backwards clock without underflow or a log storm. */
+    if (!now || now < start) return;
+    if (!state->window_start) state->window_start = start + 1;
+    elapsed = now - start;
+    counter = &state->counters[metric];
+    counter->count = winehua_perf_add(counter->count, 1);
+    counter->total_us = winehua_perf_add(counter->total_us, elapsed);
+    if (elapsed > counter->max_us) counter->max_us = elapsed;
+    counter->requested = winehua_perf_add(counter->requested, requested);
+    counter->copied = winehua_perf_add(counter->copied, copied);
+    if (result > 4) result = 4;
+    counter->results[result] = winehua_perf_add(counter->results[result], 1);
+    if (now < state->window_start - 1 || now - (state->window_start - 1) < 1000000) return;
+
+    winehua_perf_report(state, now);
+    memset(state->counters, 0, sizeof(state->counters));
+    state->window_start = now + 1;
+}
+static void *winehua_perf_copy(enum winehua_perf_metric metric, void *dst, const void *src, size_t size)
+{
+    uint64_t perf_start = winehua_perf_begin();
+    void *ret = memcpy(dst, src, size);
+    winehua_perf_end(metric, perf_start, size, size, 0);
+    return ret;
+}
+/* winehua_perf implementation end */
