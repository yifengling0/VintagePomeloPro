+/* Compatibility for internal callers of the old string API. Product child
+ * and wineserver startup below never serialize argv through delimiters. */
+int ohos_broker_spawn(const char *entry_params, const char **fd_names,
+                      const int *fds, int n_fds, int *child_pid)
+{
+    vp_spawn_spec spec = {0};
+    char *copy, *next, *token;
+    const char **argv, **env;
+    int result;
+    if (!entry_params || strnlen(entry_params, VP_PAYLOAD_CAP + 1) > VP_PAYLOAD_CAP ||
+        n_fds < 0 || n_fds > (int)VP_CLIENT_FDS_CAP) return vp_bad(EINVAL);
+    copy = strdup(entry_params);
+    argv = calloc(VP_ITEMS_CAP, sizeof(*argv)); env = calloc(VP_ITEMS_CAP, sizeof(*env));
+    if (!copy || !argv || !env) { free(copy); free(argv); free(env); return vp_bad(ENOMEM); }
+    next = copy; spec.home = ""; spec.bin = strsep(&next, "|");
+    spec.argv = argv; spec.env = env; spec.names = fd_names; spec.fdc = n_fds;
+    while ((token = strsep(&next, "|"))) {
+        if (!strncmp(token, "__env=", 6)) {
+            if (spec.envc >= VP_ITEMS_CAP) goto too_big;
+            env[spec.envc++] = token + 6;
+        } else {
+            if (spec.argc >= VP_ITEMS_CAP) goto too_big;
+            argv[spec.argc++] = token;
+        }
+    }
+    result = broker_spawn_spec(&spec, fds, child_pid);
+    free(copy); free(argv); free(env); return result;
+too_big:
+    free(copy); free(argv); free(env); return vp_bad(E2BIG);
+}

