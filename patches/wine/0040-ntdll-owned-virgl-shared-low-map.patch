+/* Only this opt-in is imported from the child's Windows environment. A BAT
+ * changes that environment, not Unix environ forwarded by the NCP broker.
+ * Run before any DLL initialization/Mesa resource creation, once per process. */
+static void winehua_init_shared_map_environment( const WCHAR *env )
+{
+#if defined(__OHOS__) && defined(__aarch64__) && defined(_WIN64)
+    static const WCHAR name[] = {'W','I','N','E','H','U','A','_','V','I','R','G','L','_','L','O','W','_','M','A','P','=',0};
+    const size_t length = ARRAY_SIZE(name) - 1;
+
+    while (env && *env)
+    {
+        if (!wcsnicmp( env, name, length ))
+        {
+            setenv( "WINEHUA_VIRGL_LOW_MAP", env[length] == '1' && !env[length + 1] ? "1" : "0", 1 );
+            return;
+        }
+        env += wcslen( env ) + 1;
+    }
+    unsetenv( "WINEHUA_VIRGL_LOW_MAP" );
+#endif
+}
+
 static void init_peb( RTL_USER_PROCESS_PARAMETERS *params, void *module )
 {
+    winehua_init_shared_map_environment( params->Environment );
     peb->ImageBaseAddress           = module;
