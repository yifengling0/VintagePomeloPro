--- a/dlls/winewayland.drv/wayland.c
+++ b/dlls/winewayland.drv/wayland.c
@@ -252,6 +252,29 @@
  *  Initialise the per process wayland objects.
  *
  */
+BOOL wayland_sync_input_desktop(HWND hwnd)
+{
+    DWORD pid, tid = NtUserGetWindowThread(hwnd, &pid);
+    HDESK desktop, current;
+
+    /* Explorer loads the driver before moving its shell thread to the virtual
+     * desktop. The already running event thread still belongs to the original
+     * desktop. HWND-routed hardware input selects the right desktop in the
+     * server, but implicit input APIs such as SetCursorPos use this thread's
+     * desktop instead. Follow the focused window before calling those APIs. */
+    if (!tid || pid != GetCurrentProcessId()) return FALSE;
+    if (!(desktop = NtUserGetThreadDesktop(tid))) return FALSE;
+    current = NtUserGetThreadDesktop(GetCurrentThreadId());
+    if (desktop == current) return TRUE;
+    if (!NtUserSetThreadDesktop(desktop))
+    {
+        WARN("input desktop switch failed hwnd=%p thread=%lu desktop=%p\n", hwnd, tid, desktop);
+        return FALSE;
+    }
+    TRACE("input desktop sync hwnd=%p thread=%lu old=%p new=%p\n", hwnd, tid, current, desktop);
+    return TRUE;
+}
