--- /dev/null
+++ b/dlls/nsiproxy.sys/network-route-linux.c
@@ -0,0 +1,132 @@
+/* IPv4 route snapshots for Linux sandboxes which deny /proc/net/route. */
+#if 0
+#pragma makedep unix
+#endif
+#ifdef __linux__
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <linux/netlink.h>
+#include <linux/rtnetlink.h>
+#include "network-route-linux.h"
+
+static int append_route(struct network_ipv4_route **routes, size_t *count,
+                        const struct network_ipv4_route *entry)
+{
+    struct network_ipv4_route *next;
+    size_t i;
+    for (i=0;i<*count;i++) {
+        const struct network_ipv4_route *p=*routes+i;
+        /* Windows has no Linux policy table ID. Preserve unique route fields. */
+        if (p->prefix==entry->prefix && p->gateway==entry->gateway &&
+            p->ifindex==entry->ifindex && p->prefix_len==entry->prefix_len &&
+            p->metric==entry->metric && p->protocol==entry->protocol && p->type==entry->type) return 0;
+    }
+    if (*count >= SIZE_MAX/sizeof(**routes)-1) return ENOMEM;
+    next=realloc(*routes,(*count+1)*sizeof(**routes));
+    if (!next) return ENOMEM;
+    *routes=next;next[(*count)++]=*entry;
+    return 0;
+}
+
+int network_ipv4_parse_routes(const void *data,size_t size,uint32_t sequence,
+                             struct network_ipv4_route **routes,size_t *count,int *done)
+{
+    const struct nlmsghdr *hdr;
+    const struct rtmsg *msg;
+    const struct rtattr *attr;
+    struct network_ipv4_route entry;
+    int remain, attrs, err;
+    if (size>INT32_MAX) return EMSGSIZE;
+    remain=size;
+    for (hdr=data;NLMSG_OK(hdr,remain);hdr=NLMSG_NEXT(hdr,remain)) {
+        if (hdr->nlmsg_seq!=sequence) return EBADMSG;
+        if (hdr->nlmsg_flags & NLM_F_DUMP_INTR) return EAGAIN;
+        if (hdr->nlmsg_type==NLMSG_ERROR) {
+            const struct nlmsgerr *error;
+            if (NLMSG_PAYLOAD(hdr,0)<sizeof(*error)) return EBADMSG;
+            error=NLMSG_DATA(hdr);
+            if (error->error) return error->error<0?-error->error:EBADMSG;
+            continue;
+        }
+        if (hdr->nlmsg_type==NLMSG_DONE) {
+            if (NLMSG_PAYLOAD(hdr,0)>=sizeof(int)) {
+                int result;memcpy(&result,NLMSG_DATA(hdr),sizeof(result));
+                if (result) return result<0?-result:EBADMSG;
+            }
+            *done=1;
+            continue;
+        }
+        if (hdr->nlmsg_type!=RTM_NEWROUTE) continue;
+        if (NLMSG_PAYLOAD(hdr,0)<sizeof(*msg)) return EBADMSG;
+        msg=NLMSG_DATA(hdr);
+        if (msg->rtm_family!=AF_INET || msg->rtm_type!=RTN_UNICAST || msg->rtm_src_len || msg->rtm_tos) continue;
+        if (msg->rtm_dst_len>32) return EBADMSG;
+        memset(&entry,0,sizeof(entry));
+        entry.prefix_len=msg->rtm_dst_len;entry.table=msg->rtm_table;
+        entry.protocol=msg->rtm_protocol;entry.type=msg->rtm_type;
+        attrs=RTM_PAYLOAD(hdr);
+        for (attr=RTM_RTA(msg);RTA_OK(attr,attrs);attr=RTA_NEXT(attr,attrs)) {
+            uint32_t *value=NULL;
+            switch (attr->rta_type) {
+            case RTA_DST:value=&entry.prefix;break;
+            case RTA_GATEWAY:value=&entry.gateway;break;
+            case RTA_OIF:value=&entry.ifindex;break;
+            case RTA_PRIORITY:value=&entry.metric;break;
+            case RTA_TABLE:value=&entry.table;break;
+            case RTA_MULTIPATH:case RTA_VIA:return ENOTSUP;
+            }
+            if (value) {
+                if (RTA_PAYLOAD(attr)!=sizeof(*value)) return EBADMSG;
+                memcpy(value,RTA_DATA(attr),sizeof(*value));
+            }
+        }
+        if (attrs) return EBADMSG;
+        if (!entry.ifindex || entry.table==RT_TABLE_UNSPEC || entry.table==RT_TABLE_LOCAL) continue;
+#ifndef __OHOS__
+        /* Conventional Wine uses the main routing table. OHOS networks use
+         * real per-network policy tables instead of a populated main table. */
+        if (entry.table!=RT_TABLE_MAIN) continue;
+#endif
+        if ((err=append_route(routes,count,&entry))) return err;
+    }
+    return remain ? EBADMSG : 0;
+}
+
+int network_ipv4_routes(struct network_ipv4_route **routes,size_t *count)
+{
+    struct sockaddr_nl kernel={.nl_family=AF_NETLINK},sender;
+    struct timeval timeout={2,0};
+    struct {struct nlmsghdr hdr;struct rtmsg msg;} request={
+        .hdr={.nlmsg_len=NLMSG_LENGTH(sizeof(struct rtmsg)),.nlmsg_type=RTM_GETROUTE,
+              .nlmsg_flags=NLM_F_REQUEST|NLM_F_DUMP,.nlmsg_seq=0x77696e65},
+        .msg={.rtm_family=AF_INET}};
+    union {struct nlmsghdr alignment;char bytes[65536];} buffer;
+    int fd,err=0,done=0;
+    ssize_t length;
+    *routes=NULL;*count=0;
+    fd=socket(AF_NETLINK,SOCK_RAW|SOCK_CLOEXEC,NETLINK_ROUTE);
+    if (fd<0) return errno;
+    if (setsockopt(fd,SOL_SOCKET,SO_RCVTIMEO,&timeout,sizeof(timeout))) {err=errno;goto end;}
+    do length=sendto(fd,&request,sizeof(request),0,(struct sockaddr *)&kernel,sizeof(kernel));
+    while (length<0 && errno==EINTR);
+    if (length!=sizeof(request)) {err=length<0?errno:EIO;goto end;}
+    while (!done) {
+        struct iovec iov={buffer.bytes,sizeof(buffer.bytes)};
+        struct msghdr msg={.msg_name=&sender,.msg_namelen=sizeof(sender),.msg_iov=&iov,.msg_iovlen=1};
+        do length=recvmsg(fd,&msg,0);while (length<0 && errno==EINTR);
+        if (length<0) {err=errno;break;}
+        if (!length || msg.msg_flags & MSG_TRUNC) {err=EMSGSIZE;break;}
+        if (msg.msg_namelen!=sizeof(sender) || sender.nl_family!=AF_NETLINK || sender.nl_pid) {err=EBADMSG;break;}
+        err=network_ipv4_parse_routes(buffer.bytes,length,request.hdr.nlmsg_seq,routes,count,&done);
+        if (err) break;
+    }
+end:
+    close(fd);
+    if (err) {free(*routes);*routes=NULL;*count=0;}
+    return err;
+}
+#endif
