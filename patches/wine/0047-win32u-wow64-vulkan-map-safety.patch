+/* The generated thunks retain client memory identities for these calls.
+ * Flush publishes CPU writes before the driver flush; invalidate imports
+ * GPU writes only after the driver invalidate has completed successfully. */
+static BOOL winehua_wow64_copy_range( struct device_memory *memory, const VkMappedMemoryRange *range, BOOL upload )
+{
+#ifdef _WIN64
+    VkDeviceSize offset, size;
+    if (!memory->wow64_copy) return TRUE;
+    if (range->offset < memory->map_offset || range->offset >= memory->size) return FALSE;
+    offset = range->offset - memory->map_offset;
+    size = range->size == VK_WHOLE_SIZE ? memory->map_size - offset : range->size;
+    if (offset > memory->map_size || size > memory->map_size - offset) return FALSE;
+    if (upload) memcpy( (char *)memory->host_map + offset, (char *)memory->vm_map + offset, size );
+    else memcpy( (char *)memory->vm_map + offset, (char *)memory->host_map + offset, size );
+#endif
+    return TRUE;
+}
+
+static VkResult win32u_vkFlushMappedMemoryRanges( VkDevice client_device, uint32_t count, const VkMappedMemoryRange *ranges )
+{
+    struct vulkan_device *device = vulkan_device_from_handle( client_device );
+    VkMappedMemoryRange *host_ranges;
+    VkResult res;
+    uint32_t i;
+
+    if (!(host_ranges = malloc( count * sizeof(*host_ranges) ))) return VK_ERROR_OUT_OF_HOST_MEMORY;
+    for (i = 0; i < count; i++)
+    {
+        struct device_memory *memory = device_memory_from_handle( ranges[i].memory );
+        if (!winehua_wow64_copy_range( memory, ranges + i, TRUE ))
+        {
+            free( host_ranges );
+            return VK_ERROR_MEMORY_MAP_FAILED;
+        }
+        host_ranges[i] = ranges[i];
+        host_ranges[i].memory = memory->obj.host.device_memory;
+    }
+    res = device->p_vkFlushMappedMemoryRanges( device->host.device, count, host_ranges );
+    free( host_ranges );
+    return res;
+}
+
+static VkResult win32u_vkInvalidateMappedMemoryRanges( VkDevice client_device, uint32_t count, const VkMappedMemoryRange *ranges )
+{
+    struct vulkan_device *device = vulkan_device_from_handle( client_device );
+    VkMappedMemoryRange *host_ranges;
+    VkResult res;
+    uint32_t i;
+
+    if (!(host_ranges = malloc( count * sizeof(*host_ranges) ))) return VK_ERROR_OUT_OF_HOST_MEMORY;
+    for (i = 0; i < count; i++)
+    {
+        host_ranges[i] = ranges[i];
+        host_ranges[i].memory = device_memory_from_handle( ranges[i].memory )->obj.host.device_memory;
+    }
+    res = device->p_vkInvalidateMappedMemoryRanges( device->host.device, count, host_ranges );
+    if (res == VK_SUCCESS)
+        for (i = 0; i < count; i++)
+            if (!winehua_wow64_copy_range( device_memory_from_handle( ranges[i].memory ), ranges + i, FALSE ))
+            {
+                res = VK_ERROR_MEMORY_MAP_FAILED;
+                break;
+            }
+    free( host_ranges );
+    return res;
+}
 
