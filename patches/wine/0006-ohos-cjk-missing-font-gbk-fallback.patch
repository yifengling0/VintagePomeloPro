From: VintagePomeloPro
Subject: [PATCH] ohos: CJK missing-font fallback for GBK titles

Missing face names must not walk the family tree onto the Noto CJK JP
face, and CJK faces registered from the device must keep the locale charm
mapping. Only the face-selection half of the original patch is kept: the
forced ACP codepage rewrite was written for the GBK-as-Shift-JIS theory and
was removed (patches 0007/0009/0011 were dropped for the same reason) - the
real fix for masking engines is 0010.

diff --git a/dlls/win32u/font.c b/dlls/win32u/font.c
--- a/dlls/win32u/font.c
+++ b/dlls/win32u/font.c
@@ -1206,6 +1206,103 @@
     return NULL;
 }
 
+static BOOL wchar_contains_ascii_i( const WCHAR *s, const char *ascii )
+{
+    int n, i;
+
+    if (!s || !ascii || !ascii[0]) return FALSE;
+    n = (int)strlen( ascii );
+    for ( ; *s; s++ )
+    {
+        for (i = 0; i < n; i++)
+        {
+            WCHAR c = s[i];
+            unsigned char a = (unsigned char)ascii[i];
+            if (!c) break;
+            if (c >= 'A' && c <= 'Z') c += 32;
+            if (a >= 'A' && a <= 'Z') a += 32;
+            if (c != a) break;
+        }
+        if (i == n) return TRUE;
+    }
+    return FALSE;
+}
+
+#ifdef __OHOS__
+static BOOL ohos_is_c_unix_locale( const char *name )
+{
+    return !name || !name[0] || !strcmp( name, "C" ) || !strcmp( name, "POSIX" )
+        || !strncmp( name, "C.", 2 ) || !strncmp( name, "POSIX.", 6 );
+}
+
+/* HarmonyOS musl often leaves Wine ACP at 1252 (C.UTF-8). The process is still
+ * launched with LANG=zh_CN.UTF-8; honor that so DEFAULT_CHARSET faces do not
+ * realize SHIFTJIS and decode GBK TextOutA as Japanese. */
+static UINT ohos_effective_ansi_cp(void)
+{
+    const char *lang;
+    UINT acp = ansi_cp.CodePage;
+
+    /* A prefix created in another language can retain its old ACP. An
+     * explicit launch locale must win for TextOutA and fallback matching. */
+    lang = getenv( "LC_ALL" );
+    if (ohos_is_c_unix_locale( lang )) lang = getenv( "LANG" );
+    if (lang)
+    {
+        if (!strncmp( lang, "en_US", 5 ) || !strncmp( lang, "en-US", 5 ))
+            return 1252;
+        if (!strncmp( lang, "zh_CN", 5 ) || !strncmp( lang, "zh_Hans", 7 ) ||
+            !strncmp( lang, "zh-CN", 5 ) || !strncmp( lang, "zh-Hans", 7 ))
+            return 936;
+        if (!strncmp( lang, "zh_TW", 5 ) || !strncmp( lang, "zh_HK", 5 ) ||
+            !strncmp( lang, "zh_MO", 5 ) || !strncmp( lang, "zh_Hant", 7 ) ||
+            !strncmp( lang, "zh-TW", 5 ) || !strncmp( lang, "zh-HK", 5 ) ||
+            !strncmp( lang, "zh-MO", 5 ) || !strncmp( lang, "zh-Hant", 7 ))
+            return 950;
+        if (!strncmp( lang, "ja", 2 ))
+            return 932;
+    }
+    if (acp == 932 || acp == 936 || acp == 950) return acp;
+    /* Product default is Simplified Chinese when no locale was selected. */
+    return 936;
+}
+#else
+static UINT ohos_effective_ansi_cp(void)
+{
+    return ansi_cp.CodePage;
+}
+#endif
+
+/* Noto CJK TTC registers JP first. Keep those system faces off Chinese ACPs
+ * so missing CreateFont names do not realize SHIFTJIS and GBK-decode as 932. */
+static BOOL ohos_skip_foreign_cjk_face( const WCHAR *family, const WCHAR *full )
+{
+#ifdef __OHOS__
+    const WCHAR *names[2];
+    unsigned int i, acp = ohos_effective_ansi_cp();
+
+    if (acp != 936 && acp != 950) return FALSE;
+    names[0] = family;
+    names[1] = full;
+    for (i = 0; i < ARRAY_SIZE(names); i++)
+    {
+        if (!names[i]) continue;
+        if (wchar_contains_ascii_i( names[i], "CJK JP" )) return TRUE;
+        if (wchar_contains_ascii_i( names[i], "CJK KR" )) return TRUE;
+        if (wchar_contains_ascii_i( names[i], "CJKJP" )) return TRUE;
+        if (wchar_contains_ascii_i( names[i], "CJKKR" )) return TRUE;
+        if (wchar_contains_ascii_i( names[i], "Noto Sans JP" )) return TRUE;
+        if (wchar_contains_ascii_i( names[i], "Noto Serif JP" )) return TRUE;
+        if (wchar_contains_ascii_i( names[i], "Noto Sans KR" )) return TRUE;
+        if (wchar_contains_ascii_i( names[i], "Noto Serif KR" )) return TRUE;
+    }
+#else
+    (void)family;
+    (void)full;
+#endif
+    return FALSE;
+}
+
 int add_gdi_face( const WCHAR *family_name, const WCHAR *second_name,
                   const WCHAR *style, const WCHAR *fullname, const WCHAR *file,
                   void *data_ptr, SIZE_T data_size, UINT index, FONTSIGNATURE fs,
@@ -1216,6 +1313,14 @@
     struct gdi_font_family *family;
     int ret = 0;
 
+    if ((flags & ADDFONT_EXTERNAL_FONT) &&
+        ohos_skip_foreign_cjk_face( family_name, fullname ))
+    {
+        TRACE( "skipping non-locale CJK face %s (%s)\n",
+               debugstr_w(family_name), debugstr_w(fullname) );
+        return 0;
+    }
+
     if ((family = find_family_from_name( family_name ))) family->refcount++;
     else if (!(family = create_family( family_name, second_name ))) return ret;
 
@@ -2263,6 +2368,50 @@
     return NULL;
 }
 
+static struct gdi_font_face *find_locale_fallback_face( const LOGFONTW *lf, BOOL can_use_bitmap )
+{
+    /* 鸿蒙黑体 — HarmonyOS_Sans_SC.ttf's registered localized family. */
+    static const WCHAR sc_harmonyW[] = { 0x9e3f, 0x8499, 0x9ed1, 0x4f53, 0 };
+    static const WCHAR sc_harmony_enW[] =
+        {'H','a','r','m','o','n','y','O','S',' ','S','a','n','s',' ','S','C',0};
+    static const WCHAR sc_notoW[] =
+        {'N','o','t','o',' ','S','a','n','s',' ','C','J','K',' ','S','C',0};
+    /* HarmonyOS_Sans_TC.ttf registers as 鴻蒙黑體 on this device. */
+    static const WCHAR tc_harmonyW[] = { 0x9d3b, 0x8499, 0x9ed1, 0x9ad4, 0 };
+    static const WCHAR tc_harmony_enW[] =
+        {'H','a','r','m','o','n','y','O','S',' ','S','a','n','s',' ','T','C',0};
+    static const WCHAR tc_notoW[] =
+        {'N','o','t','o',' ','S','a','n','s',' ','C','J','K',' ','T','C',0};
+    const WCHAR *names[4];
+    FONTSIGNATURE any_fs = {{0}};
+    unsigned int i, n = 0;
+    struct gdi_font_face *face;
+
+    switch (ohos_effective_ansi_cp())
+    {
+    case 936:
+        names[n++] = sc_harmonyW;
+        names[n++] = sc_harmony_enW;
+        names[n++] = sc_notoW;
+        break;
+    case 950:
+        names[n++] = tc_harmonyW;
+        names[n++] = tc_harmony_enW;
+        names[n++] = tc_notoW;
+        names[n++] = sc_harmonyW;
+        break;
+    default:
+        return NULL;
+    }
+
+    for (i = 0; i < n; i++)
+    {
+        if ((face = find_matching_face_by_name( names[i], NULL, lf, any_fs, can_use_bitmap, NULL )))
+            return face;
+    }
+    return NULL;
+}
+
 static struct gdi_font_face *find_matching_face( const LOGFONTW *lf, CHARSETINFO *csi, BOOL can_use_bitmap,
                                                  BOOL *substituted, const WCHAR **orig_name )
 {
@@ -2298,13 +2447,17 @@
        corresponding to the current ansi codepage */
     if (!csi->fs.fsCsb[0])
     {
-        if (!translate_charset_info( (DWORD *)(INT_PTR)ansi_cp.CodePage, csi, TCI_SRCCODEPAGE ))
+        if (!translate_charset_info( (DWORD *)(INT_PTR)ohos_effective_ansi_cp(), csi, TCI_SRCCODEPAGE ))
         {
-            FIXME( "TCI failed on codepage %d\n", ansi_cp.CodePage );
+            FIXME( "TCI failed on codepage %d\n", ohos_effective_ansi_cp() );
             csi->fs.fsCsb[0] = 0;
         }
     }
 
+    /* Missing face names (game font\*.ttf not installed) must not walk the
+     * family tree and land on Noto CJK JP. Prefer the locale UI face first. */
+    if ((face = find_locale_fallback_face( lf, can_use_bitmap ))) return face;
+
     if ((face = find_any_face( lf, csi->fs, can_use_bitmap, want_vertical ))) return face;
     if (csi->fs.fsCsb[0])
     {
@@ -4396,13 +4549,25 @@
 
     int i;
 
-    if (translate_charset_info( (DWORD*)(INT_PTR)ansi_cp.CodePage, csi, TCI_SRCCODEPAGE ))
+    if (translate_charset_info( (DWORD*)(INT_PTR)ohos_effective_ansi_cp(), csi, TCI_SRCCODEPAGE ))
     {
         const struct gdi_font_link *font_link;
 
         if (csi->fs.fsCsb[0] & face->fs.fsCsb[0]) return;
         font_link = find_gdi_font_link(family_name);
         if (font_link && (csi->fs.fsCsb[0] & font_link->fs.fsCsb[0])) return;
+
+        /* Keep A-API conversion on the process ANSI codepage. Noto CJK JP's
+         * OS/2 bits make the first-fsCsb walk below pick SHIFTJIS, which turns
+         * GBK TextOutA into mojibake even when the glyphs exist. */
+        switch (csi->ciACP)
+        {
+        case 932:
+        case 936:
+        case 949:
+        case 950:
+            return;
+        }
     }
     for (i = 0; i < 32; i++)
     {
@@ -4416,7 +4581,7 @@
 
     FIXME("returning DEFAULT_CHARSET face->fs.fsCsb[0] = %08x file = %s\n",
 	  face->fs.fsCsb[0], debugstr_w(face->file));
-    csi->ciACP = ansi_cp.CodePage;
+    csi->ciACP = ohos_effective_ansi_cp();
     csi->ciCharset = DEFAULT_CHARSET;
 }
 
@@ -4457,6 +4622,5 @@
     if (!csi.fs.fsCsb[0]) get_nearest_charset( face->family->family_name, face, &csi );
     font->charset = csi.ciCharset;
     font->codepage = csi.ciACP;
-
     TRACE( "Chosen: %s (%s/%p:%u)\n", debugstr_w(face->full_name), debugstr_w(face->file),
            face->data_ptr, face->face_index );
