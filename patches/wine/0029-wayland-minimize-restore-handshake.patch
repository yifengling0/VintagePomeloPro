diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -241,6 +241,7 @@
     double scale;
     BOOL visible;
     BOOL managed;
+    BOOL minimized;
 };

 struct wayland_client_surface
@@ -296,6 +297,7 @@

     struct wayland_surface_config pending, requested, processing, current;
     BOOL resizing;
+    BOOL minimize_requested;
     struct wayland_window_config window;
     int content_width, content_height;
     BOOL has_contents;
diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -162,6 +162,7 @@
     conf->rect = data->rects.window;
     conf->client_rect = data->rects.client;
     style = NtUserGetWindowLongW(data->hwnd, GWL_STYLE);
+    conf->minimized = !!(style & WS_MINIMIZE);

     TRACE("window=%s style=%#x\n", wine_dbgstr_rect(&conf->rect), style);

@@ -265,6 +266,21 @@
           surface->hwnd, surface->window.state,
           processing_config ? "processing" : "current",
           processing_config ? surface->processing.state : surface->current.state);
+
+    /* A Win32 minimize retains the surface role and fullscreen placement.
+     * Inform the compositor once, including for client-only GL/Vulkan windows.
+     * A pending configure must not turn this into an unset_fullscreen request. */
+    if (surface->window.minimized)
+    {
+        if (!surface->minimize_requested)
+        {
+            xdg_toplevel_set_minimized(surface->xdg_toplevel);
+            surface->minimize_requested = TRUE;
+        }
+        if (processing_config) surface->processing.processed = TRUE;
+        return;
+    }
+    surface->minimize_requested = FALSE;

     /* If we are not processing a compositor requested config, use the
      * window state to determine and update the Wayland state. */
@@ -567,6 +583,22 @@
     surface->processing = surface->requested;
     memset(&surface->requested, 0, sizeof(surface->requested));

+    /* OHOS restores a minimized toplevel with a 0x0 configure, leaving the
+     * original placement to Win32. Ack other pending size/configure messages
+     * without touching the offscreen minimized geometry. Never hold win_data
+     * across SC_RESTORE: it synchronously runs WindowPosChanged again. */
+    if (surface->window.minimized)
+    {
+        BOOL restore = surface->minimize_requested && surface->current.serial &&
+                       !surface->processing.width && !surface->processing.height;
+        surface->current = surface->processing;
+        memset(&surface->processing, 0, sizeof(surface->processing));
+        xdg_surface_ack_configure(surface->xdg_surface, surface->current.serial);
+        wayland_win_data_release(data);
+        if (restore) send_message(hwnd, WM_SYSCOMMAND, SC_RESTORE, 0);
+        return;
+    }
+
     state = surface->processing.state;
     /* Ignore size hints if we don't have a state that requires strict
      * size adherence, in order to avoid spurious resizes. */
diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -578,6 +578,7 @@
     surface->content_width = 0;
     surface->content_height = 0;
     surface->has_contents = FALSE;
+    surface->minimize_requested = FALSE;

     wl_display_flush(process_wayland.wl_display);
 }
