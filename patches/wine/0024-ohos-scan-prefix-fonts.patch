From: VintagePomeloPro
Subject: [PATCH] win32u: discover imported fonts through OHOS prefix paths

Valve overlay; preserve upstream behavior outside __OHOS__.

diff --git a/dlls/win32u/freetype.c b/dlls/win32u/freetype.c
--- a/dlls/win32u/freetype.c
+++ b/dlls/win32u/freetype.c
@@ -1560,6 +1560,28 @@
     return FALSE;
 }
 
+#ifdef __OHOS__
+static void load_ohos_windows_fonts(void)
+{
+    const char *prefix = getenv( "WINEPREFIX" );
+    char font_dir[PATH_MAX];
+    int len;
+
+    /* C:\windows\fonts is reached through the DOS drive map. That scan does
+     * not yield user-imported TTFs in the NAPI sandbox, while POSIX opendir
+     * of the same directory (as used for /system/fonts) does. */
+    if (!prefix || !prefix[0])
+        prefix = "/data/storage/el2/base/files/.wine";
+
+    len = snprintf( font_dir, sizeof(font_dir), "%s/drive_c/windows/fonts", prefix );
+    if (len > 0 && (size_t)len < sizeof(font_dir))
+        ReadFontDir( font_dir, FALSE );
+    len = snprintf( font_dir, sizeof(font_dir), "%s/drive_c/windows/Fonts", prefix );
+    if (len > 0 && (size_t)len < sizeof(font_dir))
+        ReadFontDir( font_dir, FALSE );
+}
+#endif
+
 /*************************************************************
  * freetype_load_fonts
  */
@@ -1586,6 +1608,9 @@
     load_mac_fonts();
 #elif defined(__ANDROID__)
     ReadFontDir("/system/fonts", TRUE);
+#endif
+#ifdef __OHOS__
+    load_ohos_windows_fonts();
 #endif
 }
 
