+++ b/dlls/wineohos.drv/ohos_audio_mix.h
@@ -0,0 +1,79 @@
+/* Shared-mode speaker downmix. Kept independent of Wine for native contract tests.
+ * SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef OHOS_AUDIO_MIX_H
+#define OHOS_AUDIO_MIX_H
+
+#define OHOS_AUDIO_MAX_CHANNELS 18
+#define OHOS_AUDIO_SPEAKER_MASK 0x3ffffu
+
+static unsigned int ohos_audio_default_mask(unsigned int channels)
+{
+    switch (channels)
+    {
+    case 1: return 0x4;     /* mono */
+    case 2: return 0x3;     /* stereo */
+    case 3: return 0xb;     /* stereo + LFE, as in winepulse */
+    case 4: return 0x33;    /* quad */
+    case 5: return 0x3b;    /* quad + LFE */
+    case 6: return 0x3f;    /* 5.1 */
+    case 7: return 0x13f;   /* 5.1 + back center */
+    case 8: return 0x63f;   /* 7.1 surround */
+    case 12: return 0x2d63f; /* 7.1.4 */
+    case 18: return OHOS_AUDIO_SPEAKER_MASK;
+    default: return 0;
+    }
+}
+
+static unsigned int ohos_audio_resolve_mask(unsigned int channels, unsigned int mask)
+{
+    unsigned int bits, count = 0;
+    if (!channels || channels > OHOS_AUDIO_MAX_CHANNELS) return 0;
+    if (!mask) mask = ohos_audio_default_mask(channels);
+    if (!mask || (mask & ~OHOS_AUDIO_SPEAKER_MASK)) return 0;
+    for (bits = mask; bits; bits &= bits - 1) ++count;
+    return count == channels ? mask : 0;
+}
+
+static int ohos_audio_build_matrix(unsigned int channels, unsigned int mask,
+                                  float matrix[OHOS_AUDIO_MAX_CHANNELS][2])
+{
+    unsigned int speaker, channel = 0, i;
+    mask = ohos_audio_resolve_mask(channels, mask);
+    if (!mask) return 0;
+    for (i = 0; i < OHOS_AUDIO_MAX_CHANNELS; ++i) matrix[i][0] = matrix[i][1] = 0.0f;
+    for (speaker = 0; speaker < OHOS_AUDIO_MAX_CHANNELS; ++speaker)
+    {
+        float left = 0.0f, right = 0.0f;
+        if (!(mask & (1u << speaker))) continue;
+        switch (speaker)
+        {
+        case 0: left = 1.0f; break;  /* front left */
+        case 1: right = 1.0f; break; /* front right */
+        case 2: left = right = channels == 1 ? 1.0f : 0.70710678f; break;
+        case 3: left = right = 0.5f; break; /* LFE */
+        case 4: case 6: case 9: case 12: case 15: left = 0.70710678f; break;
+        case 5: case 7: case 10: case 14: case 17: right = 0.70710678f; break;
+        default: left = right = 0.5f; break; /* back/top centers */
+        }
+        matrix[channel][0] = left;
+        matrix[channel][1] = right;
+        ++channel;
+    }
+    /* Preserve unity gain on front L/R even when the endpoint exposes unused
+     * surround channels. Limit only actual over-range sums at output. */
+    return 1;
+}
+/* Linked peak limiting preserves stereo balance. Unlike a fixed channel-count
+ * divisor, in-range stereo content in a surround stream stays unchanged. */
+static void ohos_audio_limit_stereo(float *left, float *right)
+{
+    float peak = *left < 0.0f ? -*left : *left;
+    float right_peak = *right < 0.0f ? -*right : *right;
+    if (right_peak > peak) peak = right_peak;
+    if (peak > 1.0f)
+    {
+        *left /= peak;
+        *right /= peak;
+    }
+}
+#endif
