Subject: [PATCH] wine ci compatibility backfills

Upstream commits

winegstreamer: Preserve sign of stride from 2D buffer.
  Brendan McGrath <bmcgrath@codeweavers.com>
  https://github.com/wine-mirror/wine/commit/069ed0297ae2caec91e0fd7ef4704a5e1a41615d
xaudio2: Release the correct lock on failure in CreateSourceVoice().
  Elizabeth Figura <zfigura@codeweavers.com>
  https://github.com/wine-mirror/wine/commit/b68ea3b878e2b8c609b62d0e69b9fbff058a9918
winex11.drv: Flush display in acquire_selection().
  Paul Gofman <pgofman@codeweavers.com>
  https://github.com/wine-mirror/wine/commit/a33000a6a0fec3cf295fe20821aa62779ddaea8c
dinput: Only wait for the input thread to complete cleanup.
  Conor McCarthy <cmccarthy@codeweavers.com>
  https://github.com/wine-mirror/wine/commit/9eb4614ad7a021758af39656bc68d88fa5cfbdb3
dinput/tests: Test setting two actions with the same control identifier.
  Zhiyi Zhang <zzhang@codeweavers.com>
  https://github.com/ValveSoftware/wine/commit/4fd4ab8185a642442c84630c9e98fc9d8d3a8f7b
dinput: Check device GUID in init_object_app_data().
  Zhiyi Zhang <zzhang@codeweavers.com>
  https://github.com/ValveSoftware/wine/commit/0a77c2f4c636cead102bacdf53436d59c49101fa
windows.gaming.input: Allow gamepad added callback to be registered before initializing providers.
  Brendan McGrath <bmcgrath@codeweavers.com>
  https://github.com/ValveSoftware/wine/commit/40760f8c8043944bf7d4eeef3a167de2a6108537
mf/sar: Move audio renderer flush actions inside the conditional code block for active state.
  Conor McCarthy <cmccarthy@codeweavers.com>
  https://github.com/wine-mirror/wine/commit/53b53452519549240dbca2db69faa20e6627fae8
mf/sar: Check for null audio client before resetting during flush.
  Conor McCarthy <cmccarthy@codeweavers.com>
  https://github.com/wine-mirror/wine/commit/37fd158bfc4692183c4583cb8af43b0447dd885d

diff --git a/dlls/dinput/device.c b/dlls/dinput/device.c
index 6748ec6..0d8589b 100644
--- a/dlls/dinput/device.c
+++ b/dlls/dinput/device.c
@@ -1966,6 +1966,7 @@ static BOOL init_object_app_data( struct dinput_device *device, UINT index, stru
     while (action-- > format->rgoAction)
     {
         if (action->dwObjID != instance->dwType) continue;
+        if (!IsEqualGUID( &action->guidInstance, &device->guid )) continue;
         properties->app_data = action->uAppData;
         break;
     }
diff --git a/dlls/dinput/dinput_main.c b/dlls/dinput/dinput_main.c
index 9220ad2..593d9a8 100644
--- a/dlls/dinput/dinput_main.c
+++ b/dlls/dinput/dinput_main.c
@@ -73,6 +73,7 @@ static HWND di_em_win;
 static HANDLE dinput_thread;
 static UINT input_thread_user_count;
 static struct input_thread_state *input_thread_state;
+static HANDLE stop_event;
 
 static CRITICAL_SECTION dinput_hook_crit;
 static CRITICAL_SECTION_DEBUG dinput_critsect_debug =
@@ -424,6 +425,8 @@ static DWORD WINAPI dinput_thread_proc( void *params )
     DestroyWindow( di_em_win );
     di_em_win = NULL;
 
+    if (stop_event) SetEvent( stop_event );
+
     if (this_module != NULL) FreeLibraryAndExitThread( this_module, 0 );
     return 0;
 }
@@ -485,8 +488,11 @@ void input_thread_remove_user(void)
     {
         TRACE( "Stopping input thread.\n" );
 
+        if (!(stop_event = CreateEventW( NULL, FALSE, FALSE, NULL )))
+            ERR( "Failed to create stop event, error %lu\n", GetLastError() );
         SendMessageW( di_em_win, INPUT_THREAD_NOTIFY, NOTIFY_THREAD_STOP, 0 );
-        WaitForSingleObject( dinput_thread, INFINITE );
+        WaitForSingleObject( stop_event, INFINITE );
+        CloseHandle( stop_event );
         CloseHandle( dinput_thread );
         dinput_thread = NULL;
     }
