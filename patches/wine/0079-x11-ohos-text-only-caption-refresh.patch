+/* WM_SETTEXT changes only glyphs, not system buttons, icon, frame or menus.
+ * Repainting their themed user callbacks synchronously costs > one refresh on
+ * OHOS/X11 and stalls the game's render thread. Other NC paint messages still
+ * repaint everything, so activation, theme/style and menu changes stay live.
+ * No persistent bitmap cache or per-window lifetime state is introduced. */
+static BOOL repaint_nc_caption_text( HWND hwnd )
+{
+#ifdef __OHOS__
+    const char *route = getenv( "WINEHUA_DISPLAY_ROUTE" );
+    const char *enabled = getenv( "WINEHUA_CSD_TEXT_ONLY" );
+    DWORD style, ex_style;
+    WORD flags;
+    RECT rect, screen;
+    HRGN region;
+    HDC hdc;
+    WND *win;
+
+    if (!route || strcmp( route, "x11" ) || (enabled && !strcmp( enabled, "0" ))) return FALSE;
+    if (!(win = get_win_ptr( hwnd )) || win == WND_OTHER_PROCESS) return FALSE;
+    style = win->dwStyle; ex_style = win->dwExStyle; flags = win->flags;
+    release_win_ptr( win );
+    if (!(style & WS_VISIBLE) || (style & WS_CAPTION) != WS_CAPTION ||
+        (style & WS_MINIMIZE) || (ex_style & WS_EX_LAYOUTRTL)) return FALSE;
+
+    get_inside_rect( hwnd, COORDS_WINDOW, &rect, style, ex_style );
+    rect.bottom = rect.top + get_system_metrics( (ex_style & WS_EX_TOOLWINDOW) ?
+                                                 SM_CYSMCAPTION : SM_CYCAPTION ) - 1;
+    if ((style & WS_SYSMENU) && !(ex_style & WS_EX_TOOLWINDOW) && get_nc_icon_for_window( hwnd ))
+        rect.left += get_system_metrics( SM_CXSMICON ) + 2;
+    if (style & WS_SYSMENU) {
+        const int size = caption_button_size() + 2;
+        rect.right -= size;
+        if (style & (WS_MAXIMIZEBOX | WS_MINIMIZEBOX)) rect.right -= 2 * size;
+    }
+    if (rect.right <= rect.left || rect.bottom <= rect.top) return FALSE;
+
+    get_window_rect_rel( hwnd, COORDS_SCREEN, &screen, get_thread_dpi() );
+    region = NtGdiCreateRectRgn( screen.left + rect.left, screen.top + rect.top,
+                                screen.left + rect.right, screen.top + rect.bottom );
+    if (!region) return FALSE;
+    hdc = NtUserGetDCEx( hwnd, region, DCX_USESTYLE | DCX_WINDOW | DCX_INTERSECTRGN );
+    if (!hdc) { NtGdiDeleteObjectApp( region ); return FALSE; }
+    draw_nc_caption( hdc, &rect, hwnd, style, ex_style, flags & WIN_NCACTIVATED, TRUE );
+    NtUserReleaseDC( hwnd, hdc ); /* The DC owns and releases region. */
+    HWND parent = NtUserGetAncestor( hwnd, GA_PARENT );
+    if (parent == get_desktop_window())
+        NtUserPostMessage( parent, WM_PARENTNOTIFY, WM_NCPAINT, (LPARAM)hwnd );
+    return TRUE;
+#else
+    return FALSE;
+#endif
 }
 
