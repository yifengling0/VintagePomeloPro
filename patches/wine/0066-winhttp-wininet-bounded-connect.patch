+/* Called only before the request owns a socket or sends any HTTP bytes.
+ * This function consumes the candidate list, including on failure. */
+DWORD netconn_create_multi( struct hostdata *host, const struct sockaddr_storage *cached,
+                            struct netconn_address *addresses, INTERNET_PORT port,
+                            int resolve_timeout, int timeout, struct netconn **ret_conn )
+{
+    struct netconn_address *entry;
+    ULONGLONG start = GetTickCount64(), deadline = timeout > 0 ? start + timeout : 0, now;
+    DWORD ret = ERROR_WINHTTP_CANNOT_CONNECT;
+    unsigned int candidate = 0;
+    int remaining = timeout;
+
+    *ret_conn = NULL;
+    if (!addresses)
+    {
+        /* A cached endpoint is only attempted once. A TCP failure permits a
+         * fresh lookup, never a TLS/HTTP failure or a replay of sent data. */
+        ret = netconn_create( host, cached, remaining, ret_conn );
+        TRACE( "candidate=%u family=%u elapsed=%I64u error=%lu cached=1\n",
+               candidate++, cached->ss_family, GetTickCount64() - start, ret );
+        if (!ret || (ret != ERROR_WINHTTP_CANNOT_CONNECT && ret != ERROR_WINHTTP_TIMEOUT)) return ret;
+        if (timeout > 0)
+        {
+            now = GetTickCount64();
+            if (now >= deadline) return ERROR_WINHTTP_TIMEOUT;
+            remaining = deadline - now;
+            if (resolve_timeout <= 0 || resolve_timeout > remaining) resolve_timeout = remaining;
+        }
+        if ((ret = netconn_resolve( host->hostname, port, &addresses, resolve_timeout ))) return ret;
+        ret = ERROR_WINHTTP_CANNOT_CONNECT;
+    }
+    else cached = NULL;
+
+    for (entry = addresses; entry; entry = entry->next)
+    {
+        if (cached && same_address( cached, &entry->addr )) continue;
+        if (timeout > 0)
+        {
+            now = GetTickCount64();
+            if (now >= deadline) { ret = ERROR_WINHTTP_TIMEOUT; break; }
+            remaining = deadline - now;
+        }
+        ret = netconn_create( host, &entry->addr, remaining, ret_conn );
+        TRACE( "candidate=%u family=%u elapsed=%I64u error=%lu cached=0\n",
+               candidate++, entry->addr.ss_family, GetTickCount64() - start, ret );
+        if (!ret) break;
+    }
+    netconn_free_addresses( addresses );
     return ret;
 }
 
