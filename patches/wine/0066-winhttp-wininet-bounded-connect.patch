+static BOOL same_address( const struct sockaddr_storage *a, const struct sockaddr_storage *b )
+{
+    if (a->ss_family != b->ss_family) return FALSE;
+    if (a->ss_family == AF_INET)
+    {
+        const struct sockaddr_in *x = (const struct sockaddr_in *)a, *y = (const struct sockaddr_in *)b;
+        return x->sin_port == y->sin_port && x->sin_addr.s_addr == y->sin_addr.s_addr;
+    }
+    if (a->ss_family == AF_INET6)
+    {
+        const struct sockaddr_in6 *x = (const struct sockaddr_in6 *)a, *y = (const struct sockaddr_in6 *)b;
+        return x->sin6_port == y->sin6_port && x->sin6_scope_id == y->sin6_scope_id &&
+               !memcmp( &x->sin6_addr, &y->sin6_addr, sizeof(x->sin6_addr) );
+    }
+    return FALSE;
+}
+
+static DWORD collect_addresses( const ADDRINFOW *res, INTERNET_PORT port, struct netconn_address **addresses )
+{
+    const ADDRINFOW *ai;
+    struct netconn_address *head = NULL, **tail = &head, *entry;
+    struct sockaddr_storage addr;
+    unsigned int pass, len;
+    int family;
+
+    /* Stable IPv4-first partition. Resolver order within a family is retained. */
+    for (pass = 0; pass < 2; pass++)
+    {
+        family = pass ? AF_INET6 : AF_INET;
+        len = pass ? sizeof(struct sockaddr_in6) : sizeof(struct sockaddr_in);
+        for (ai = res; ai; ai = ai->ai_next)
+        {
+            if (ai->ai_family != family || !ai->ai_addr || ai->ai_addrlen < len) continue;
+            memset( &addr, 0, sizeof(addr) );
+            memcpy( &addr, ai->ai_addr, len );
+            if (family == AF_INET) ((struct sockaddr_in *)&addr)->sin_port = htons( port );
+            else ((struct sockaddr_in6 *)&addr)->sin6_port = htons( port );
+            for (entry = head; entry; entry = entry->next)
+                if (same_address( &entry->addr, &addr )) break;
+            if (entry) continue;
+            if (!(entry = malloc( sizeof(*entry) )))
+            {
+                netconn_free_addresses( head );
+                return ERROR_OUTOFMEMORY;
+            }
+            entry->addr = addr;
+            entry->next = NULL;
+            *tail = entry;
+            tail = &entry->next;
+        }
+    }
+    *addresses = head;
+    return head ? ERROR_SUCCESS : ERROR_WINHTTP_NAME_NOT_RESOLVED;
+}
