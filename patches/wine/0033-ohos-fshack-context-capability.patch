+#ifdef __OHOS__
+static BOOL fs_hack_context_supported( struct context *ctx )
+{
+    /* The gamma shader uses GLSL 330 / UBOs / samplers. FBO allocation and
+     * swapping additionally require ARB DSA (EXT DSA is not equivalent).
+     * Function pointer presence alone does not establish either capability. */
+    if (ctx->major_version < 3 || (ctx->major_version == 3 && ctx->minor_version < 3)) return FALSE;
+    return ctx->major_version > 4 || (ctx->major_version == 4 && ctx->minor_version >= 5) ||
+           is_extension_supported( ctx, "GL_ARB_direct_state_access" );
+}
+
+static void fs_hack_init_context( struct context *ctx, const struct opengl_funcs *funcs )
+{
+    if (ctx->base.fshack_caps_checked) return;
+    ctx->base.fshack_caps_checked = TRUE;
+    if ((ctx->base.fshack_capable = fs_hack_context_supported( ctx )))
+    {
+        if (!ctx->base.gamma_program) fs_hack_setup_gamma_shader( &ctx->base, funcs );
+        /* Compilation/link failure must not route frames through program 0. */
+        ctx->base.fshack_capable = !!(ctx->base.gamma_program && ctx->base.gamma_ramp);
+    }
+    fprintf( stderr, "winehua_fshack_caps: context=%p gl=%d.%d enabled=%u gamma=%u/%u\n",
+             ctx, ctx->major_version, ctx->minor_version, ctx->base.fshack_capable,
+             ctx->base.gamma_program, ctx->base.gamma_ramp );
+}
+#endif
