+static BOOL is_valid_thread_exit_stack( ULONG_PTR stack, ULONG_PTR base, SIZE_T size )
+{
+    return base && !(stack & 15) && stack >= base &&
+           stack - base >= min_kernel_stack && stack - base <= size;
+}
