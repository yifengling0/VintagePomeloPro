+extern void DECLSPEC_NORETURN call_exit_on_kernel_stack( int status, void *stack, void (*exit_func)(int) );
+__ASM_GLOBAL_FUNC( call_exit_on_kernel_stack,
+                   "sub x29, x1, #0xc0\n\t"
+                   "mov sp, x29\n\t"
+                   __ASM_CFI(".cfi_def_cfa 29,0xc0\n\t")
+                   __ASM_CFI(".cfi_offset 29,-0xc0\n\t")
+                   __ASM_CFI(".cfi_offset 30,-0xb8\n\t")
