+#if defined(__OHOS__) && defined(__aarch64__)
+static DECLSPEC_NORETURN void pthread_exit_on_unix_stack( int status )
+{
+    stack_t ss = {0};
+
+    /* Wine owns the TEB signal stack. OHOS pthread_exit also cleans up the
+     * active alternate stack, and uses an unwritten old stack after EPERM
+     * if called on it. Disable it from the Unix stack before libc cleanup. */
+    ss.ss_flags = SS_DISABLE;
+    if (sigaltstack( &ss, NULL ) == -1)
+    {
+        ERR( "failed to disable signal stack at thread exit: %s\n", strerror(errno) );
+        abort_process( 1 );
+    }
+    pthread_exit( UIntToPtr(status) );
+}
+#endif
+
