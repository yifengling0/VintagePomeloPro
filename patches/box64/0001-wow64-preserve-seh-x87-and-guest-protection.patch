+    guest->Esi = R_ESI; guest->Edi = R_EDI;
+    guest->Ebp = R_EBP; guest->Esp = R_ESP;
+    guest->Eip = R_RIP; guest->EFlags = emu->eflags.x64;
+    box_to_fpu(guest, emu);
+    rec->ExceptionAddress = (void*)guest_pc;
+    dynablock_leave_runtime(db);
+    /* Unwind on the host stack captured before entering generated code. */
     memcpy(ctx, NtCurrentTeb()->TlsSlots[WOW64_TLS_ENTRY_CONTEXT], sizeof(*ctx));
     return STATUS_SUCCESS;
 }
