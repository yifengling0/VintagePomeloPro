@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef VKR_OHOS_NATIVE_MEMORY_H
+#define VKR_OHOS_NATIVE_MEMORY_H
+#include <vulkan/vulkan.h>
+#include <stdint.h>
+#include <stdbool.h>
+
+/* Preserve dedicated sizes for older 1.3 drivers. Vulkan 1.3.204 VUIDs
+ * image-02964 / buffer-02965 require exact equality; newer specifications
+ * permit larger allocations. Do not silently alter the guest's dedicated
+ * request. Ordinary heaps may be enlarged for a page mapping; the exported
+ * fd is separately checked against the guest blob size. */
+static inline VkResult
+vkr_ohos_native_allocation_size(VkMemoryAllocateInfo *info, uint64_t page_size)
+{
+   const VkMemoryDedicatedAllocateInfo *dedicated = NULL;
+   for (const VkBaseInStructure *p = info->pNext; p; p = p->pNext)
+      if (p->sType == VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO) {
+         dedicated = (const VkMemoryDedicatedAllocateInfo *)p;
+         break;
+      }
+   if (dedicated && (dedicated->image || dedicated->buffer)) return VK_SUCCESS;
+   if (!page_size || (page_size & (page_size - 1)) ||
+       info->allocationSize > UINT64_MAX - (page_size - 1))
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   info->allocationSize = (info->allocationSize + page_size - 1) & ~(page_size - 1);
+   return VK_SUCCESS;
+}
+
+
+/* One GPU-only alias precedes the original types, preserving Vulkan's
+ * subset ordering. It references an existing heap; no extra VRAM is claimed.
+ * HOST_VISIBLE buffers retain the original cache/coherency properties. */
+struct vkr_ohos_memory_types {
+   bool enabled;
+   uint32_t host_count;
+   uint32_t gpu_host_type;
+};
+
+static inline bool
+vkr_ohos_memory_types_init(VkPhysicalDeviceMemoryProperties *props,
+                          struct vkr_ohos_memory_types *types)
+{
+   *types = (struct vkr_ohos_memory_types){0};
+   if (!props->memoryTypeCount || props->memoryTypeCount >= VK_MAX_MEMORY_TYPES)
+      return false;
+   uint32_t gpu = props->memoryTypeCount;
+   for (uint32_t i = 0; i < props->memoryTypeCount; i++) {
+      const uint32_t flags = props->memoryTypes[i].propertyFlags;
+      if ((flags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) &&
+          !(flags & (VK_MEMORY_PROPERTY_PROTECTED_BIT | VK_MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT))) {
+         gpu = i;
+         break;
+      }
+   }
+   if (gpu == props->memoryTypeCount) return false;
+   const uint32_t heap = props->memoryTypes[gpu].heapIndex;
+   *types = (struct vkr_ohos_memory_types){true, props->memoryTypeCount, gpu};
+   for (uint32_t i = props->memoryTypeCount; i; i--)
+      props->memoryTypes[i] = props->memoryTypes[i - 1];
+   props->memoryTypes[0] = (VkMemoryType){VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, heap};
+   props->memoryTypeCount++;
+   return true;
+}
+
+static inline uint32_t
+vkr_ohos_memory_type_to_host(const struct vkr_ohos_memory_types *types, uint32_t guest)
+{
+   return !types->enabled ? guest : (guest ? guest - 1 : types->gpu_host_type);
+}
+
+static inline uint32_t
+vkr_ohos_memory_type_bits(const struct vkr_ohos_memory_types *types, uint32_t host_bits)
+{
+   if (!types->enabled) return host_bits;
+   return (host_bits << 1) | !!(host_bits & (1u << types->gpu_host_type));
+}
+
+static inline uint32_t
+vkr_ohos_gpu_image_memory_bits(const VkPhysicalDeviceMemoryProperties *props,
+   const struct vkr_ohos_memory_types *types, uint32_t host_bits)
+{
+   uint32_t bits = vkr_ohos_memory_type_bits(types, host_bits);
+   if (types->enabled)
+      for (uint32_t i = 0; i < props->memoryTypeCount; i++)
+         if (props->memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)
+            bits &= ~(1u << i);
+   return bits;
+}
+
