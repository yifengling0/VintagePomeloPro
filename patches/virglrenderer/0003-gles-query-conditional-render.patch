+/* NO_WAIT and BY_REGION_NO_WAIT are allowed to draw before a query is
+ * available. BY_REGION_WAIT may conservatively use the whole-query result.
+ * Never read GL_QUERY_RESULT on an unavailable NO_WAIT query. */
+static bool vrend_emulated_condition_skip(GLuint query_id, bool inverted,
+                                          uint32_t mode)
+{
+   GLuint available = 0, result = 0;
+   if (mode == PIPE_RENDER_COND_NO_WAIT || mode == PIPE_RENDER_COND_BY_REGION_NO_WAIT) {
+      glGetQueryObjectuiv(query_id, GL_QUERY_RESULT_AVAILABLE, &available);
+      if (!available)
+         return false;
+   }
+   glGetQueryObjectuiv(query_id, GL_QUERY_RESULT, &result);
+   return (result == 0) != inverted;
+}
