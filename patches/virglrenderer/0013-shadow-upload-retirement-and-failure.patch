Subject: [PATCH] venus: retire upload pools before guest waits and stop on upload failure

Retire only the private command, preserving every guest wait/signal and fence.
An internal upload failure cannot safely fall back after dirty bytes have been
consumed. Stop the affected context and report the first error instead of
submitting stale guest work or overwriting memory that is still in flight.

--- a/src/venus/vkr_queue.c
+++ b/src/venus/vkr_queue.c
@@ -819,6 +819,25 @@
 #ifdef __OHOS__
 #define VKR_WINEHUA_INLINE_MAX_GUEST_SUBMITS 64u
 
+/* Once shadow bytes have been retired in favor of an upload command, a CPU
+ * retry cannot reconstruct that generation. Never run guest work after a
+ * failed upload, or write mapped memory while its slot may still be in use.
+ * Internal waits can return VK_TIMEOUT, which is not a QueueSubmit result. */
+static VkResult
+vkr_ohos_abort_shadow_submission(struct vkr_context *ctx,
+                                  struct vkr_queue *queue,
+                                  VkResult result,
+                                  const char *phase)
+{
+   queue->shadow_upload_prepared = false;
+   vkr_log("OHOS shadow submission aborted phase=%s queueId=%" PRIu64
+           " result=%d", phase, queue->base.id, result);
+   vkr_context_set_fatal(ctx);
+   return result == VK_ERROR_OUT_OF_HOST_MEMORY ||
+          result == VK_ERROR_OUT_OF_DEVICE_MEMORY
+      ? result : VK_ERROR_DEVICE_LOST;
+}
+
 static VkResult
 vkr_ohos_queue_submit_inline_upload(struct vkr_queue *queue,
                                     struct vn_device_proc_table *vk,
