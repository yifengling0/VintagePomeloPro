--- /dev/null
+++ b/src/venus/vkr_ohos_native_resource.h
@@ -0,0 +1,123 @@
+/* SPDX-License-Identifier: MIT
+ * Internal resource contract for negotiated OHOS native-memory contexts.
+ * Platform-private handles are never advertised as guest OHOS extensions.
+ */
+#ifndef VKR_OHOS_NATIVE_RESOURCE_H
+#define VKR_OHOS_NATIVE_RESOURCE_H
+#include <vulkan/vulkan.h>
+#include <stdbool.h>
+#include "vkr_ohos_native_memory.h"
+
+static inline const void *
+vkr_ohos_resource_find(const void *chain, VkStructureType type)
+{
+   for (const VkBaseInStructure *p = chain; p; p = p->pNext)
+      if (p->sType == type) return p;
+   return NULL;
+}
+
+/* Ordinary optimal images are device-local resources, not NativeBuffer
+ * export surfaces. Linear/explicit external images keep their own contract. */
+static inline bool
+vkr_ohos_native_gpu_image(const VkImageCreateInfo *info)
+{
+   const VkExternalMemoryImageCreateInfo *external = vkr_ohos_resource_find(
+      info->pNext, VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO);
+   return info->tiling == VK_IMAGE_TILING_OPTIMAL && (!external || !external->handleTypes);
+}
+
+static inline bool
+vkr_ohos_resource_exportable(const VkExternalMemoryProperties *props, uint32_t handle)
+{
+   return (props->externalMemoryFeatures & VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT) &&
+          (props->compatibleHandleTypes & handle) == handle;
+}
+
+static inline VkResult
+vkr_ohos_native_buffer_info(VkPhysicalDevice physical,
+   PFN_vkGetPhysicalDeviceExternalBufferProperties query, uint32_t handle,
+   const VkBufferCreateInfo *guest, VkBufferCreateInfo *host,
+   VkExternalMemoryBufferCreateInfo *external)
+{
+   *host = *guest;
+   if (!handle) return VK_SUCCESS;
+   const VkExternalMemoryBufferCreateInfo *existing = vkr_ohos_resource_find(
+      guest->pNext, VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO);
+   /* Never replace or merge an application's different external contract. */
+   if (existing && existing->handleTypes != handle) return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   if (!query) return VK_ERROR_FEATURE_NOT_PRESENT;
+   VkPhysicalDeviceExternalBufferInfo info = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_BUFFER_INFO,
+      .flags = guest->flags, .usage = guest->usage, .handleType = handle,
+   };
+   VkExternalBufferProperties props = {.sType = VK_STRUCTURE_TYPE_EXTERNAL_BUFFER_PROPERTIES};
+   query(physical, &info, &props);
+   if (!vkr_ohos_resource_exportable(&props.externalMemoryProperties, handle))
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   if (existing) return VK_SUCCESS;
+   *external = (VkExternalMemoryBufferCreateInfo){
+      .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO,
+      .pNext = guest->pNext, .handleTypes = handle,
+   };
+   if (!existing) host->pNext = external;
+   return VK_SUCCESS;
+}
+
+static inline VkResult
+vkr_ohos_native_image_info(VkPhysicalDevice physical,
+   PFN_vkGetPhysicalDeviceImageFormatProperties2 query, uint32_t handle,
+   const VkImageCreateInfo *guest, VkImageCreateInfo *host,
+   VkExternalMemoryImageCreateInfo *external)
+{
+   *host = *guest;
+   if (!handle) return VK_SUCCESS;
+   const VkExternalMemoryImageCreateInfo *existing = vkr_ohos_resource_find(
+      guest->pNext, VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO);
+   if (existing && existing->handleTypes != handle) return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   if (!query) return VK_ERROR_FEATURE_NOT_PRESENT;
+   VkPhysicalDeviceExternalImageFormatInfo external_query = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_IMAGE_FORMAT_INFO,
+      .handleType = handle,
+   };
+   /* Copy the create structures that participate in format queries. Never
+    * pass unrelated create-only structures to the physical-device query. */
+   VkImageFormatListCreateInfo formats;
+   VkImageStencilUsageCreateInfo stencil;
+   const VkImageFormatListCreateInfo *guest_formats = vkr_ohos_resource_find(
+      guest->pNext, VK_STRUCTURE_TYPE_IMAGE_FORMAT_LIST_CREATE_INFO);
+   const VkImageStencilUsageCreateInfo *guest_stencil = vkr_ohos_resource_find(
+      guest->pNext, VK_STRUCTURE_TYPE_IMAGE_STENCIL_USAGE_CREATE_INFO);
+   if (guest_formats) {
+      formats = *guest_formats; formats.pNext = external_query.pNext;
+      external_query.pNext = &formats;
+   }
+   if (guest_stencil) {
+      stencil = *guest_stencil; stencil.pNext = external_query.pNext;
+      external_query.pNext = &stencil;
+   }
+   const VkPhysicalDeviceImageFormatInfo2 info = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2,
+      .pNext = &external_query, .format = guest->format, .type = guest->imageType,
+      .tiling = guest->tiling, .usage = guest->usage, .flags = guest->flags,
+   };
+   VkExternalImageFormatProperties external_props = {
+      .sType = VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES,
+   };
+   VkImageFormatProperties2 props = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2, .pNext = &external_props,
+   };
+   VkResult result = query(physical, &info, &props);
+   if (result != VK_SUCCESS) return result;
+   if (!vkr_ohos_resource_exportable(&external_props.externalMemoryProperties, handle))
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+   if (existing) return VK_SUCCESS;
+   *external = (VkExternalMemoryImageCreateInfo){
+      .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO,
+      .pNext = guest->pNext, .handleTypes = handle,
+   };
+   if (!existing) host->pNext = external;
+   /* Query requirements on this exact external resource: preserve the real
+    * size, alignment, memoryTypeBits and dedicated-allocation requirements. */
+   return VK_SUCCESS;
+}
+#endif
